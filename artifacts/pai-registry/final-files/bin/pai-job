        "levels": ["level-0", "level-1", "level-2"],
        "episodes_per_level": 10,
        "total_episodes": 30,
        "max_episode_steps": 1000,
        "save_video": True,
        "resume": "per_episode_done_markers",
        "eval_dataset_archive_sha256": (
            "113027a813854f75b2ffcb50e5669a58a7974e8651434f2d3ab59693eae91b50"
        ),
        "hssd_scene_archive_sha256": (
            "4e9ffee487fe40f4316bae15fe5ac76de98a3d8edeb770782247eeb09c0a3069"
        ),
        "validation_status": "passed",
        "validation_method": "static",
        "pai_probe_created": False,
        "expected_first_work_glob": str(
            eval_root / "*" / "progress" / "level-0_episode_0.done"
        ),
        "expected_complete_glob": str(eval_root / "*" / "EVAL_COMPLETE"),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "evidence_boundary": (
            "SIMPLE closed-loop simulation evaluation; not a real-robot result"
        ),
    }
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(
                f"TrashCan evaluation evidence.{field} must equal {expected}"
            )

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("TrashCan evaluation fault-tolerance contract is missing")
    exact_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "application_auto_resume": True,
        "pai_automatic_fault_tolerance": False,
    }
    for field, expected in exact_fault.items():
        if fault.get(field) != expected:
