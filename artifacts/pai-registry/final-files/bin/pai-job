        ),
        "encoder_sha256": (
            "25466aef85727d16546c6cf8c99f12fcfad9cbca8225d45f23685e2e025b786b"
        ),
        "normalization": "minmax32_meanstd4_v1",
        "state_dim": 32,
        "action_dim": 36,
