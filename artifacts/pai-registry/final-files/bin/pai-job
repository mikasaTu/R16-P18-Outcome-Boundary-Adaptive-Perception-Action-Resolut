def validate_dinowm_wall_single_official_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("DINO-WM Wall-single evaluation evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("DINO-WM Wall-single submission/fault contract is missing")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        expected_runtime_fields.add("payload_transport")
    if set(runtime) != expected_runtime_fields:
        raise Refused("DINO-WM Wall-single runtime fields drifted")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused(
            "DINO-WM Wall-single evaluation requires the verified 2-GPU alias"
        )
    if resolved.get("network") != {}:
        raise Refused("DINO-WM Wall-single network must be empty and source-derived")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
