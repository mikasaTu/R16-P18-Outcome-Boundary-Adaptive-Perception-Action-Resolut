    }
    observed_tools: Dict[str, Tuple[Path, str]] = {}
    for role, (toolchain_key, evidence_field) in tool_specs.items():
        info = toolchain_config.get(toolchain_key)
        if not isinstance(info, dict) or set(info) != {"file", "sha256"}:
            raise Refused(f"DINO-WM toolchain entry {toolchain_key} drifted")
        relative = Path(str(info.get("file", "")))
        if relative.is_absolute() or ".." in relative.parts:
            raise Refused(f"DINO-WM toolchain path {toolchain_key} is unsafe")
        path = ROOT / relative
        try:
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(f"DINO-WM pinned tool is missing: {path}: {exc}") from exc
        if canonical != path or path.is_symlink() or not path.is_file():
            raise Refused(f"DINO-WM pinned tool is not canonical: {path}")
        observed_hash = sha256(path)
        if observed_hash != info.get("sha256"):
            raise Refused(f"DINO-WM pinned tool hash drifted: {role}")
        if evidence.get(evidence_field) != observed_hash:
            raise Refused(f"DINO-WM evidence does not bind the {role} hash")
        observed_tools[role] = (path, observed_hash)

    launcher_path, launcher_sha = observed_tools["launcher"]
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("DINO-WM command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("DINO-WM frozen payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("DINO-WM decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM launcher payload must be UTF-8") from exc
    for role, variable in (
        ("cuda_entry_wrapper", "EXPECTED_ENTRY_SHA256"),
        ("artifact_validator", "EXPECTED_VALIDATOR_SHA256"),
    ):
        expected_line = f"{variable}={observed_tools[role][1]}"
        if payload_text.count(expected_line) != 1:
            raise Refused(f"DINO-WM launcher does not bind exact {role} hash")

    if payload_text.count("--config-name plan_wall.yaml") != 1:
        raise Refused("DINO-WM Wall-single launcher must select plan_wall.yaml once")
    if "planner.max_iter" in payload_text:
        raise Refused("DINO-WM Wall-single launcher must not override planner.max_iter")
    if "planner.sub_planner" in payload_text:
        raise Refused("DINO-WM Wall-single launcher must not override CEM defaults")

    expected_task = "dinowm-wall-single-official-dual-seed-eval-20260806"
    expected_model = "dinowm-wall-single-official-latest-8441971"
    expected_evidence = {
        "kind": DINO_WM_WALL_SINGLE_OFFICIAL_EVAL_EVIDENCE_KIND,
