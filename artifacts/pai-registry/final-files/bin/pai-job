    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != DINO_WM_WALL_SINGLE_OUTPUT_ROOT:
        raise Refused(
            "DINO-WM Wall-single output_root drifted from the fixed production root"
