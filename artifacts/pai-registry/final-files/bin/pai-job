def validate_vlajepa_legacy_pick_between_tables_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict) or evidence.get("kind") != (
        VLAJEPA_LEGACY_PICK_BETWEEN_TABLES_EVAL_EVIDENCE_KIND
