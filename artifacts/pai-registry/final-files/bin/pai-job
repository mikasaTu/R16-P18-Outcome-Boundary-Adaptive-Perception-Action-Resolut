class Refused(RuntimeError):
    pass


def utc_now() -> str:
    return (
        datetime.now(timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def parse_utc_datetime(value: Any, field: str) -> datetime:
    text = str(value or "")
    if not text.endswith("Z"):
        raise Refused(f"{field} must be an ISO-8601 UTC timestamp ending in Z")
    try:
        parsed = datetime.fromisoformat(text[:-1] + "+00:00")
    except ValueError as exc:
        raise Refused(f"{field} is not a valid ISO-8601 timestamp") from exc
    if parsed.utcoffset() != timezone.utc.utcoffset(parsed):
        raise Refused(f"{field} is not UTC")
    return parsed


def require_utc_timestamp(value: Any, field: str) -> str:
    text = str(value or "")
    parse_utc_datetime(text, field)
    return text


def load_json(path: Path) -> Dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise Refused(f"cannot read JSON object {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise Refused(f"expected JSON object: {path}")
    return value


def fsync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_bytes(path: Path, body: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        fd = -1
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_text(path: Path, value: Any, mode: int = 0o600) -> None:
    text = "" if value is None else str(value)
    atomic_bytes(path, text.encode("utf-8"), mode=mode)


def atomic_json(path: Path, value: Any, mode: int = 0o600) -> None:
    body = (
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8")
        + b"\n"
    )
    atomic_bytes(path, body, mode=mode)


def atomic_create_bytes(path: Path, body: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    linked = False
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        fd = -1
        try:
            os.link(temporary, path, follow_symlinks=False)
        except FileExistsError as exc:
            raise Refused(f"immutable file already exists: {path}") from exc
        linked = True
        fsync_directory(path.parent)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(temporary):
            os.unlink(temporary)
        if linked:
            fsync_directory(path.parent)


def atomic_create_json(path: Path, value: Any, mode: int = 0o600) -> None:
    body = (
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8")
        + b"\n"
    )
    atomic_create_bytes(path, body, mode=mode)


def sha256_bytes(body: bytes) -> str:
    return hashlib.sha256(body).hexdigest()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError as exc:
        raise Refused(f"cannot hash {path}: {exc}") from exc
    return digest.hexdigest()


def read_regular_path(
    path: Path,
    expected_uid: int = 2254,
    expected_gid: int = 2254,
    *,
    max_size_bytes: Optional[int] = None,
) -> Tuple[bytes, os.stat_result]:
    if path.is_symlink() or not path.is_file():
        raise Refused(f"expected a regular non-symlink file: {path}")
    before = path.stat()
    if before.st_uid != expected_uid or before.st_gid != expected_gid:
        raise Refused(f"unexpected file owner for {path}")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        if opened.st_dev != before.st_dev or opened.st_ino != before.st_ino:
            raise Refused(f"file changed while opening: {path}")
        if max_size_bytes is not None and opened.st_size > max_size_bytes:
            raise Refused(f"file exceeds size limit for {path}")
        chunks: List[bytes] = []
        size_bytes = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            size_bytes += len(chunk)
            if max_size_bytes is not None and size_bytes > max_size_bytes:
                raise Refused(f"file exceeds size limit while reading: {path}")
            chunks.append(chunk)
        after = os.fstat(descriptor)
        try:
            rebound = path.lstat()
        except OSError as exc:
            raise Refused(f"file path changed while reading: {path}: {exc}") from exc
        if (
            after.st_dev != opened.st_dev
            or after.st_ino != opened.st_ino
            or after.st_size != opened.st_size
            or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns
            or size_bytes != opened.st_size
            or rebound.st_dev != opened.st_dev
            or rebound.st_ino != opened.st_ino
            or rebound.st_size != opened.st_size
            or rebound.st_mtime_ns != opened.st_mtime_ns
            or rebound.st_ctime_ns != opened.st_ctime_ns
        ):
            raise Refused(f"file changed while reading: {path}")
    finally:
        os.close(descriptor)
    return b"".join(chunks), opened


def ensure_run_id(run_id: str) -> None:
    if not RUN_ID_RE.fullmatch(run_id):
        raise Refused(
            "run id must be 3-64 characters and contain only letters, digits, "
            "'.', '_' or '-'"
        )


def run_dir(run_id: str) -> Path:
    ensure_run_id(run_id)
    return RUNS_ROOT / run_id


def require_private_directory(path: Path) -> None:
    if path.is_symlink() or not path.is_dir():
        raise Refused(f"expected a private regular directory: {path}")
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"cannot resolve private directory {path}: {exc}") from exc
    if resolved != path:
        raise Refused(f"private directory is not canonical: {path} -> {resolved}")
    before = path.stat()
    if (
        before.st_uid != 2254
        or before.st_gid != 2254
        or stat.S_IMODE(before.st_mode) != 0o700
    ):
        raise Refused(f"private directory must be 2254:2254 mode 0700: {path}")
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        if opened.st_dev != before.st_dev or opened.st_ino != before.st_ino:
            raise Refused(f"private directory changed while opening: {path}")
    finally:
        os.close(descriptor)


def ensure_runs_root() -> None:
    require_private_directory(ROOT)
    if not RUNS_ROOT.exists() and not RUNS_ROOT.is_symlink():
        os.mkdir(RUNS_ROOT, 0o700)
    require_private_directory(RUNS_ROOT)


def private_run_dir(run_id: str, create: bool = False) -> Path:
    ensure_runs_root()
    path = run_dir(run_id)
    if create and not path.exists() and not path.is_symlink():
        os.mkdir(path, 0o700)
    require_private_directory(path)
    return path


def open_private_append(path: Path):
    descriptor = os.open(
        path,
        os.O_RDWR | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW,
        0o600,
    )
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != 2254
            or opened.st_gid != 2254
            or stat.S_IMODE(opened.st_mode) != 0o600
        ):
            raise Refused(f"private append file must be 2254:2254 mode 0600: {path}")
        return os.fdopen(descriptor, "a+", encoding="utf-8")
    except BaseException:
        os.close(descriptor)
        raise


def require_leon_controller() -> None:
    if os.getuid() != 2254 or os.getgid() != 2254:
        raise Refused(
            f"registry mutations must run as numeric Leon 2254:2254, "
            f"not {os.getuid()}:{os.getgid()}"
        )


def all_strings(value: Any) -> Iterable[str]:
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for key, item in value.items():
            yield str(key)
            yield from all_strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from all_strings(item)


def assert_no_legacy_or_placeholder(value: Any) -> None:
    for text in all_strings(value):
        if (
            "__REPLACE_" in text
            or "__REQUIRES_" in text
            or "REPLACE_ME" in text
        ):
            raise Refused(f"unresolved placeholder: {text}")
        if "/mnt/data" in text:
            raise Refused(f"legacy /mnt/data path is forbidden: {text}")
        if "/mnt/cpfs/zbl-cpfs/" in text:
            raise Refused(f"legacy CPFS path is forbidden: {text}")
        if "cpfs-290ugos70n28kovt393" in text:
            raise Refused(f"old CPFS identity is forbidden: {text}")


def resource_map() -> Dict[str, Dict[str, Any]]:
    resources = load_json(RESOURCES_PATH).get("resources")
    if not isinstance(resources, dict):
        raise Refused("config/resources.json has no resources map")
    return resources


def toolchain() -> Tuple[Dict[str, Any], Path]:
    wandb_toolchain()
    config = load_json(TOOLCHAIN_PATH)
    dlc_info = config.get("dlc")
    if not isinstance(dlc_info, dict):
        raise Refused("toolchain has no pinned DLC definition")
    dlc_path = ROOT / str(dlc_info.get("file", ""))
    if not dlc_path.is_file() or dlc_path.is_symlink():
        raise Refused(f"pinned DLC binary missing or symlinked: {dlc_path}")
    actual_dlc_sha = sha256(dlc_path)
    if actual_dlc_sha != dlc_info.get("sha256"):
        raise Refused(
            f"pinned DLC SHA256 mismatch: expected {dlc_info.get('sha256')}, "
            f"got {actual_dlc_sha}"
        )
    if not os.access(dlc_path, os.X_OK):
        raise Refused(f"pinned DLC binary is not executable: {dlc_path}")

    openapi_info = config.get("openapi_idle_source")
    if not isinstance(openapi_info, dict):
        raise Refused("toolchain has no pinned OpenAPI idle-source helper")
    openapi_path = ROOT / str(openapi_info.get("file", ""))
    if not openapi_path.is_file() or openapi_path.is_symlink():
        raise Refused(
            f"pinned OpenAPI idle-source helper missing or symlinked: {openapi_path}"
        )
    if sha256(openapi_path) != openapi_info.get("sha256"):
        raise Refused("pinned OpenAPI idle-source helper SHA256 mismatch")
    if not os.access(openapi_path, os.X_OK):
        raise Refused(
            f"pinned OpenAPI idle-source helper is not executable: {openapi_path}"
        )
    expected_openapi = {
        "api_path": OPENAPI_LISTJOBS_PATH,
        "action": OPENAPI_LISTJOBS_ACTION,
        "version": OPENAPI_LISTJOBS_VERSION,
        "source": EXTERNAL_IDLE_SOURCE_SPECS["openapi"]["label"],
    }
    for key, value in expected_openapi.items():
        if openapi_info.get(key) != value:
            raise Refused(f"pinned OpenAPI idle-source {key} mismatch")

    launcher_info = config.get("canary_launcher")
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned canary launcher definition")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    if not launcher_path.is_file() or launcher_path.is_symlink():
        raise Refused(f"pinned canary launcher missing or symlinked: {launcher_path}")
    if sha256(launcher_path) != launcher_info.get("sha256"):
        raise Refused("pinned canary launcher SHA256 mismatch")

    formal_tools = {
        "wrc_task_success_q_launcher": "WRC task-success-Q launcher",
        "wrc_task_success_q_first_step_validator": (
            "WRC task-success-Q first-step validator"
        ),
        "wrc_task_success_q_wave_step_validator": (
            "WRC task-success-Q four-card wave-step validator"
        ),
        "wrc_task_success_q_method_materializer": (
            "WRC task-success-Q method-suite materializer"
        ),
    }
    for key, label in formal_tools.items():
        info = config.get(key)
        if not isinstance(info, dict):
            raise Refused(f"toolchain has no pinned {label} definition")
        path = ROOT / str(info.get("file", ""))
        if not path.is_file() or path.is_symlink():
            raise Refused(f"pinned {label} missing or symlinked: {path}")
        if sha256(path) != info.get("sha256"):
            raise Refused(f"pinned {label} SHA256 mismatch")
        if not os.access(path, os.X_OK):
            raise Refused(f"pinned {label} is not executable: {path}")

    sentinel = config.get("mount_sentinel")
    if not isinstance(sentinel, dict):
        raise Refused("toolchain has no mount-sentinel definition")
    source_file = ROOT / str(sentinel.get("source_file", ""))
    sentinel_path = Path(str(sentinel.get("path", "")))
    expected_sha = str(sentinel.get("sha256", ""))
    if sha256(source_file) != expected_sha:
        raise Refused("registry mount-sentinel source hash mismatch")
    if (
        not sentinel_path.is_file()
        or sentinel_path.is_symlink()
        or sha256(sentinel_path) != expected_sha
    ):
        raise Refused(
            f"dev14 new-CPFS sentinel missing or mismatched: {sentinel_path}"
        )
    sentinel_stat = sentinel_path.stat()
    if sentinel_stat.st_uid != 2254 or sentinel_stat.st_gid != 2254:
        raise Refused(f"mount sentinel is not owned by 2254:2254: {sentinel_path}")
    return config, dlc_path


def wandb_toolchain() -> Dict[str, Any]:
    config = load_json(WANDB_TOOLCHAIN_PATH)
    if config.get("schema_version") != 1:
        raise Refused("W&B toolchain schema version drifted")
    setup_info = config.get("setup_helper")
    if not isinstance(setup_info, dict):
        raise Refused("W&B toolchain has no setup helper definition")
    setup_path = ROOT / str(setup_info.get("file", ""))
    if not setup_path.is_file() or setup_path.is_symlink():
        raise Refused(f"pinned W&B setup helper missing or symlinked: {setup_path}")
    if sha256(setup_path) != setup_info.get("sha256"):
        raise Refused("pinned W&B setup helper SHA256 mismatch")
    if not os.access(setup_path, os.X_OK):
        raise Refused(f"pinned W&B setup helper is not executable: {setup_path}")
    info = config.get("private_config")
    if not isinstance(info, dict):
        raise Refused("W&B toolchain has no private-config contract")
    if Path(str(info.get("path", ""))) != WANDB_CONFIG_PATH:
        raise Refused("W&B private-config path drifted")
    if info.get("owner_uid") != 2254 or info.get("owner_gid") != 2254:
        raise Refused("W&B private-config owner contract drifted")
    if info.get("mode") != "0600":
        raise Refused("W&B private-config mode contract drifted")
    access = config.get("entity_access")
    if not isinstance(access, dict):
        raise Refused("W&B toolchain has no entity-access contract")
    if access.get("required_entity") != EXPECTED_WANDB_ENTITY:
        raise Refused("W&B required entity drifted from explicit user intent")
    if access.get("graphql_url") != WANDB_GRAPHQL_URL:
        raise Refused("W&B GraphQL endpoint drifted")
    if set(access.get("forbidden_viewers", [])) != FORBIDDEN_WANDB_VIEWERS:
        raise Refused("W&B forbidden-viewer contract drifted")
    if set(access.get("writable_roles", [])) != WANDB_WRITABLE_ROLES:
        raise Refused("W&B writable-role contract drifted")
    if access.get("verify_on_setup") is not True:
        raise Refused("W&B setup verification must remain enabled")
    if access.get("verify_before_create_job") is not True:
        raise Refused("W&B pre-CreateJob verification must remain enabled")
    if access.get("allow_identity_inference") is not False:
        raise Refused("W&B identity inference must remain disabled")
    credential_source = config.get("credential_source")
    if not isinstance(credential_source, dict):
        raise Refused("W&B toolchain has no credential-source contract")
    if Path(str(credential_source.get("active_config_path", ""))) != WANDB_CONFIG_PATH:
        raise Refused("W&B active credential path drifted")
    if credential_source.get("allow_transient_environment") is not False:
        raise Refused("transient W&B environment credentials must remain disabled")
    if credential_source.get("allow_history_session_cache_recovery") is not False:
        raise Refused("historical W&B credential recovery must remain disabled")
    return config


def checked_config(path_text: Optional[str]) -> Path:
    tc, _ = toolchain()
    path = Path(path_text or str(tc.get("default_config", "")))
    if path.is_symlink() or not path.is_file():
        raise Refused(
            f"DLC credential config is missing or symlinked: {path}. "
            "Run /workspace/leon/.local/bin/pai-credential-setup in a private TTY."
        )
    config_stat = path.stat()
    mode = stat.S_IMODE(config_stat.st_mode)
    if (
        config_stat.st_uid != 2254
        or config_stat.st_gid != 2254
        or mode != 0o600
    ):
        raise Refused(
            f"DLC credential config must be 2254:2254 mode 0600: "
            f"{path} is {config_stat.st_uid}:{config_stat.st_gid} mode {mode:04o}"
        )
    return path


def canonical_code_file(path_text: str) -> Path:
    path = Path(path_text)
    if not path.is_absolute():
        raise Refused(f"command_file must be absolute: {path}")
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"command_file does not exist: {path}: {exc}") from exc
    if resolved != path or not resolved.is_file() or resolved.is_symlink():
        raise Refused(f"command_file must be a canonical regular file: {path}")
    if not resolved.is_relative_to(CODE_ROOT):
        raise Refused(f"command_file is outside Leon's code root: {path}")
    return resolved


def canonical_write_path(path_text: str) -> Path:
    path = Path(path_text)
    if not path.is_absolute():
        raise Refused(f"write path must be absolute: {path}")
    if ".." in path.parts:
        raise Refused(f"write path contains parent traversal: {path}")
    resolved = path.resolve(strict=False)
    if resolved != path:
        raise Refused(f"write path is symlinked or non-canonical: {path} -> {resolved}")
    if not any(path.is_relative_to(base) and path != base for base in ALLOWED_WRITE_BASES):
        raise Refused(f"write path is outside exact Leon writable roots: {path}")
    return path


def normalized_mount_path(value: Any) -> str:
    path = str(value or "")
    if not path.startswith("/"):
        raise Refused(f"data-source mount path must be absolute: {path}")
    if "\n" in path or "\r" in path or "," in path or ":" in path:
        raise Refused(f"unsupported data-source mount path: {path!r}")
    path_without_trailing_slash = "/" if path == "/" else path.rstrip("/")
    if (
        ".." in Path(path_without_trailing_slash).parts
        or str(Path(path_without_trailing_slash)) != path_without_trailing_slash
    ):
        raise Refused(f"data-source mount path is not canonical: {path}")
    return path


def normalize_data_source(item: Any) -> Dict[str, str]:
    if not isinstance(item, dict):
        raise Refused(f"data source must be an object: {item}")
    source_id = str(item.get("id", ""))
    version = str(item.get("version", ""))
    mount_path = normalized_mount_path(item.get("mount_path"))
    raw_options = item.get("options", "")
    if not isinstance(raw_options, str):
        raise Refused("data-source options must be a string; use \"\" for no options")
    options = raw_options
    if not DATA_SOURCE_ID_RE.fullmatch(source_id):
        raise Refused(f"invalid DataSourceId: {source_id}")
    if not re.fullmatch(r"v[0-9]+", version):
        raise Refused(f"invalid data-source version: {version}")
    if "," in options or "\n" in options or "\r" in options:
        raise Refused(f"unsupported data-source options: {options!r}")
    return {
        "id": source_id,
        "version": version,
        "mount_path": mount_path,
        "options": options,
    }


def data_source_key(item: Dict[str, str]) -> Tuple[str, str, str, str]:
    return (
        item["id"],
        item["version"],
        normalized_mount_path(item["mount_path"]),
        item["options"],
    )


def service_data_source_key(
    item: Dict[str, str]
) -> Tuple[str, str, str, str]:
    mount_path = item["mount_path"]
    canonical_mount_path = "/" if mount_path == "/" else mount_path.rstrip("/")
    return (
        item["id"],
        item["version"],
        canonical_mount_path,
        item["options"],
    )


def validate_data_sources(
    items: Any,
    toolchain_config: Dict[str, Any],
    resource: Optional[Dict[str, Any]] = None,
) -> List[Dict[str, str]]:
    if not isinstance(items, list) or not items:
        raise Refused("storage.data_sources must be a non-empty list")
    normalized = [normalize_data_source(item) for item in items]
    if isinstance(resource, dict) and "authorized_data_sources" in resource:
        expected_raw = resource["authorized_data_sources"]
    else:
        expected_raw = toolchain_config.get("authorized_data_sources")
    if not isinstance(expected_raw, list) or not expected_raw:
        raise Refused("resource/toolchain has no authorized_data_sources contract")
    expected = [normalize_data_source(item) for item in expected_raw]
    if sorted(data_source_key(item) for item in normalized) != sorted(
        data_source_key(item) for item in expected
    ):
        raise Refused(
            "data-source contract differs from the exact source-job readback; "
            "old or partial mounts are forbidden"
        )
    return normalized


def normalize_pod_env(value: Any) -> Dict[str, str]:
    if value in (None, {}):
        return {}
    if not isinstance(value, dict):
        raise Refused("runtime.pod_env must be an object")
    normalized: Dict[str, str] = {}
    for raw_key, raw_value in value.items():
        key = str(raw_key)
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise Refused(f"invalid runtime.pod_env key: {key!r}")
        if not isinstance(raw_value, str) or not raw_value:
            raise Refused(f"runtime.pod_env value must be a non-empty string: {key}")
        if any(char in raw_value for char in ("\n", "\r")):
            raise Refused(f"unsupported runtime.pod_env value for {key}")
        normalized[key] = raw_value
    return dict(sorted(normalized.items()))


def normalize_secret_env_names(value: Any) -> List[str]:
    if value in (None, []):
        return []
    if not isinstance(value, list):
        raise Refused("runtime.secret_env_names must be a list")
    normalized: List[str] = []
    for raw_name in value:
        if not isinstance(raw_name, str) or not re.fullmatch(
            r"[A-Za-z_][A-Za-z0-9_]*", raw_name
        ):
            raise Refused(f"invalid runtime.secret_env_names entry: {raw_name!r}")
        if raw_name in normalized:
            raise Refused(f"duplicate runtime.secret_env_names entry: {raw_name}")
        normalized.append(raw_name)
    return sorted(normalized)


def expected_wandb_entity_contract() -> Dict[str, Any]:
    wandb_toolchain()
    return {
        "entity": EXPECTED_WANDB_ENTITY,
        "source": "explicit_user_contract",
        "allow_identity_inference": False,
        "require_live_membership_write_gate": True,
        "forbidden_viewers": sorted(FORBIDDEN_WANDB_VIEWERS),
    }


def validate_wandb_entity_contract(
    value: Any,
    secret_env_names: List[str],
) -> Optional[Dict[str, Any]]:
    if not secret_env_names:
        if value not in (None, {}):
            raise Refused("W&B entity contract is present while W&B is disabled")
        return None
    expected = expected_wandb_entity_contract()
    if value != expected:
        raise Refused(
            "W&B entity contract must preserve the exact explicit user entity; "
            "viewer/default-team substitution is forbidden"
        )
    return expected


def apply_wandb_secret_contract(manifest: Dict[str, Any]) -> None:
    runtime = manifest.get("runtime")
    if not isinstance(runtime, dict):
        raise Refused("runtime object is required for W&B injection")
    declared = normalize_secret_env_names(runtime.get("secret_env_names"))
    if declared and declared != WANDB_SECRET_ENV_NAMES:
        raise Refused(
            "W&B injection cannot replace a different secret environment contract"
        )
    runtime["secret_env_names"] = list(WANDB_SECRET_ENV_NAMES)
    expected = expected_wandb_entity_contract()
    declared_entity_contract = runtime.get("wandb_entity_contract")
    if declared_entity_contract not in (None, expected):
        raise Refused(
            "W&B injection cannot replace a different task entity contract"
        )
    runtime["wandb_entity_contract"] = expected


def validate_secret_env_contract(
    secret_env_names: Any, pod_env: Dict[str, str]
) -> List[str]:
    names = normalize_secret_env_names(secret_env_names)
    if names not in ([], WANDB_SECRET_ENV_NAMES):
        raise Refused(
            "only the exact WANDB_API_KEY and WANDB_ENTITY secret pair is supported"
        )
    if set(names).intersection(pod_env):
        raise Refused("runtime secret and public environment names overlap")
    return names


def validate_wandb_values(
    values: Dict[str, str],
    expected_entity: str = EXPECTED_WANDB_ENTITY,
) -> Dict[str, str]:
    if sorted(values) != WANDB_SECRET_ENV_NAMES:
        raise Refused("W&B config must contain exactly WANDB_API_KEY and WANDB_ENTITY")
    api_key = values.get("WANDB_API_KEY", "")
    entity = values.get("WANDB_ENTITY", "")
    if not api_key or any(char in api_key for char in ("\n", "\r", "\x00")):
        raise Refused("configured WANDB_API_KEY is empty or invalid")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", entity):
        raise Refused("configured WANDB_ENTITY is empty or invalid")
    if entity != expected_entity:
        raise Refused(
            "configured WANDB_ENTITY does not match the exact explicit task "
            "entity; automatic entity substitution is forbidden"
        )
    return {
        "WANDB_API_KEY": api_key,
        "WANDB_ENTITY": entity,
    }


def wandb_graphql(
    api_key: str,
    query: str,
    variables: Dict[str, Any],
    endpoint: str = WANDB_GRAPHQL_URL,
    timeout_seconds: int = 15,
) -> Dict[str, Any]:
    authorization = base64.b64encode(f"api:{api_key}".encode("utf-8")).decode(
        "ascii"
    )
    body = json.dumps(
        {"query": query, "variables": variables},
        ensure_ascii=True,
        separators=(",", ":"),
    ).encode("utf-8")
    request = urllib.request.Request(
        endpoint,
        data=body,
        headers={
            "Authorization": f"Basic {authorization}",
            "Content-Type": "application/json",
            "User-Agent": "pai-job-registry-wandb-entity-gate/1",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            status_code = int(getattr(response, "status", response.getcode()))
            response_body = response.read(1024 * 1024 + 1)
    except urllib.error.HTTPError as exc:
        raise Refused(
            f"W&B GraphQL HTTP request failed with status {exc.code}"
        ) from exc
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise Refused("W&B GraphQL request failed") from exc
    if status_code != 200:
        raise Refused(f"W&B GraphQL returned HTTP status {status_code}")
    if len(response_body) > 1024 * 1024:
        raise Refused("W&B GraphQL response is unexpectedly large")
    try:
        payload = json.loads(response_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("W&B GraphQL response is not valid JSON") from exc
    if not isinstance(payload, dict):
        raise Refused("W&B GraphQL response is not an object")
    if payload.get("errors"):
        raise Refused("W&B GraphQL returned one or more errors")
    data = payload.get("data")
    if not isinstance(data, dict):
        raise Refused("W&B GraphQL response has no data object")
    return data


def verify_wandb_entity_access(values: Dict[str, str]) -> Dict[str, Any]:
    checked = validate_wandb_values(values)
    api_key = checked["WANDB_API_KEY"]
    entity_name = checked["WANDB_ENTITY"]

    viewer_data = wandb_graphql(api_key, WANDB_VIEWER_QUERY, {})
    viewer = viewer_data.get("viewer")
    if not isinstance(viewer, dict):
        raise Refused("W&B viewer identity is missing")
    viewer_id = str(viewer.get("id") or "")
    viewer_username = str(viewer.get("username") or "")
    if not viewer_id or not viewer_username:
        raise Refused("W&B viewer id or username is missing")
    if viewer_username in FORBIDDEN_WANDB_VIEWERS:
        raise Refused("W&B viewer identity is explicitly forbidden")

    entity_data = wandb_graphql(
        api_key,
        WANDB_ENTITY_MEMBER_QUERY,
        {"entityName": entity_name, "viewerId": viewer_id},
    )
    entity = entity_data.get("entity")
    if not isinstance(entity, dict):
        raise Refused("the exact requested W&B entity does not exist or is inaccessible")
    if entity.get("name") != entity_name:
        raise Refused("W&B returned a different entity than the explicit task entity")
    member = entity.get("member")
    if not isinstance(member, dict):
        raise Refused("W&B viewer is not a member of the exact requested entity")
    if member.get("username") != viewer_username:
        raise Refused("W&B entity membership does not match the authenticated viewer")
    if member.get("pending") is not False:
        raise Refused("W&B entity membership is pending or indeterminate")
    role = str(member.get("role") or "").lower()
    if role not in WANDB_WRITABLE_ROLES:
        raise Refused("W&B entity membership is not write-capable")
    return {
        "verified_at_utc": utc_now(),
        "endpoint": WANDB_GRAPHQL_URL,
        "entity": entity_name,
        "viewer_username": viewer_username,
        "membership_role": role,
        "pending": False,
        "identity_inference_used": False,
        "write_probe_created": False,
        "complete": True,
    }


def verify_and_record_wandb_precreate(
    target_dir: Path,
    secret_env: Dict[str, str],
) -> Optional[Dict[str, Any]]:
    if not secret_env:
        return None
    access = verify_wandb_entity_access(secret_env)
    atomic_json(
        target_dir / "wandb-entity-access.pre-create.json",
        access,
    )
    return access


def read_wandb_config(
    path: Path,
    expected_uid: int = 2254,
    expected_gid: int = 2254,
) -> Dict[str, str]:
    try:
        body, config_stat = read_regular_path(
            path,
            expected_uid=expected_uid,
            expected_gid=expected_gid,
        )
    except (OSError, Refused) as exc:
        raise Refused(
            f"W&B config is missing or unsafe: {path}. "
            "Run ./bin/pai-wandb-setup --replace in a private TTY."
        ) from exc
    if stat.S_IMODE(config_stat.st_mode) != 0o600:
        raise Refused(
            f"W&B config must be {expected_uid}:{expected_gid} mode 0600: {path}"
        )
    if len(body) > 16 * 1024:
        raise Refused("W&B config is unexpectedly large")
    try:
        raw = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("W&B config is not valid JSON") from exc
    if not isinstance(raw, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in raw.items()
    ):
        raise Refused("W&B config must be a string-to-string JSON object")
    return validate_wandb_values(raw)


def load_wandb_config_values() -> Dict[str, str]:
    tc = wandb_toolchain()
    info = tc["private_config"]
    path = Path(str(info.get("path", "")))
    if path != WANDB_CONFIG_PATH:
        raise Refused("toolchain W&B config path drifted")
    if info.get("owner_uid") != 2254 or info.get("owner_gid") != 2254:
        raise Refused("toolchain W&B config owner contract drifted")
    if info.get("mode") != "0600":
        raise Refused("toolchain W&B config mode contract drifted")
    return validate_wandb_values(read_wandb_config(path))


def declared_secret_env_values(resolved: Dict[str, Any]) -> Dict[str, str]:
    names = normalize_secret_env_names(
        resolved.get("runtime", {}).get("secret_env_names")
    )
    if not names:
        return {}
    validate_secret_env_contract(names, {})
    entity_contract = validate_wandb_entity_contract(
        resolved.get("runtime", {}).get("wandb_entity_contract"),
        names,
    )
    if entity_contract is None:
        raise Refused("W&B entity contract is missing")
    if WANDB_TRANSIENT_MARKER in os.environ or any(
        name in os.environ for name in WANDB_SECRET_ENV_NAMES
    ):
        raise Refused(
            "transient/session W&B credentials are forbidden; remove them and "
            "run ./bin/pai-wandb-setup --replace in a private TTY"
        )
    values = load_wandb_config_values()
    return validate_wandb_values(
        values,
        expected_entity=str(entity_contract["entity"]),
    )


def observed_pod_env_matches(observed: Any, resolved: Dict[str, Any]) -> bool:
    observed_env = normalize_pod_env(observed)
    expected_public = normalize_pod_env(
        resolved.get("runtime", {}).get("pod_env")
    )
    for name in normalize_secret_env_names(
        resolved.get("runtime", {}).get("secret_env_names")
    ):
        if not observed_env.pop(name, ""):
            return False
    return observed_env == expected_public


def redacted_observed_pod_env(
    observed: Any, resolved: Dict[str, Any]
) -> Dict[str, str]:
    observed_env = normalize_pod_env(observed)
    for name in normalize_secret_env_names(
        resolved.get("runtime", {}).get("secret_env_names")
    ):
        if name in observed_env:
            observed_env[name] = "<redacted>"
    return observed_env


def redact_sensitive_text(text: Any, secret_values: Iterable[str]) -> str:
    value = "" if text is None else str(text)
    for secret in sorted(
        {item for item in secret_values if item},
        key=len,
        reverse=True,
    ):
        value = value.replace(secret, "<redacted>")
    return value


def redact_secret_envs_in_object(value: Any, secret_names: Iterable[str]) -> Any:
    names = set(secret_names)
    if isinstance(value, list):
        return [redact_secret_envs_in_object(item, names) for item in value]
    if not isinstance(value, dict):
        return value
    redacted: Dict[str, Any] = {}
    for key, item in value.items():
        if key == "Envs" and isinstance(item, dict):
            redacted[key] = {
                env_name: (
                    "<redacted>"
                    if env_name in names
                    else redact_secret_envs_in_object(env_value, names)
                )
                for env_name, env_value in item.items()
            }
        elif key == "CustomEnvs" and isinstance(item, list):
            redacted[key] = [
                {
                    env_key: (
                        "<redacted>"
                        if env_key == "Value"
                        and isinstance(env_entry, dict)
                        and (
                            env_entry.get("Name")
                            or env_entry.get("Key")
                        )
                        in names
                        else redact_secret_envs_in_object(env_value, names)
                    )
                    for env_key, env_value in env_entry.items()
                }
                if isinstance(env_entry, dict)
                else redact_secret_envs_in_object(env_entry, names)
                for env_entry in item
            ]
        else:
            redacted[key] = redact_secret_envs_in_object(item, names)
    return redacted


def redact_submit_argv(
    argv: List[str], secret_values: Dict[str, str]
) -> List[str]:
    return [
        redact_sensitive_text(item, secret_values.values())
        for item in argv
    ]


def validate_resource_source_contract(
    resource: Dict[str, Any],
) -> Optional[Dict[str, Any]]:
    if not resource.get("source_job_id"):
        if "source_contract" in resource:
            raise Refused("resource without source_job_id cannot declare source_contract")
        return None
    contract = resource.get("source_contract")
    if not isinstance(contract, dict):
        raise Refused("resource with source_job_id requires a source_contract object")
    expected_keys = {"require_status", "aimaster_enabled", "aimaster_args"}
    if set(contract) != expected_keys:
        raise Refused(
            "resource source_contract must contain only require_status, "
            "aimaster_enabled and aimaster_args"
        )
    if contract.get("require_status") != "Succeeded":
        raise Refused("resource source_contract.require_status must equal Succeeded")
    if type(contract.get("aimaster_enabled")) is not bool:
        raise Refused("resource source_contract.aimaster_enabled must be boolean")
    aimaster_args = contract.get("aimaster_args")
    if not isinstance(aimaster_args, str):
        raise Refused("resource source_contract.aimaster_args must be a string")
    if contract["aimaster_enabled"] is not bool(aimaster_args):
        raise Refused(
            "resource source_contract AIMaster enabled state and args disagree"
        )
    return dict(contract)


def format_pod_env(value: Dict[str, str]) -> str:
    normalized = normalize_pod_env(value)
    output = io.StringIO()
    writer = csv.writer(output, lineterminator="")
    writer.writerow([f"{key}={item}" for key, item in normalized.items()])
    return output.getvalue()


def replace_tokens(value: Any, replacements: Dict[str, str]) -> Any:
    if isinstance(value, str):
        for old, new in replacements.items():
            value = value.replace(old, new)
        return value
    if isinstance(value, list):
        return [replace_tokens(item, replacements) for item in value]
    if isinstance(value, dict):
        return {key: replace_tokens(item, replacements) for key, item in value.items()}
    return value


def shell_array(values: List[str]) -> str:
    return "(" + " ".join(shlex.quote(value) for value in values) + ")"


def formal_wrc_workload_env(evidence: Dict[str, Any]) -> Dict[str, str]:
    if evidence.get("kind") != WRC_FORMAL_EVIDENCE_KIND:
        return {}
    calibrated = evidence.get("calibrated_success_probability")
    if type(calibrated) is not bool:
        raise Refused(
            "formal WRC evidence.calibrated_success_probability must be boolean"
        )
    logical_replicas = evidence.get("logical_replica_count")
    physical_gpus = evidence.get("physical_gpu_count")
    active_rank_start = evidence.get("active_rank_start")
    active_rank_count = evidence.get("active_rank_count")
    if logical_replicas != 8:
        raise Refused("formal WRC logical_replica_count must equal 8")
    if physical_gpus != 4 or active_rank_count != 4:
        raise Refused("formal WRC four-card wave must bind four active ranks")
    if active_rank_start not in {0, 4}:
        raise Refused("formal WRC active_rank_start must equal 0 or 4")
    fields = {
        "WRC_TASK_Q_METHOD_ID": evidence.get("method_id"),
        "WRC_TASK_Q_METHOD_CONTRACT": evidence.get("method_contract_path"),
        "WRC_TASK_Q_METHOD_CONTRACT_SHA256": evidence.get(
            "method_contract_sha256"
        ),
        "WRC_TASK_Q_SEMANTICS": evidence.get("q_semantics"),
        "WRC_TASK_Q_TAKEOVER_LABEL_ROLE": evidence.get(
            "takeover_label_role"
        ),
        "WRC_TASK_Q_CALIBRATED_SUCCESS_PROBABILITY": (
            "true" if calibrated else "false"
        ),
        "WRC_TASK_Q_CHECKPOINT_ROOT": evidence.get("checkpoint_root"),
        "WRC_TASK_Q_LOG_ROOT": evidence.get("log_root"),
        "WRC_TASK_Q_TRAINING_LINEAGE_ID": evidence.get(
            "training_lineage_run_id"
        ),
        "WRC_TASK_Q_LOGICAL_REPLICA_COUNT": str(logical_replicas),
        "WRC_TASK_Q_PHYSICAL_GPU_COUNT": str(physical_gpus),
        "WRC_TASK_Q_ACTIVE_RANK_START": str(active_rank_start),
        "WRC_TASK_Q_ACTIVE_RANK_COUNT": str(active_rank_count),
    }
    normalized: Dict[str, str] = {}
    for key, raw in fields.items():
        if not isinstance(raw, str) or not raw:
            raise Refused(f"formal WRC workload environment lacks {key}")
        if "\n" in raw or "\r" in raw or "\x00" in raw:
            raise Refused(f"formal WRC workload environment {key} is invalid")
        normalized[key] = raw
    return normalized


def payload_transport_for_manifest(
    *,
    runtime: Dict[str, Any],
    evidence: Dict[str, Any],
    controller_version: str,
    resolving_requested: bool = False,
) -> str:
    if controller_version not in SUPPORTED_CONTROLLER_VERSIONS:
        raise Refused(
            f"unsupported resolved controller version: {controller_version}"
        )
    declared = runtime.get("payload_transport")
    if controller_version == "4":
        if "payload_transport" in runtime:
            raise Refused(
                "controller v4 manifests must use the implicit legacy "
                "base64 payload transport"
            )
        return PAYLOAD_TRANSPORT_BASE64

    is_dinowm = evidence.get("kind") in {
        DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND,
        DINO_WM_WALL_SINGLE_OFFICIAL_EVAL_EVIDENCE_KIND,
    }
    is_vlajepa_openfaucet_eval = evidence.get("kind") in {
        VLAJEPA_OPENFAUCET_VJEPA20_EVAL_EVIDENCE_KIND,
        VLAJEPA_OPENFAUCET_VJEPA21_EVAL_EVIDENCE_KIND,
    }
    is_vlajepa_trashcan_eval = (
        evidence.get("kind")
        == VLAJEPA_TRASHCAN_VJEPA20_EVAL_EVIDENCE_KIND
    )
    requires_gzip = (
        is_dinowm
        or is_vlajepa_openfaucet_eval
        or is_vlajepa_trashcan_eval
    )
    expected = (
        PAYLOAD_TRANSPORT_GZIP_BASE64
        if requires_gzip
        else PAYLOAD_TRANSPORT_BASE64
    )
    if resolving_requested and not requires_gzip and declared is None:
        declared = PAYLOAD_TRANSPORT_BASE64
    if declared != expected:
        scope = (
            "DINO-WM"
            if is_dinowm
            else (
                "OpenFaucet VLA-JEPA"
                if is_vlajepa_openfaucet_eval
                else (
                    "TrashCan VLA-JEPA"
                    if is_vlajepa_trashcan_eval
                    else "non-DINO"
                )
            )
        )
        raise Refused(
            f"controller v5 {scope} manifest requires "
            f"payload_transport={expected}"
        )
    return expected


def require_safe_user_command_size(command: str) -> None:
    command_size_bytes = len(command.encode("utf-8"))
    if command_size_bytes > DLC_USER_COMMAND_SAFE_LIMIT_BYTES:
        raise Refused(
            "DLC UserCommand exceeds the controller safe limit: "
            f"{command_size_bytes} > "
            f"{DLC_USER_COMMAND_SAFE_LIMIT_BYTES} bytes"
        )


def normalize_root_symlinks(value: Any) -> List[Dict[str, str]]:
    if value is None:
        return []
    if not isinstance(value, list) or len(value) > 16:
        raise Refused("runtime.root_symlinks must be a list with at most 16 entries")

    normalized: List[Dict[str, str]] = []
    seen_links = set()
    for entry in value:
        if not isinstance(entry, dict) or set(entry) != {"link", "target"}:
            raise Refused(
                "each runtime.root_symlinks entry must contain only link and target"
            )
        link = str(entry["link"])
        target = str(entry["target"])
        if not re.fullmatch(r"/[A-Za-z0-9][A-Za-z0-9._-]*", link):
            raise Refused(f"invalid root symlink path: {link}")
        if not re.fullmatch(r"/tmp/[A-Za-z0-9][A-Za-z0-9._-]*", target):
            raise Refused(f"root symlink target must be one /tmp directory: {target}")
        if Path(link).name != Path(target).name:
            raise Refused(f"root symlink basename mismatch: {link} -> {target}")
        if link in seen_links:
            raise Refused(f"duplicate root symlink path: {link}")
        seen_links.add(link)
        normalized.append({"link": link, "target": target})
    return sorted(normalized, key=lambda item: item["link"])


def root_symlinks_for_evidence(evidence: Dict[str, Any]) -> List[Dict[str, str]]:
    if evidence.get("kind") == VLAJEPA_LEGACY_PICK_BETWEEN_TABLES_EVAL_EVIDENCE_KIND:
        return [
            {
                "link": "/bdb1f316aa0188ec",
                "target": "/tmp/bdb1f316aa0188ec",
            }
        ]
    return []


def build_inline_bootstrap(
    *,
    run_id: str,
    nonce: str,
    payload: bytes,
    write_paths: List[str],
    output_mode: str,
    recursive_repair: bool,
    expected_gpus: int,
    sentinel_path: str,
    sentinel_sha256: str,
    cpfs_id: str,
    root_symlinks: Optional[List[Dict[str, str]]] = None,
    workload_env: Optional[Dict[str, str]] = None,
    payload_transport: str = PAYLOAD_TRANSPORT_BASE64,
) -> str:
    payload_sha = sha256_bytes(payload)
    if payload_transport == PAYLOAD_TRANSPORT_BASE64:
        payload_b64 = base64.b64encode(payload).decode("ascii")
        payload_transport_declarations: List[str] = []
        payload_transport_tools = ""
        payload_materialization = [
            'payload_path="$payload_dir/payload.sh"',
            "payload_b64=" + shlex.quote(payload_b64),
            '(umask 022; printf \'%s\' "$payload_b64" | base64 -d '
            '>"$payload_path")',
            "unset payload_b64",
        ]
    elif payload_transport == PAYLOAD_TRANSPORT_GZIP_BASE64:
        compressed_buffer = io.BytesIO()
        with gzip.GzipFile(
            filename="",
            mode="wb",
            compresslevel=9,
            fileobj=compressed_buffer,
            mtime=0,
        ) as compressed_handle:
            compressed_handle.write(payload)
        compressed_payload = compressed_buffer.getvalue()
        compressed_payload_sha = sha256_bytes(compressed_payload)
        compressed_payload_b64 = base64.b64encode(compressed_payload).decode(
            "ascii"
        )
        payload_transport_declarations = [
            f"PAYLOAD_GZIP_SHA256={shlex.quote(compressed_payload_sha)}"
        ]
        payload_transport_tools = "gzip "
        payload_materialization = [
            'payload_gzip_path="$payload_dir/payload.sh.gz"',
            'payload_path="$payload_dir/payload.sh"',
            "payload_gzip_b64=" + shlex.quote(compressed_payload_b64),
            '(umask 077; printf \'%s\' "$payload_gzip_b64" | base64 -d '
            '>"$payload_gzip_path")',
            "unset payload_gzip_b64",
            '[[ "$(sha256sum "$payload_gzip_path" | awk \'{print $1}\')" '
            '== "$PAYLOAD_GZIP_SHA256" ]] || {',
            '  echo "BOOTSTRAP_REFUSED compressed payload hash mismatch" >&2; '
            "exit 68;",
            "}",
            '(umask 022; gzip -dc -- "$payload_gzip_path" '
            '>"$payload_path") || {',
            '  echo "BOOTSTRAP_REFUSED payload decompression failed" >&2; '
            "exit 68;",
            "}",
        ]
    else:
        raise Refused(f"unsupported payload transport: {payload_transport}")
    recursive_repair_flag = "1" if recursive_repair else "0"
    first_write_path = write_paths[0]
    root_symlinks = normalize_root_symlinks(root_symlinks)
    root_symlink_declarations: List[str] = []
    root_symlink_tools = ""
    root_symlink_setup: List[str] = []
    if root_symlinks:
        root_symlink_declarations = [
            f"ROOT_SYMLINK_LINKS={shell_array([entry['link'] for entry in root_symlinks])}",
            f"ROOT_SYMLINK_TARGETS={shell_array([entry['target'] for entry in root_symlinks])}",
        ]
        root_symlink_tools = "ln readlink "
        root_symlink_setup = [
            '[[ "$CURRENT_UID" == 0 ]] || {',
            '  echo "BOOTSTRAP_REFUSED root symlinks require controller root" >&2; exit 70;',
            '}',
            'for ((i=0; i<${#ROOT_SYMLINK_LINKS[@]}; i++)); do',
            '  link=${ROOT_SYMLINK_LINKS[$i]}',
            '  target=${ROOT_SYMLINK_TARGETS[$i]}',
            '  if [[ -L "$link" ]]; then',
            '    [[ "$(readlink -- "$link")" == "$target" ]] || {',
            '      echo "BOOTSTRAP_REFUSED root symlink target mismatch: $link" >&2; exit 70;',
            '    }',
            '  elif [[ -e "$link" ]]; then',
            '    echo "BOOTSTRAP_REFUSED root symlink path already exists: $link" >&2; exit 70;',
            '  else',
            '    ln -s -- "$target" "$link"',
            '  fi',
            '  [[ -L "$link" && "$(readlink -- "$link")" == "$target" ]] || {',
            '    echo "BOOTSTRAP_REFUSED failed root symlink: $link -> $target" >&2; exit 70;',
            '  }',
            '  echo "BOOTSTRAP_ROOT_SYMLINK_OK $link -> $target"',
            'done',
        ]
    workload_env = {} if workload_env is None else dict(workload_env)
    for key, value in workload_env.items():
        if not re.fullmatch(r"WRC_TASK_Q_[A-Z0-9_]+", key):
            raise Refused(f"invalid formal workload environment key: {key}")
        if not isinstance(value, str) or not value or any(
            char in value for char in ("\n", "\r", "\x00")
        ):
            raise Refused(f"invalid formal workload environment value: {key}")
    lines = [
        "#!/usr/bin/env bash",
        "set -Eeuo pipefail",
        "umask 077",
        "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "unset BASH_ENV ENV CDPATH GLOBIGNORE",
        "LEON_UID=2254",
        "LEON_GID=2254",
        f"NEW_ROOT={shlex.quote(str(NEW_ROOT))}",
        f"USER_ROOT={shlex.quote(str(USER_ROOT))}",
        f"RUN_ID={shlex.quote(run_id)}",
        f"NONCE={shlex.quote(nonce)}",
        f"EXPECTED_GPUS={shlex.quote(str(expected_gpus))}",
        f"SENTINEL={shlex.quote(sentinel_path)}",
        f"SENTINEL_SHA256={shlex.quote(sentinel_sha256)}",
        f"EXPECTED_CPFS_ID={shlex.quote(cpfs_id)}",
        f"PAYLOAD_SHA256={shlex.quote(payload_sha)}",
        *payload_transport_declarations,
        f"WRITE_PATHS={shell_array(write_paths)}",
        *root_symlink_declarations,
        f"RECURSIVE_REPAIR={recursive_repair_flag}",
        "CURRENT_UID=$(id -u)",
        "CURRENT_GID=$(id -g)",
        'if [[ "$CURRENT_UID" != 0 && "$CURRENT_UID:$CURRENT_GID" != '
        '"$LEON_UID:$LEON_GID" ]]; then',
        '  echo "BOOTSTRAP_REFUSED unexpected identity $CURRENT_UID:$CURRENT_GID" >&2',
        "  exit 50",
        "fi",
        "for required in realpath findmnt sha256sum base64 "
        f"{payload_transport_tools}{root_symlink_tools}mktemp stat dirname install setpriv env bash; do",
        '  command -v "$required" >/dev/null || {',
        '    echo "BOOTSTRAP_REFUSED missing command: $required" >&2',
        "    exit 51",
        "  }",
        "done",
        'test -d "$NEW_ROOT" || { echo "BOOTSTRAP_REFUSED missing new root" >&2; exit 52; }',
        '[[ "$(realpath -e "$NEW_ROOT")" == "$NEW_ROOT" ]] || {',
        '  echo "BOOTSTRAP_REFUSED non-canonical new root" >&2; exit 53;',
        "}",
        "assert_cpfs_path() {",
        "  local path=$1 resolved target fstype source",
        '  resolved=$(realpath -e -- "$path") || {',
        '    echo "BOOTSTRAP_REFUSED cannot resolve CPFS path: $path" >&2; exit 54;',
        "  }",
        '  case "$resolved" in "$NEW_ROOT"|"$NEW_ROOT"/*) ;;',
        '    *) echo "BOOTSTRAP_REFUSED path outside new root: $resolved" >&2; exit 55 ;;',
        "  esac",
        '  target=$(findmnt -n -o TARGET -T "$resolved") || {',
        '    echo "BOOTSTRAP_REFUSED path is not mounted: $resolved" >&2; exit 56;',
        "  }",
        '  case "$target" in "$NEW_ROOT"|"$NEW_ROOT"/*) ;;',
        '    *) echo "BOOTSTRAP_REFUSED unexpected mount target: $target" >&2; exit 57 ;;',
        "  esac",
        '  fstype=$(findmnt -n -o FSTYPE -T "$resolved")',
        '  case "$fstype" in *cpfs*|*aliyun-alinas*) ;;',
        '    *) echo "BOOTSTRAP_REFUSED unexpected filesystem: $fstype" >&2; exit 58 ;;',
        "  esac",
        '  source=$(findmnt -n -o SOURCE -T "$resolved")',
        '  [[ "$source" == *"$EXPECTED_CPFS_ID"* ]] || {',
        '    echo "BOOTSTRAP_REFUSED unexpected CPFS source: $source" >&2; exit 59;',
        "  }",
        "}",
        'test -f "$SENTINEL" && test ! -L "$SENTINEL" || {',
        '  echo "BOOTSTRAP_REFUSED mount sentinel missing" >&2; exit 60;',
        "}",
        '[[ "$(sha256sum "$SENTINEL" | awk \'{print $1}\')" == "$SENTINEL_SHA256" ]] || {',
        '  echo "BOOTSTRAP_REFUSED mount sentinel mismatch" >&2; exit 61;',
        "}",
        'assert_cpfs_path "$SENTINEL"',
        "assert_write_path() {",
        "  local path=$1 resolved",
        '  [[ "$path" == /* && "$path" != *"/../"* && "$path" != */.. ]] || {',
        '    echo "BOOTSTRAP_REFUSED invalid write path $path" >&2; exit 62;',
        "  }",
        '  resolved=$(realpath -m -- "$path")',
        '  [[ "$resolved" == "$path" ]] || {',
        '    echo "BOOTSTRAP_REFUSED non-canonical write path $path -> $resolved" >&2; exit 63;',
        "  }",
        '  case "$path" in',
        f'    {shlex.quote(str(USER_ROOT / "cache"))}/*|'
        f'{shlex.quote(str(USER_ROOT / "logs"))}/*|'
        f'{shlex.quote(str(USER_ROOT / "assets"))}/*|'
        f'{shlex.quote(str(USER_ROOT / "artifacts" / "qpilots" / "wrc_task_success_q"))}/*|'
        f'{shlex.quote(str(DATA_ROOT))}/*|'
        f'{shlex.quote(str(CKPT_ROOT))}/*|'
        f'{shlex.quote(str(PUBLIC_ROOT))}/*) ;;',
        '    *) echo "BOOTSTRAP_REFUSED write path outside Leon roots: $path" >&2; exit 64 ;;',
        "  esac",
        "}",
        'for path in "${WRITE_PATHS[@]}"; do',
        '  assert_write_path "$path"',
        '  anchor="$path"',
        '  while [[ ! -e "$anchor" ]]; do',
        '    parent=$(dirname -- "$anchor")',
        '    [[ "$parent" != "$anchor" ]] || {',
        '      echo "BOOTSTRAP_REFUSED no mounted ancestor for $path" >&2; exit 65;',
        "    }",
        '    anchor="$parent"',
        "  done",
        '  assert_cpfs_path "$anchor"',
        '  if [[ "$CURRENT_UID" == 0 ]]; then',
        '    install -d -m 0700 -o "$LEON_UID" -g "$LEON_GID" -- "$path"',
        "  else",
        '    mkdir -p -- "$path"',
        '    chmod 0700 -- "$path"',
        "  fi",
        '  assert_cpfs_path "$path"',
        '  [[ "$(stat -c \'%u:%g\' "$path")" == "$LEON_UID:$LEON_GID" ]] || {',
        '    echo "BOOTSTRAP_REFUSED write directory owner mismatch: $path" >&2; exit 66;',
        "  }",
        "done",
        'if [[ "$CURRENT_UID" == 0 && "$RECURSIVE_REPAIR" == 1 ]]; then',
        '  chown -R --no-dereference "$LEON_UID:$LEON_GID" -- "${WRITE_PATHS[@]}"',
        "fi",
        *root_symlink_setup,
        'payload_dir=$(mktemp -d /tmp/pai-payload.XXXXXXXX) || exit 67',
        'if [[ "$CURRENT_UID" == 0 ]]; then chmod 0711 "$payload_dir"; fi',
        *payload_materialization,
        'chmod 0555 "$payload_path"',
        '[[ "$(sha256sum "$payload_path" | awk \'{print $1}\')" == "$PAYLOAD_SHA256" ]] || {',
        '  echo "BOOTSTRAP_REFUSED payload hash mismatch" >&2; exit 68;',
        "}",
        f"HOME_DIR={shlex.quote(str(USER_ROOT))}",
        f"XDG_DIR={shlex.quote(first_write_path + '/xdg-cache')}",
        "safe_env=(",
        '  HOME="$HOME_DIR" USER=leon LOGNAME=leon XDG_CACHE_HOME="$XDG_DIR"',
        '  PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"',
        '  PAI_CANARY_RUN_ID="$RUN_ID" PAI_CANARY_NONCE="$NONCE"',
        f"  PAI_CANARY_RUN_DIR={shlex.quote(first_write_path)}",
        '  PAI_CANARY_EXPECTED_GPUS="$EXPECTED_GPUS"',
        '  PAI_MOUNT_SENTINEL="$SENTINEL"',
        '  PAI_MOUNT_SENTINEL_SHA256="$SENTINEL_SHA256"',
    ]
    lines.extend(
        f"  {shlex.quote(f'{key}={value}')}"
        for key, value in sorted(workload_env.items())
    )
    lines.extend(
        [
        ")",
        "while IFS= read -r env_name; do",
        '  case "$env_name" in',
        "    CUDA_*|NVIDIA_*|NCCL_*|OMPI_*|PMI_*|PMIX_*|"
        "MASTER_ADDR|MASTER_PORT|WORLD_SIZE|RANK|LOCAL_RANK|NODE_RANK|GROUP_RANK|"
        "ROLE_RANK|TORCHELASTIC_*|LD_LIBRARY_PATH|HTTP_PROXY|HTTPS_PROXY|"
        "NO_PROXY|http_proxy|https_proxy|no_proxy|WANDB_*|HF_*|TRANSFORMERS_*|"
        "XLA_*|JAX_*|TORCH_*|OMP_*|MKL_*|PAI_TASK_*)",
        '      safe_env+=("$env_name=${!env_name}") ;;',
        "  esac",
        "done < <(compgen -e)",
        'if [[ "$CURRENT_UID" == 0 ]]; then',
        '  exec setpriv --reuid="$LEON_UID" --regid="$LEON_GID" --clear-groups -- \\',
        '    env -i "${safe_env[@]}" bash --noprofile --norc "$payload_path"',
        "fi",
        '[[ "$CURRENT_UID:$CURRENT_GID" == "$LEON_UID:$LEON_GID" ]] || exit 69',
        'exec env -i "${safe_env[@]}" bash --noprofile --norc "$payload_path"',
        ]
    )
    bootstrap = "\n".join(lines) + "\n"
    # DLC executes UserCommand through /bin/sh regardless of a shebang in the
    # command text. Enter Bash explicitly before any Bash-only option or syntax
    # is evaluated.
    return "exec /bin/bash --noprofile --norc -c " + shlex.quote(bootstrap)


def validate_provenance(value: Any) -> Dict[str, Any]:
    if not isinstance(value, dict):
        raise Refused("a provenance object is required")
    source_job_id = str(value.get("contract_source_job_id", ""))
    if not JOB_ID_RE.fullmatch(source_job_id):
        raise Refused("provenance.contract_source_job_id is missing or invalid")
    if value.get("submission_method") != "cli_create":
        raise Refused("provenance.submission_method must be cli_create")
    if value.get("pai_clone_performed") is not False:
        raise Refused("provenance must state pai_clone_performed=false")
    if value.get("source_role") != "readback_reference":
        raise Refused("provenance.source_role must be readback_reference")
    resource_source_job_id = value.get("resource_source_job_id")
    if resource_source_job_id is not None and not JOB_ID_RE.fullmatch(
        str(resource_source_job_id)
    ):
        raise Refused("provenance.resource_source_job_id is invalid")
    return dict(value)


def resolve_manifest(
    requested: Dict[str, Any], source_label: str, run_id: str
) -> Dict[str, Any]:
    ensure_run_id(run_id)
    if requested.get("schema_version") != 2 or requested.get("kind") != "pytorchjob":
        raise Refused("only schema_version=2 pytorchjob manifests are supported")
    assert_no_legacy_or_placeholder(requested)

    tc = load_json(TOOLCHAIN_PATH)
    provenance = validate_provenance(requested.get("provenance"))
    alias = requested.get("resource_alias")
    resources = resource_map()
    if alias not in resources:
        raise Refused(f"unknown resource alias: {alias}")
    resource = dict(resources[alias])
    if resource.get("verification_state") == "unresolved":
        raise Refused(f"resource alias is unresolved: {alias}")
    expected_contract_source = resource.get(
        "contract_source_job_id", tc.get("contract_source_job_id")
    )
    if provenance["contract_source_job_id"] != expected_contract_source:
        raise Refused(
            "provenance contract source is not the pinned resource/toolchain source"
        )
    expected_resource_source = resource.get("source_job_id")
    if expected_resource_source and provenance.get(
        "resource_source_job_id"
    ) != expected_resource_source:
        raise Refused("provenance resource source is not the pinned resource source")

    storage = dict(requested.get("storage", {}))
    storage["data_sources"] = validate_data_sources(
        storage.get("data_sources"), tc, resource
    )
    output_root = canonical_write_path(str(storage.get("output_root", "")))
    storage["output_root"] = str(output_root)
    evidence = dict(requested.get("evidence", {}))
    if not evidence.get("kind"):
        raise Refused("a task-specific evidence.kind is required")
    artifact_dir = output_root / run_id
    replacements = {
        "{{RUN_ID}}": run_id,
        "{{ARTIFACT_DIR}}": str(artifact_dir),
    }

    nonce = secrets.token_hex(16)
    runtime = replace_tokens(dict(requested.get("runtime", {})), replacements)
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused(
            "high-level DLC CLI jobs must use "
            "controller_inline_bootstrap_then_setpriv"
        )
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("runtime numeric identity must be 2254:2254")
    runtime["pod_env"] = normalize_pod_env(runtime.get("pod_env"))
    runtime["secret_env_names"] = normalize_secret_env_names(
        runtime.get("secret_env_names")
    )
    entity_contract = validate_wandb_entity_contract(
        runtime.get("wandb_entity_contract"),
        runtime["secret_env_names"],
    )
    if entity_contract is not None:
        runtime["wandb_entity_contract"] = entity_contract
    command_file = canonical_code_file(str(runtime.get("command_file", "")))
    payload = command_file.read_bytes()
    payload_sha = sha256_bytes(payload)

    write_paths_raw = runtime.get("write_paths")
    if not isinstance(write_paths_raw, list) or not write_paths_raw:
        raise Refused("runtime.write_paths must declare exact run paths")
    write_paths = [str(canonical_write_path(str(path))) for path in write_paths_raw]
    output_mode = runtime.get("output_mode")
    if output_mode not in {"new", "resume"}:
        raise Refused("runtime.output_mode must be new or resume")
    recursive_repair = runtime.get(
        "recursive_repair", output_mode == "resume"
    )
    if type(recursive_repair) is not bool:
        raise Refused("runtime.recursive_repair must be boolean")

    sentinel = tc.get("mount_sentinel")
    new_cpfs = tc.get("new_cpfs")
    if not isinstance(sentinel, dict) or not isinstance(new_cpfs, dict):
        raise Refused("toolchain is missing mount_sentinel or new_cpfs")
    evidence = replace_tokens(
        evidence,
        {**replacements, "{{NONCE}}": nonce},
    )
    root_symlinks = normalize_root_symlinks(runtime.get("root_symlinks"))
    expected_root_symlinks = root_symlinks_for_evidence(evidence)
    if root_symlinks != expected_root_symlinks:
        raise Refused("runtime.root_symlinks differs from the evidence contract")
    if root_symlinks:
        runtime["root_symlinks"] = root_symlinks
    payload_transport = payload_transport_for_manifest(
        runtime=runtime,
        evidence=evidence,
        controller_version=CONTROLLER_VERSION,
        resolving_requested=True,
    )
    runtime["payload_transport"] = payload_transport
    command = build_inline_bootstrap(
        run_id=run_id,
        nonce=nonce,
        payload=payload,
        write_paths=write_paths,
        output_mode=output_mode,
        recursive_repair=recursive_repair,
        expected_gpus=int(requested["worker"]["gpu"]),
        sentinel_path=str(sentinel["path"]),
        sentinel_sha256=str(sentinel["sha256"]),
        cpfs_id=str(new_cpfs["id"]),
        root_symlinks=root_symlinks,
        workload_env=formal_wrc_workload_env(evidence),
        payload_transport=payload_transport,
    )
    require_safe_user_command_size(command)
    runtime.update(
        {
            "command_file": str(command_file),
            "command_file_sha256": payload_sha,
            "payload_base64": base64.b64encode(payload).decode("ascii"),
            "payload_sha256": payload_sha,
            "canary_nonce": nonce,
            "write_paths": write_paths,
            "command": command,
        }
    )
    prefix = re.sub(
        r"[^A-Za-z0-9._-]+", "-", str(requested.get("name_prefix", "leon-pai-job"))
    ).strip("-")
    suffix = f"-{run_id}-n{nonce[:8]}"
    name = f"{prefix[:max(1, 63 - len(suffix))]}{suffix}"
    description = (
        f"{requested.get('description', '')}; run_id={run_id}; "
        f"resource_alias={alias}; resource_id={resource.get('resource_id')}; "
        f"contract_source_job_id={provenance['contract_source_job_id']}; "
        f"resource_source_job_id={provenance.get('resource_source_job_id', '')}; "
        f"submission_method=cli_create; pai_clone_performed=false; nonce={nonce}"
    ).strip("; ")

    resolved = {
        "schema_version": 2,
        "controller_version": CONTROLLER_VERSION,
        "resolved_at_utc": utc_now(),
        "source_template": source_label,
        "run_id": run_id,
        "name": name,
        "description": description,
        "workspace_id": str(requested["workspace_id"]),
        "provenance": provenance,
        "resource_alias": alias,
        "resource": resource,
        "network": dict(requested.get("network", {})),
        "storage": storage,
        "worker": dict(requested["worker"]),
        "runtime": runtime,
        "fault_tolerance": dict(requested.get("fault_tolerance", {})),
        "submission": dict(requested.get("submission", {})),
        "evidence": evidence,
        "artifact_dir": str(artifact_dir),
    }
    validate_resolved(resolved)
    return resolved


def resolve_template(
    template_path: Path, run_id: str, with_wandb: bool = True
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    requested = load_json(template_path)
    if with_wandb:
        apply_wandb_secret_contract(requested)
    return requested, resolve_manifest(requested, str(template_path.resolve()), run_id)


def validate_aimaster_exact(args_text: str) -> None:
    if args_text != EXPECTED_CANARY_AIMASTER_ARGS:
        raise Refused(
            "canary AIMaster args must exactly equal Sync + OnFailure + max restart 1"
        )
    tokens = shlex.split(args_text)
    if tokens != shlex.split(EXPECTED_CANARY_AIMASTER_ARGS):
        raise Refused("AIMaster args contain drift or conflicting values")


def validate_wrc_formal_aimaster_exact(args_text: str) -> None:
    if args_text != EXPECTED_WRC_FORMAL_AIMASTER_ARGS:
        raise Refused(
            "formal WRC training AIMaster args must exactly equal "
            "Sync + OnFailure + max restart 50"
        )
    if shlex.split(args_text) != shlex.split(EXPECTED_WRC_FORMAL_AIMASTER_ARGS):
        raise Refused("formal WRC AIMaster args contain drift or conflicting values")


def validate_wrc_pinned_input_file(
    path_text: Any, expected_sha256: Any, label: str
) -> Path:
    path = Path(str(path_text or ""))
    if not path.is_absolute():
        raise Refused(f"formal WRC {label} path must be absolute")
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise Refused(
            f"formal WRC {label} does not exist: {path}: {exc}"
        ) from exc
    if resolved != path or path.is_symlink() or not path.is_file():
        raise Refused(
            f"formal WRC {label} must be a canonical regular non-symlink file"
        )
    if not any(
        path.is_relative_to(base) and path != base
        for base in WRC_FORMAL_CONTRACT_BASES
    ):
        raise Refused(
            f"formal WRC {label} is outside Leon's authorized "
            "code/data/assets/artifacts roots"
        )
    body, _ = read_regular_path(path)
    expected = str(expected_sha256 or "")
    if not re.fullmatch(r"[a-f0-9]{64}", expected):
        raise Refused(f"formal WRC {label} SHA256 is not valid")
    actual = sha256_bytes(body)
    if actual != expected:
        raise Refused(
            f"formal WRC {label} SHA256 mismatch: "
            f"expected {expected}, got {actual}"
        )
    return path


def validate_wrc_task_success_q_formal_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("formal WRC launcher payload must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"formal WRC launcher payload has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused(
            "formal WRC launcher must not reuse qualification-canary exit 42"
        )

    launcher_info = toolchain_config.get("wrc_task_success_q_launcher")
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned WRC task-success-Q launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("formal WRC command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("formal WRC payload hash is not the pinned launcher hash")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("formal WRC evidence contract is missing")
    registry_run_id = str(resolved.get("run_id", ""))
    training_lineage_id = str(evidence.get("training_lineage_run_id", ""))
    is_replacement = training_lineage_id != registry_run_id
    if not RUN_ID_RE.fullmatch(training_lineage_id):
        raise Refused("formal WRC training_lineage_run_id is invalid")
    expected_output_mode = "resume" if is_replacement else "new"
    if output_mode != expected_output_mode:
        raise Refused(
            f"formal WRC output_mode must equal {expected_output_mode}"
        )
    if recursive_repair is not False:
        raise Refused("formal WRC training forbids recursive ownership repair")
    if runtime.get("create_artifact_dir") is not is_replacement:
        raise Refused(
            "formal WRC create_artifact_dir must equal replacement state"
        )

    if evidence.get("kind") != WRC_FORMAL_EVIDENCE_KIND:
        raise Refused("formal WRC evidence.kind drifted")
    if evidence.get("contract_ready") is not True:
        raise Refused(
            "formal WRC contract_ready must be true after code/data/labels/"
            "action contract are frozen"
        )
    if evidence.get("task_id") != "arrange_3_flowers_wrc":
        raise Refused("formal WRC task_id must equal arrange_3_flowers_wrc")
    if evidence.get("q_target") != "declared_method_specific_q":
        raise Refused(
            "formal WRC q_target must stay neutral and method-contract specific"
        )
    method_id = str(evidence.get("method_id", ""))
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{2,63}", method_id):
        raise Refused("formal WRC method_id is invalid")
    q_semantics = str(evidence.get("q_semantics", ""))
    takeover_role = str(evidence.get("takeover_label_role", ""))
    for field, value in (
        ("q_semantics", q_semantics),
        ("takeover_label_role", takeover_role),
    ):
        if not re.fullmatch(r"[a-z][a-z0-9._-]{2,127}", value):
            raise Refused(f"formal WRC evidence.{field} is invalid")
    if type(evidence.get("calibrated_success_probability")) is not bool:
        raise Refused(
            "formal WRC calibrated_success_probability must be boolean"
        )
    if evidence["calibrated_success_probability"] != (
        q_semantics == "calibrated_task_success_probability"
    ):
        raise Refused(
            "formal WRC calibrated-success flag and q_semantics disagree"
        )
    if evidence.get("camera_views") != [
        "face",
        "left_wrist",
        "right_wrist",
    ]:
        raise Refused(
            "formal WRC camera contract must be exactly face + two wrist views"
        )
    if evidence.get("action_chunk_length") != 32:
        raise Refused("formal WRC action_chunk_length must equal frozen value 32")
    if evidence.get("action_dim") != 14:
        raise Refused("formal WRC action_dim must equal 14")
    if evidence.get("decision_stride") != 10:
        raise Refused("formal WRC decision_stride must equal 10")
    if evidence.get("max_updates") != 50000:
        raise Refused("formal WRC max_updates must equal 50000")

    for field in (
        "dataset_digest",
        "feature_cache_digest",
        "label_manifest_digest",
        "action_contract_digest",
        "method_contract_sha256",
    ):
        if not re.fullmatch(r"[a-f0-9]{64}", str(evidence.get(field, ""))):
            raise Refused(f"formal WRC evidence.{field} must be SHA256")
    if not re.fullmatch(r"[a-f0-9]{40}", str(evidence.get("code_commit", ""))):
        raise Refused("formal WRC evidence.code_commit must be a full Git commit")
    if not re.fullmatch(r"[a-f0-9]{40}", str(evidence.get("code_tree", ""))):
        raise Refused("formal WRC evidence.code_tree must be a full Git tree SHA")
    method_contract_path = validate_wrc_pinned_input_file(
        evidence.get("method_contract_path"),
        evidence.get("method_contract_sha256"),
        "method contract",
    )
    validate_wrc_pinned_input_file(
        evidence.get("label_manifest_path"),
        evidence.get("label_manifest_digest"),
        "label manifest",
    )
    method_body, _ = read_regular_path(method_contract_path)
    if sha256_bytes(method_body) != evidence.get("method_contract_sha256"):
        raise Refused("formal WRC method contract changed after pin validation")
    try:
        method_contract = json.loads(method_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("formal WRC method contract is not UTF-8 JSON") from exc
    if not isinstance(method_contract, dict):
        raise Refused("formal WRC method contract must contain one JSON object")
    expected_fields = {
        "schema_version",
        "kind",
        "task_id",
        "q_target",
        "method_id",
        "run_id",
        "q_semantics",
        "takeover_label_role",
        "calibrated_success_probability",
        "camera_views",
        "action_contract",
        "code",
        "data",
        "training",
        "checkpoint",
    }
    if set(method_contract) != expected_fields:
        raise Refused("formal WRC method-contract top-level fields drifted")
    exact_method_fields = {
        "schema_version": 1,
        "kind": "wrc_task_success_q_method_contract",
        "task_id": "arrange_3_flowers_wrc",
        "q_target": "declared_method_specific_q",
        "method_id": method_id,
        "run_id": training_lineage_id,
        "q_semantics": q_semantics,
        "takeover_label_role": takeover_role,
        "calibrated_success_probability": evidence.get(
            "calibrated_success_probability"
        ),
        "camera_views": ["face", "left_wrist", "right_wrist"],
    }
    for field, expected in exact_method_fields.items():
        if method_contract.get(field) != expected:
            raise Refused(f"formal WRC method contract {field} differs")
    action = method_contract.get("action_contract")
    if action != {
        "action_chunk_length": 32,
        "action_dim": 14,
        "decision_stride": 10,
        "digest": evidence.get("action_contract_digest"),
    }:
        raise Refused("formal WRC method action contract differs")
    code = method_contract.get("code")
    data = method_contract.get("data")
    training = method_contract.get("training")
    checkpoint = method_contract.get("checkpoint")
    for label, value in (
        ("code", code),
        ("data", data),
        ("training", training),
        ("checkpoint", checkpoint),
    ):
        if not isinstance(value, dict):
            raise Refused(f"formal WRC method contract lacks {label}")
    if (
        code.get("commit") != evidence.get("code_commit")
        or code.get("tree") != evidence.get("code_tree")
        or data.get("dataset_digest") != evidence.get("dataset_digest")
        or data.get("feature_cache_digest")
        != evidence.get("feature_cache_digest")
        or data.get("label_manifest_path")
        != evidence.get("label_manifest_path")
        or data.get("label_manifest_sha256")
        != evidence.get("label_manifest_digest")
    ):
        raise Refused("formal WRC method code/data provenance differs")
    checkpoint_identity_commit = str(
        code.get("checkpoint_identity_commit", code.get("commit", ""))
    )
    if not re.fullmatch(r"[a-f0-9]{40}", checkpoint_identity_commit):
        raise Refused(
            "formal WRC checkpoint identity commit must be a full Git commit"
        )
    if checkpoint_identity_commit != evidence.get(
        "checkpoint_identity_code_commit"
    ):
        raise Refused(
            "formal WRC checkpoint identity commit evidence differs"
        )
    if (
        training.get("max_updates") != 50000
        or training.get("save_interval") != 1000
        or training.get("replica_count") != 8
        or training.get("replica_mode")
        != "torchrun_independent_rank_local_replicas_no_ddp"
        or training.get("resume") != "auto"
    ):
        raise Refused("formal WRC method training topology differs")
    argv = training.get("trainer_argv")
    if (
        not isinstance(argv, list)
        or not argv
        or any(
            not isinstance(item, str)
            or not item
            or any(char in item for char in ("\x00", "\n", "\r"))
            for item in argv
        )
    ):
        raise Refused("formal WRC method trainer_argv is invalid")
    for flag, expected in {
        "--output-root": str(checkpoint.get("root", "")),
        "--code-commit": checkpoint_identity_commit,
    }.items():
        positions = [
            index for index, value in enumerate(argv) if value == flag
        ]
        if len(positions) != 1 or positions[0] + 1 >= len(argv):
            raise Refused(f"formal WRC trainer_argv requires one {flag}")
        if argv[positions[0] + 1] != expected:
            raise Refused(f"formal WRC trainer_argv {flag} differs")

    checkpoint_root = str(evidence.get("checkpoint_root", ""))
    log_root = str(evidence.get("log_root", ""))
    checkpoint_base = CKPT_ROOT / "qpilots" / "wrc_task_success_q"
    log_base = USER_ROOT / "logs" / "qpilots" / "wrc_task_success_q"
    try:
        checkpoint_parts = Path(checkpoint_root).relative_to(checkpoint_base).parts
        log_parts = Path(log_root).relative_to(log_base).parts
    except ValueError as exc:
        raise Refused(
            "formal WRC checkpoint/log roots are outside the exact task roots"
        ) from exc
    if (
        len(checkpoint_parts) != 1
        or len(log_parts) != 1
        or checkpoint_parts[0] != log_parts[0]
        or checkpoint_parts[0] != training_lineage_id
    ):
        raise Refused(
            "formal WRC checkpoint/log roots must equal the exact run_id lineage"
        )
    if write_paths != [str(artifact_dir), checkpoint_root, log_root]:
        raise Refused(
            "formal WRC write_paths must be registry artifact, exact checkpoint "
            "root, and exact task log root"
        )
    if evidence.get("first_step_marker") != str(
        Path(checkpoint_root)
        / method_id
        / "FIRST_OPTIMIZER_STEP_8_OF_8.json"
    ):
        raise Refused(
            "formal WRC first_step_marker must be the exact 8-of-8 aggregate"
        )
    if is_replacement:
        replacement_of = str(evidence.get("replacement_of_job_id", ""))
        if not JOB_ID_RE.fullmatch(replacement_of):
            raise Refused(
                "formal WRC replacement_of_job_id is missing or invalid"
            )
        active_rank_start = evidence.get("active_rank_start")
        if active_rank_start not in {0, 4}:
            raise Refused(
                "formal WRC replacement active_rank_start must equal 0 or 4"
            )
        expected_resume_marker = str(
            Path(checkpoint_root)
            / method_id
            / (
                f"RESUME_OPTIMIZER_STEP_{registry_run_id}_"
                f"RANKS_{active_rank_start}_{active_rank_start + 3}_4_OF_8.json"
            )
        )
        if evidence.get("resume_step_marker") != expected_resume_marker:
            raise Refused(
                "formal WRC replacement resume-step marker path differs"
            )
        if checkpoint_identity_commit == code.get("commit"):
            raise Refused(
                "formal WRC repair replacement must preserve the old "
                "checkpoint identity commit under a new runtime commit"
            )
    elif evidence.get("resume_step_marker") not in {None, ""}:
        raise Refused("fresh formal WRC run cannot declare resume evidence")
    if evidence.get("complete_state_save_interval_steps") != 1000:
        raise Refused("formal WRC complete-state save interval must equal 1000")
    if evidence.get("required_complete_state") != [
        "model",
        "target_model",
        "optimizer",
        "scheduler",
        "scaler",
        "sampler",
        "rng",
        "global_step",
        "run_identity",
    ]:
        raise Refused("formal WRC complete-state resume fields drifted")
    if checkpoint != {
        "root": checkpoint_root,
        "log_root": log_root,
        "required_complete_state": evidence.get("required_complete_state"),
        "retention": {
            "milestone_interval": 10000,
            "rolling_non_milestones": 3,
            "synchronous": True,
            "failure_is_fatal": True,
            "startup_repair": True,
        },
    }:
        raise Refused("formal WRC method checkpoint contract differs")
    if evidence.get("replica_mode") != training.get("replica_mode"):
        raise Refused("formal WRC replica_mode differs from method contract")
    if evidence.get("replica_count") != 8:
        raise Refused("formal WRC replica_count must equal 8")
    if evidence.get("logical_replica_count") != 8:
        raise Refused("formal WRC logical_replica_count must equal 8")
    if evidence.get("physical_gpu_count") != 4:
        raise Refused("formal WRC physical_gpu_count must equal 4")
    if evidence.get("active_rank_count") != 4:
        raise Refused("formal WRC active_rank_count must equal 4")
    active_rank_start = evidence.get("active_rank_start")
    if active_rank_start not in {0, 4}:
        raise Refused("formal WRC active_rank_start must equal 0 or 4")
    if evidence.get("wave_id") != f"ranks-{active_rank_start}-{active_rank_start + 3}":
        raise Refused("formal WRC wave_id does not match its active rank range")
    if (
        evidence.get("expected_first_work_uid") != 2254
        or evidence.get("expected_first_work_gid") != 2254
    ):
        raise Refused("formal WRC first real work must be 2254:2254")

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("formal WRC fault_tolerance contract is missing")
    validate_wrc_formal_aimaster_exact(str(fault.get("aimaster_args", "")))
    exact_fault = {
        "maximum_platform_restarts": 50,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "complete_state_save_interval_steps": 1000,
        "pai_automatic_fault_tolerance": True,
    }
    for field, expected in exact_fault.items():
        if fault.get(field) != expected:
            raise Refused(f"formal WRC fault_tolerance.{field} must equal {expected}")
    if "expected_platform_restarts" in fault:
        raise Refused(
            "formal WRC training must not inherit canary expected restart evidence"
        )

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("formal WRC submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("formal WRC job reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("formal WRC job_reserved_minutes must be zero")
    if normalize_reserved_minutes(
        submission.get("job_max_running_time_minutes")
    ) != 0:
        raise Refused("formal WRC max running time must be zero")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "wrc-task-success-q-formal-training",
        "hardware": "4xa800-idle-wave",
        "autoresume": "complete-state",
        "logical_replicas": "8",
        "active_ranks": f"{active_rank_start}-{active_rank_start + 3}",
    }
    if is_replacement:
        expected_tags.update(
            {
                "training_lineage": training_lineage_id,
                "replacement_of": evidence["replacement_of_job_id"],
            }
        )
    if submission.get("tags") != expected_tags:
        raise Refused("formal WRC submission tags drifted")
    if not provenance.get("resource_source_job_id"):
        raise Refused("formal WRC training requires a resource_source_job_id")


def validate_stablevla_target_ib_idle_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: str,
    recursive_repair: bool,
) -> None:
    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("StableVLA idle evidence contract is missing")
    if evidence.get("kind") != STABLEVLA_IDLE_EVIDENCE_KIND:
        raise Refused("StableVLA idle evidence kind drifted")
    if evidence.get("contract_ready") is not True:
        raise Refused("StableVLA idle contract must be ready")
    if evidence.get("require_actual_idle") is not True:
        raise Refused("StableVLA idle training must require actual idle placement")
    if recursive_repair is not False:
        raise Refused("StableVLA idle training forbids recursive ownership repair")
    if (
        evidence.get("expected_first_work_uid") != 2254
        or evidence.get("expected_first_work_gid") != 2254
    ):
        raise Refused("StableVLA idle first real work must be 2254:2254")
    if evidence.get("retention_policy") != (
        "all-positive-10000-milestones-plus-latest-3-complete-nonmilestones"
    ):
        raise Refused("StableVLA idle retention policy drifted")
    expected_target = {
        "target_data_config": "stablevla_sf_sort_target_20260718",
        "target_train_view": "target_20260718_train",
        "target_eval_view": "target_20260718_eval",
        "target_norm": "stablevla_sf_sort_target_20260718_norm.json",
    }
    for field, expected in expected_target.items():
        if evidence.get(field) != expected:
            raise Refused(f"StableVLA idle evidence.{field} must equal {expected}")

    launcher_info = toolchain_config.get("stablevla_target_ib_idle_launcher")
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned StableVLA idle launcher")
    expected_launcher_path = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher_path):
        raise Refused("StableVLA idle command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("StableVLA idle payload hash is not pinned")

    base_version = evidence.get("base_version")
    base_init_step = evidence.get("base_init_step")
    if base_version == "v1" and base_init_step == 70000:
        expected_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/CKPT/leon/jax/"
            "stablevla_target_ib_resume_20260730/v1_from70000_r5",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/openpi/"
            "stablevla_target_ib_resume_20260730/v1_from70000_r5",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/openpi/"
            "stablevla_target_ib_resume_20260730/v1_from70000_r5",
        ]
        if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
            raise Refused(
                "StableVLA v1@70000 idle replacement must resume existing r5 paths"
            )
        if evidence.get("adapter_resume_step") != 9000:
            raise Refused("StableVLA v1@70000 adapter resume step must equal 9000")
        if not str(evidence.get("resume_semantics", "")).startswith(
            "external-full-state-"
        ):
            raise Refused("StableVLA v1@70000 must use external full-state resume")
    elif base_version == "v2" and base_init_step == 60000:
        expected_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/CKPT/leon/jax/"
            "stablevla_target_ib_spot_20260731/v2_from60000_r1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/openpi/"
            "stablevla_target_ib_spot_20260731/v2_from60000_r1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/openpi/"
            "stablevla_target_ib_spot_20260731/v2_from60000_r1",
        ]
        adapter_resume_step = evidence.get("adapter_resume_step")
        if adapter_resume_step == -1:
            if output_mode != "new":
                raise Refused(
                    "StableVLA v2@60000 initial launch must create fresh r1 paths"
                )
            if evidence.get("resume_semantics") != (
                "base-weights-warm-start-new-adapter-optimizer"
            ):
                raise Refused("StableVLA v2@60000 first launch must be a warm-start")
        elif isinstance(adapter_resume_step, int) and adapter_resume_step > 0:
            if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
                raise Refused(
                    "StableVLA v2@60000 recovery must resume existing r1 paths"
                )
            if not str(evidence.get("resume_semantics", "")).startswith(
                "destination-full-state-"
            ):
                raise Refused(
                    "StableVLA v2@60000 recovery must use destination full state"
                )
        else:
            raise Refused("StableVLA v2@60000 adapter resume step is invalid")
    else:
        raise Refused("StableVLA idle profile permits only v1@70000 or v2@60000")
    if write_paths != expected_paths:
        raise Refused("StableVLA idle write paths drifted")

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("StableVLA idle fault_tolerance contract is missing")
    validate_wrc_formal_aimaster_exact(str(fault.get("aimaster_args", "")))
    expected_fault = {
        "maximum_platform_restarts": 50,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "complete_state_save_interval_steps": 1000,
        "pai_automatic_fault_tolerance": True,
    }
    for field, expected in expected_fault.items():
        if fault.get(field) != expected:
            raise Refused(
                f"StableVLA idle fault_tolerance.{field} must equal {expected}"
            )
    if "expected_platform_restarts" in fault:
        raise Refused(
            "StableVLA idle training must not inherit canary restart evidence"
        )

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("StableVLA idle submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("StableVLA idle job reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("StableVLA idle reserved minutes must equal zero")
    if normalize_reserved_minutes(
        submission.get("job_max_running_time_minutes")
    ) != 0:
        raise Refused("StableVLA idle max running time must equal zero")
    tags = submission.get("tags")
    if not isinstance(tags, dict):
        raise Refused("StableVLA idle tags are missing")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "stablevla-target-ib-formal-training",
        "hardware": "8xa800-idle",
        "data_domain": "target-20260718",
        "autoresume": "complete-state",
    }
    for field, expected in expected_tags.items():
        if tags.get(field) != expected:
            raise Refused(f"StableVLA idle tag {field} must equal {expected}")


def validate_vlajepa_trashcan_vjepa20_formal_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("formal TrashCan launcher payload must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"formal TrashCan launcher has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("formal TrashCan launcher must not reuse canary exit 42")

    launcher_info = toolchain_config.get("vlajepa_trashcan_vjepa20_launcher")
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned TrashCan V-JEPA2.0 launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("formal TrashCan command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("formal TrashCan payload hash is not pinned")

    if output_mode != "resume":
        raise Refused("formal TrashCan continuation requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("formal TrashCan continuation forbids recursive repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("formal TrashCan continuation needs a fresh artifact dir")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("formal TrashCan evidence contract is missing")
    exact_evidence = {
        "kind": VLAJEPA_TRASHCAN_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": "G1WholebodyOpenTrashCanTeleop-v0",
        "encoder": "V-JEPA2.0 ViT-L fpc64 256",
        "encoder_model_type": "vjepa2",
        "camera_views": 1,
        "action_horizon": 30,
        "action_dim": 36,
        "state_dim": 32,
        "per_device_batch_size": 32,
        "global_batch_size": 256,
        "max_train_steps": 40000,
        "code_commit": "7a39a132d8c1c7259e5e5cc073b45a08e5cbdba8",
        "source_tree_sha256": (
            "1d26624944fb606fffd515fdf723da0b03e4a1e831a7edf7c3762fba5e03d5a1"
        ),
        "config_sha256": (
            "582374ed36151e2f786121daa640ee82eaa3807ecdfab483f3f8470dae38f8dd"
        ),
        "dataset_sha256": (
            "5015735ab309ce7f16eb4095d7b3ca7727d8a16b2da8327bbae4119184902357"
        ),
        "normalization_sha256": (
            "17ec17bec3cea86baf1a65520c982eba4527c2e4845387c4e29ebe1ff58e526a"
        ),
        "qwen_tree_sha256": (
            "8192805046fde2e778e1ffa4bda8b5b021a9d04a40b747426a673ccbf66817db"
        ),
        "fast_tokenizer_tree_sha256": (
            "fa2afca7aa8fae9836252c77055e9f92c5c1cb24d821dbcad1ff680d33513596"
        ),
        "model_run_id": "g1_open_trash_can_vjepa20_chunk30_40k",
        "parent_job_id": "dlc1gpdh56i3f38y",
        "expected_resume_step": 36000,
        "expected_terminal_step": 40000,
        "platform_restart_limit": 50,
        "resume_semantics": "model_optimizer_scheduler_rng_global_step",
        "continuation_reason": (
            "old_root_owned_checkpoint_tree_exhausted_root_quota"
        ),
        "replaces_deleted_job_id": "dlc191cw7ei784ea",
        "require_post_resume_real_loss": True,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "stale_partial_policy": "preserve_not_count",
        "checkpoint_retention": (
            "new_continuation_root_keeps_all_10000_step_milestones_"
            "plus_latest_3_nonmilestones"
        ),
        "wandb_mode": "offline_persisted",
    }
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(
                f"formal TrashCan evidence.{field} must equal {expected}"
            )

    model_run_id = exact_evidence["model_run_id"]
    old_checkpoint = (
        CKPT_ROOT
        / "torch"
        / "vlajepa_simple"
        / model_run_id
        / "checkpoints"
        / "state_00036000"
    )
    continuation_root = CKPT_ROOT / "torch" / "vlajepa_simple_leon_resume"
    run_dir = continuation_root / model_run_id
    checkpoint_dir = run_dir / "checkpoints"
    log_dir = (
        USER_ROOT
        / "logs"
        / "vlajepa"
        / "g1_open_trash_can_vjepa20_chunk30_40k_leon_resume"
    )
    cache_dir = (
        USER_ROOT
        / "cache"
        / "vlajepa"
        / "g1_open_trash_can_vjepa20_chunk30_40k_leon_resume"
    )
    if evidence.get("parent_checkpoint") != str(old_checkpoint):
        raise Refused("formal TrashCan parent checkpoint drifted")
    if evidence.get("continuation_output_root") != str(continuation_root):
        raise Refused("formal TrashCan continuation root drifted")
    if write_paths != [
        str(artifact_dir),
        str(run_dir),
        str(checkpoint_dir),
        str(log_dir),
        str(cache_dir),
    ]:
        raise Refused("formal TrashCan exact write paths drifted")

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("formal TrashCan fault tolerance is missing")
    if fault.get("aimaster_args") != EXPECTED_VLAJEPA_TRASHCAN_AIMASTER_ARGS:
        raise Refused(
            "formal TrashCan AIMaster must be Sync OnFailure max restart 50"
        )
    if shlex.split(str(fault.get("aimaster_args", ""))) != shlex.split(
        EXPECTED_VLAJEPA_TRASHCAN_AIMASTER_ARGS
    ):
        raise Refused("formal TrashCan AIMaster args contain drift")
    exact_fault = {
        "maximum_platform_restarts": 50,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "complete_state_save_interval_steps": 1000,
        "application_auto_resume": True,
        "pai_automatic_fault_tolerance": True,
    }
    for field, expected in exact_fault.items():
        if fault.get(field) != expected:
            raise Refused(
                f"formal TrashCan fault_tolerance.{field} must equal {expected}"
            )
    if "expected_platform_restarts" in fault:
        raise Refused("formal TrashCan must not inherit canary restart evidence")

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("formal TrashCan submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("formal TrashCan reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("formal TrashCan reserved minutes must be zero")
    if normalize_reserved_minutes(
        submission.get("job_max_running_time_minutes")
    ) != 0:
        raise Refused("formal TrashCan max running time must be zero")
    if submission.get("tags") != {
        "managed_by": "pai-job-registry",
        "purpose": "training-resume",
        "task": "g1-open-trash-can",
        "model": "vlajepa-vjepa20",
        "dataset": "simple-trashcan",
        "resume_step": "36000",
        "parent_job": "dlc1gpdh56i3f38y",
        "hardware": "8xa800-idle",
        "autoresume": "complete-state",
    }:
        raise Refused("formal TrashCan submission tags drifted")
    if provenance.get("resource_source_job_id") != "dlct3tq8a7z5lsdd":
        raise Refused("formal TrashCan idle resource source drifted")


def validate_vlajepa_trashcan_vjepa20_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("TrashCan evaluation launcher must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"TrashCan evaluation launcher has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("TrashCan evaluation launcher must not reuse canary exit 42")

    launcher_info = toolchain_config.get(
        "vlajepa_trashcan_vjepa20_eval_launcher"
    )
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned TrashCan evaluation launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("TrashCan evaluation command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("TrashCan evaluation payload hash is not pinned")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
        raise Refused("TrashCan evaluation requires gzip_base64 payload transport")

    required_payload_snippets = (
        "G1WholebodyOpenTrashCanTeleop-v0",
