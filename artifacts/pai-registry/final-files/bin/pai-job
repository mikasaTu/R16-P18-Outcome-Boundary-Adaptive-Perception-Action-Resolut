        "checkpoint_digest = hashlib.sha256(checkpoint.read_bytes()).hexdigest()",
        "marker_digest = hashlib.sha256(Path(training_complete_marker).read_bytes()).hexdigest()",
        'VLAJEPA_EXEC_HORIZON="${VLAJEPA_EXEC_HORIZON:-30}"',
        'DIRECT_RUNTIME="${DIRECT_RUNTIME:-1}"',
        "formal TrashCan evaluation requires CPFS venv overlay (DIRECT_RUNTIME=1)",
        "SAFE_ZERO_PROGRESS_RUNTIME_MIGRATABLE_LAUNCHER_SHA256S=",
        'find "$EXISTING_PROGRESS_DIR" -maxdepth 1 -type f -name \'*.done\'',
