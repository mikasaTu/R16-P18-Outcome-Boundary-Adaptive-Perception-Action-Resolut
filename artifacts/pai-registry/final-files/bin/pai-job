        "model_id": expected_model,
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": "static+dev14_zero_gpu_contract",
        "validation_status": "passed_dev14_zero_gpu_preflight",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir / "replicas" / "seed99" / "output" / "logs.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "0a9492fa12044b852ae9e001cc74604b79c8bb0c",
        "source_tree": "79f5c852d721ae99bfaec95c069acbf6bf87d51e",
        "frozen_source_tar_sha256": (
            "706fd4c82facb059ec97009a19efe6ab6bc396fb358b07ef9c358dd3464b856a"
        ),
        "frozen_source_manifest_sha256": (
            "238ba4ed559251dccd4791faad25b7ba38ccde9af13987442af26936494b90ac"
        ),
        "frozen_source_file_count": 190,
        "checkpoint_sha256": (
            "8441971becdae934fe08de5b163398390a32f6fe1fb0a8df113290e2468e142b"
        ),
        "checkpoint_hydra_sha256": (
            "4ed3109219ed6820ce51fd19e4c97199552b3443ed58c502fddd6441784967e1"
        ),
        "dataset_archive_sha256": (
            "2b4ae4ed0ad03b337efac637f17752e7e7e27f864fec39dc25b51fef490c980d"
        ),
        "dataset_tree_manifest_sha256": (
            "2ce5a30563cad3a34b67ede6970fc7bc91c3d7921e56a475b4cff2b8dabaed86"
        ),
        "dataset_tree_file_count": 5779,
        "mujoco_tree_manifest_sha256": (
            "136c5687c2ab7b061986f16e1b33d9267df8ab03578bc23dd96bc3426caea4c9"
        ),
        "mujoco_tree_file_count": 52,
        "dinov2_source_commit": (
            "85a24602099d397264d5b30461ad7f3bfd726ca1"
        ),
        "dinov2_source_tree": (
            "d6c719f8fd5c50fd369d381a8710311f6f9082ae"
        ),
        "dinov2_source_tar_sha256": (
            "2f85e336d274855aa93392ff40e6b6b22a21e1ad424c6eadcd983bc4b5d35bc4"
        ),
        "dinov2_source_manifest_sha256": (
            "38af1b644fb6863961298ef09a43e696486c3cf0f093ab346e38773619ab8c27"
        ),
        "dinov2_source_file_count": 162,
        "dinov2_weight_sha256": (
            "b938bf1bc15cd2ec0feacfe3a1bb553fe8ea9ca46a7e1d8d00217f29aef60cd9"
        ),
        "dinov2_weight_size_bytes": 88283115,
        "dinov2_hub_contract": (
            "exact_run_local_cache_guarded_single_load_zero_download"
        ),
        "outputs_archive_sha256": (
            "425b0d8c2a4194d3ec996b553575f69409aa5714176b063d8401789db9179482"
        ),
        "conda_lock_sha256": (
            "a3d0bbfc4836c25c27199364b296f101bb61030346e81be11e47d478f161ffff"
        ),
        "pip_lock_sha256": (
            "f3da7d690202ff708733571f7221409a819a1e114800bd4370e730c7fb6b2d18"
        ),
        "python_binary_sha256": (
            "1d46c5d35a90da9185f97d9b36c28e59b87b052af08378eb3581abd37d4b530c"
        ),
        "launcher_sha256": observed_tools["launcher"][1],
        "cuda_entry_wrapper_sha256": observed_tools["cuda_entry_wrapper"][1],
        "artifact_validator_sha256": observed_tools["artifact_validator"][1],
        "official_config_name": "plan_wall.yaml",
        "model_asset_selector": "wall_single",
        "seeds": [99, 100],
        "n_evals_per_seed": 50,
        "total_evaluation_instances": 100,
        "planner": "mpc_cem",
