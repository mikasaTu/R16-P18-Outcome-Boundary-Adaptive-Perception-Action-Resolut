        'NORMALIZATION_CONTRACT="${NORMALIZATION_CONTRACT:-minmax32_meanstd4_v1}"',
        'EXPECTED_ENCODER_FLAVOR="${EXPECTED_ENCODER_FLAVOR:-vjepa2.0}"',
        'HSSD_SCENE="${HSSD_SCENE:-102344049}"',
        'ARTICULATED_ASSET_ID="${ARTICULATED_ASSET_ID:-005}"',
        'cd -- "$USER_ROOT"',
