    )
    registry_output_root = (
        USER_ROOT / "logs" / "pai" / "vlajepa_trashcan_vjepa20_eval"
    )
    if artifact_dir.parent != registry_output_root:
        raise Refused("TrashCan registry artifact root drifted")
    if write_paths != [str(artifact_dir), str(eval_root)]:
        raise Refused("TrashCan evaluation write paths drifted")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("TrashCan evaluation evidence contract is missing")
    exact_evidence = {
        "kind": VLAJEPA_TRASHCAN_VJEPA20_EVAL_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": "G1WholebodyOpenTrashCanTeleop-v0",
