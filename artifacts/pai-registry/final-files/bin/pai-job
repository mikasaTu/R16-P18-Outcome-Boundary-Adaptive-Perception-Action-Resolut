        "refusing CPFS overlay migration after persisted rollout",
        'ln -s "$HSSD_ASSET_ROOT/scenes/hssd/$HSSD_SCENE"',
        "STATIC_VALIDATE_ONLY",
    )
    for snippet in required_payload_snippets:
        if snippet not in payload_text:
            raise Refused(
                f"TrashCan evaluation launcher is missing contract text: {snippet}"
            )

    if output_mode != "resume":
        raise Refused("TrashCan evaluation requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("TrashCan evaluation forbids recursive ownership repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("TrashCan evaluation requires a fresh registry artifact dir")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("TrashCan evaluation must not inject secret environment values")
    if runtime.get("wandb_entity_contract") is not None:
        raise Refused("TrashCan evaluation does not use W&B")

    checkpoint = (
        CKPT_ROOT
        / "torch"
        / "vlajepa_simple_leon_resume"
        / "g1_open_trash_can_vjepa20_chunk30_40k"
        / "checkpoints"
        / "steps_40000_pytorch_model.pt"
    )
    deployment_contract = (
        USER_ROOT
        / "code"
        / "SIMPLE-DEV-vlajepa-trashcan-eval-20260806"
        / "contracts"
        / "vlajepa_trashcan_vjepa20_step40000.json"
    )
    training_complete = (
        USER_ROOT
        / "logs"
        / "pai_registry"
