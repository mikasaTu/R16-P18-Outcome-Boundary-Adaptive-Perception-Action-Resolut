        execution_horizon = evidence.get("execution_horizon")
        if type(execution_horizon) is not int or execution_horizon not in {1, 5, 30}:
            raise Refused("execution-horizon sweep requires execution_horizon=1, 5, or 30")
        run_id = str(resolved.get("run_id", ""))
        if not re.fullmatch(
            rf"vlajepa-xmp-v20-h{execution_horizon}-l0-[a-z0-9-]+", run_id
        ):
            raise Refused("execution-horizon sweep run_id/horizon binding drifted")
        run_prefix_glob = (
            f"{training_run_id}_step40000_mixednorm_1gpu4090_eval_"
            f"dr_level0_10rollouts_exec_h{execution_horizon}_v1_*"
        )
        levels = ["dr-level-0"]
        total_episodes = 10
    else:
        execution_horizon = None
        run_prefix_version = "v1" if is_vjepa21 else "v3"
        run_prefix_glob = (
            f"{training_run_id}_step40000_mixednorm_1gpu4090_eval_"
            f"dr_level0-2_10rollouts_{run_prefix_version}_*"
        )
        levels = ["dr-level-0", "dr-level-1", "dr-level-2"]
        total_episodes = 30
    exact_evidence = {
        "kind": evidence["kind"],
        "contract_ready": True,
        "task_id": profile["task_id"],
        "task_family": family,
        "training_job_id": profile["training_job_id"],
        "training_run_id": training_run_id,
        "checkpoint_step": 40000,
        "checkpoint_path": str(checkpoint),
        "checkpoint_sha256": profile["checkpoint_sha256"],
        "deployment_contract_path": str(deployment_contract),
        "deployment_contract_sha256": profile["contract_sha256"],
        "launcher_sha256": launcher_info["sha256"],
        "simple_eval_commit": (
            "b370beba13fd08fea8a8dcc442412132d8417014"
            if is_vjepa21
            else "8d95b3aa19f330b8a7c600b1aed4e3aff6a55dbc"
        ),
        "simple_eval_tree": (
            "10a7b92278c945815cac3aec240c5cf4cf9545de"
            if is_vjepa21
            else "a9a8ac09f31285cd60c5e54369078645e797135a"
        ),
        "vlajepa_training_commit": (
            "b3c557da76653701e9572ae210d56be4d7341118"
            if is_vjepa21
            else "8ba27c5f3a7437ce51cbe25bfd3b6f63860516d3"
        ),
        "vlajepa_training_tree": (
            "4c4ed4e040bdc47527a3021aeb8a5d2cfc670cfb"
            if is_vjepa21
            else "c175965d43d5f5a0ffc85b03638d426f57b47a0e"
        ),
        "vlajepa_eval_commit": (
            "6d20b3a7ef03a522a9a9ae26ccda5037dce9c5e2"
            if is_vjepa21
            else "f366558c9633c3b0b7bf0c8722ea12e680323fb0"
        ),
        "vlajepa_eval_tree": (
            "d61e2cdb9c9271d58b4e6f0d131febafd0ba8357"
            if is_vjepa21
            else "a03d986e954c50dc9b859ab5c8e93e2b7b8e4334"
        ),
        "encoder_flavor": "vjepa2.1" if is_vjepa21 else "vjepa2.0",
        "encoder_path": str(
            USER_ROOT
            / "models"
            / (
                "vjepa2_1_vitl_dist_vitG_384.pt"
                if is_vjepa21
                else "vjepa2-vitl-fpc64-256/model.safetensors"
            )
        ),
        "encoder_sha256": (
            "7ea9b7cb4a75d10644a8a8d42cff9e177b10dca8f02173f0eaf2b0bed82838c6"
            if is_vjepa21
            else "25466aef85727d16546c6cf8c99f12fcfad9cbca8225d45f23685e2e025b786b"
        ),
        "base_vlm_path": str(USER_ROOT / "models" / "Qwen3-VL-2B-Instruct"),
        "base_vlm_tree_sha256": "74c66c1d0966d845c155ff57079e078afa8b6402a14e3a0d6bbb316327770fbc",
        "base_vlm_file_count": 13,
        "base_vlm_total_size": 4266647529,
        "normalization": "minmax32_meanstd4_v1",
        "state_dim": 32,
        "action_dim": 36,
        "action_horizon": 30,
        "camera_views": 1,
        "duplicate_single_view": False,
        "levels": levels,
        "episodes_per_level": 10,
        "total_episodes": total_episodes,
        "max_episode_steps": profile["max_episode_steps"],
        "save_video": True,
        "resume": "per_episode_done_markers",
        "eval_dataset_archive_sha256": profile["eval_dataset_archive_sha256"],
        "validation_status": "passed",
        "validation_method": "static",
        "pai_probe_created": False,
        "expected_first_work_glob": str(
            eval_root / run_prefix_glob / "progress" / "dr-level-0_episode_0.done"
        ),
        "expected_complete_glob": str(eval_root / run_prefix_glob / "EVAL_COMPLETE"),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "evidence_boundary": "SIMPLE closed-loop simulation evaluation; not a real-robot result",
        "underlying_launcher_sha256": underlying_sha,
    }
    if is_exec_horizon_sweep:
        exact_evidence.update(
            execution_horizon=execution_horizon,
            execution_horizon_source="run_id",
            model_action_horizon=30,
            control_period_seconds=0.02,
            open_loop_seconds=execution_horizon * 0.02,
            seed_manifest="dr-level-0 episodes 0-9",
        )
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(f"SIMPLE4 V-JEPA2.0 evidence.{field} must equal {expected}")

    exact_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "application_auto_resume": True,
        "pai_automatic_fault_tolerance": False,
    }
    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict) or any(
        fault.get(field) != expected for field, expected in exact_fault.items()
    ):
        raise Refused("SIMPLE4 V-JEPA2.0 fault-tolerance contract drifted")

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("SIMPLE4 V-JEPA2.0 submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("SIMPLE4 V-JEPA2.0 reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("SIMPLE4 V-JEPA2.0 reserved minutes must be zero")
    if normalize_reserved_minutes(submission.get("job_max_running_time_minutes")) != 0:
        raise Refused("SIMPLE4 V-JEPA2.0 max running time must be zero")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": profile["tag"],
        "model": (
            "vlajepa-vjepa21-base-step40000-mixednorm"
            if is_vjepa21
            else "vlajepa-vjepa20-base-step40000-mixednorm"
        ),
        "hardware": "1xrtx4090",
        "levels": "0" if is_exec_horizon_sweep else "0-2",
        "resume": "per-episode",
    }
    if is_exec_horizon_sweep:
        expected_tags["experiment"] = "exec-horizon"
        expected_tags["exec-horizon"] = str(execution_horizon)
    if submission.get("tags") != expected_tags:
        raise Refused("SIMPLE4 V-JEPA2.0 submission tags drifted")

    expected_source = resolved["resource"].get("contract_source_job_id")
    if provenance.get("contract_source_job_id") != expected_source or provenance.get(
        "resource_source_job_id"
    ) != resolved["resource"].get("source_job_id"):
        raise Refused("SIMPLE4 V-JEPA2.0 RTX4090 source bindings drifted")


def validate_vlajepa_openfaucet_vjepa20_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("OpenFaucet V-JEPA2.0 launcher must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"OpenFaucet V-JEPA2.0 launcher has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("OpenFaucet V-JEPA2.0 launcher must not reuse canary exit 42")
    if 'NORMALIZATION_CONTRACT="${NORMALIZATION_CONTRACT:-q99_all_v1}"' in payload_text:
        raise Refused("OpenFaucet V-JEPA2.0 launcher must not default to full q99")

    launcher_info = toolchain_config.get(
        "vlajepa_openfaucet_vjepa20_eval_launcher"
    )
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned OpenFaucet V-JEPA2.0 launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("OpenFaucet V-JEPA2.0 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("OpenFaucet V-JEPA2.0 payload hash is not pinned")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
        raise Refused("OpenFaucet V-JEPA2.0 requires gzip_base64 payload transport")

    required_payload_snippets = (
        "G1WholebodyOpenFaucetTeleop-v0",
        "g1_open_faucet_vjepa20_hiw50k_chunk30_40k",
        'NORMALIZATION_CONTRACT="${NORMALIZATION_CONTRACT:-minmax32_meanstd4_v1}"',
        'EXPECTED_ENCODER_FLAVOR="${EXPECTED_ENCODER_FLAVOR:-vjepa2.0}"',
        'BASE_ENCODER="${BASE_ENCODER:-$USER_ROOT/models/vjepa2-vitl-fpc64-256}"',
        'HSSD_SCENE="${HSSD_SCENE:-107733960_175999701}"',
        'training_data_config="G1HandoverDataConfig"',
        'world_model_view_rule="single_rs_view_no_duplication"',
        "assets/articulated/004/output_mjcf/004.xml",
        "checkpoint_digest = sha256_file(checkpoint)",
        'encoder_model = encoder_path / "model.safetensors"',
        'grep -q \'"state.left_hand": "min_max"\'',
        'grep -q \'"action.torso_vx": "mean_std"\'',
        'BASE_VLM="${BASE_VLM:-$USER_ROOT/models/Qwen3-VL-2B-Instruct}"',
        'require_under "$BASE_VLM" "$USER_ROOT/models" "BASE_VLM"',
        'contract.get("base_vlm_tree_sha256")',
        'VLAJEPA_EXEC_HORIZON="${VLAJEPA_EXEC_HORIZON:-30}"',
        "STATIC_VALIDATE_ONLY",
    )
    for snippet in required_payload_snippets:
        if snippet not in payload_text:
            raise Refused(
                f"OpenFaucet V-JEPA2.0 launcher is missing contract text: {snippet}"
            )

    if output_mode != "resume":
        raise Refused("OpenFaucet V-JEPA2.0 requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("OpenFaucet V-JEPA2.0 forbids recursive ownership repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("OpenFaucet V-JEPA2.0 requires a fresh registry artifact dir")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("OpenFaucet V-JEPA2.0 must not inject secret environment values")
    if runtime.get("wandb_entity_contract") is not None:
        raise Refused("OpenFaucet V-JEPA2.0 evaluation does not use W&B")

    checkpoint = (
        CKPT_ROOT
        / "torch"
        / "vlajepa_openfaucet_hiw50k_vjepa20"
        / "g1_open_faucet_vjepa20_hiw50k_chunk30_40k"
        / "checkpoints"
        / "steps_40000_pytorch_model.pt"
    )
    deployment_contract = ROOT / "contracts" / "vlajepa_openfaucet_vjepa20_step40000.json"
    eval_root = CKPT_ROOT / "torch" / "vlajepa_openfaucet_hiw50k_vjepa20_eval"
    registry_output_root = (
        USER_ROOT / "logs" / "pai" / "vlajepa_openfaucet_vjepa20_eval"
    )
    if artifact_dir.parent != registry_output_root:
        raise Refused("OpenFaucet V-JEPA2.0 registry artifact root drifted")
    if write_paths != [str(artifact_dir), str(eval_root)]:
        raise Refused("OpenFaucet V-JEPA2.0 write paths drifted")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("OpenFaucet V-JEPA2.0 evidence contract is missing")
    run_prefix_glob = (
        "g1_open_faucet_vjepa20_hiw50k_chunk30_40k_step40000_"
        "mixednorm_1gpu4090_eval_level0-2_10rollouts_v1_*"
    )
    exact_evidence = {
        "kind": VLAJEPA_OPENFAUCET_VJEPA20_EVAL_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": "G1WholebodyOpenFaucetTeleop-v0",
        "task_family": "openfaucet",
        "training_job_id": "dlc19y4tfuq34kdc",
        "training_run_id": "g1_open_faucet_vjepa20_hiw50k_chunk30_40k",
        "checkpoint_step": 40000,
        "checkpoint_path": str(checkpoint),
        "checkpoint_sha256": "26124fe7f6a030d50dd7d0a3717384de2a4000939b7eff2ca90ec088a0b2a603",
        "deployment_contract_path": str(deployment_contract),
        "deployment_contract_sha256": "4a8d3720f5b3c88e05dc5b0d1cb598b7adba383a7d59ee52784e64be7db94a9b",
        "launcher_sha256": "5bea26a80fb289b8bd2dc37524c9aeab601948bca3f1d11b852f438abeb8dddb",
        "simple_eval_commit": "61beb5c1b49ded253d06a61e97eb24a3c662dada",
        "simple_eval_tree": "65c5f011e7ab00f9d8f3ee3e3b4ec2bc38121089",
        "vlajepa_training_commit": "c0acb04a8fd28bb5cb381ea546ab283a74c89424",
        "vlajepa_training_tree": "b7312ca132010cc1a08640cb3d319d1a91618d8f",
        "vlajepa_eval_commit": "f366558c9633c3b0b7bf0c8722ea12e680323fb0",
        "vlajepa_eval_tree": "a03d986e954c50dc9b859ab5c8e93e2b7b8e4334",
        "encoder_flavor": "vjepa2.0",
        "encoder_path": str(
            USER_ROOT / "models" / "vjepa2-vitl-fpc64-256" / "model.safetensors"
        ),
        "encoder_sha256": "25466aef85727d16546c6cf8c99f12fcfad9cbca8225d45f23685e2e025b786b",
        "base_vlm_path": str(USER_ROOT / "models" / "Qwen3-VL-2B-Instruct"),
        "base_vlm_tree_sha256": "74c66c1d0966d845c155ff57079e078afa8b6402a14e3a0d6bbb316327770fbc",
        "base_vlm_file_count": 13,
        "base_vlm_total_size": 4266647529,
        "normalization": "minmax32_meanstd4_v1",
        "state_dim": 32,
        "action_dim": 36,
        "action_horizon": 30,
        "camera_views": 1,
        "duplicate_single_view": False,
        "levels": ["level-0", "level-1", "level-2"],
        "episodes_per_level": 10,
        "total_episodes": 30,
        "max_episode_steps": 1000,
        "save_video": True,
        "resume": "per_episode_done_markers",
        "eval_dataset_archive_sha256": "f8ef105eecde8a1e66a41392227d12ef3e2091163cb377ac1db8f480c345c98d",
        "validation_status": "passed",
        "validation_method": "static",
        "pai_probe_created": False,
        "expected_first_work_glob": str(
            eval_root / run_prefix_glob / "progress" / "level-0_episode_0.done"
        ),
        "expected_complete_glob": str(eval_root / run_prefix_glob / "EVAL_COMPLETE"),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "evidence_boundary": "SIMPLE closed-loop simulation evaluation; not a real-robot result",
    }
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(
                f"OpenFaucet V-JEPA2.0 evidence.{field} must equal {expected}"
            )

    fault = resolved.get("fault_tolerance")
    exact_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "application_auto_resume": True,
        "pai_automatic_fault_tolerance": False,
    }
    if not isinstance(fault, dict) or any(
        fault.get(field) != expected for field, expected in exact_fault.items()
    ):
        raise Refused("OpenFaucet V-JEPA2.0 fault-tolerance contract drifted")

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("OpenFaucet V-JEPA2.0 submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("OpenFaucet V-JEPA2.0 reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("OpenFaucet V-JEPA2.0 reserved minutes must be zero")
    if normalize_reserved_minutes(submission.get("job_max_running_time_minutes")) != 0:
        raise Refused("OpenFaucet V-JEPA2.0 max running time must be zero")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "g1-open-faucet",
        "model": "vlajepa-vjepa20-hiw50k-step40000-mixednorm",
        "hardware": "1xrtx4090",
        "levels": "0-2",
        "resume": "per-episode",
    }
    if submission.get("tags") != expected_tags:
        raise Refused("OpenFaucet V-JEPA2.0 submission tags drifted")

    expected_source = resolved["resource"].get("contract_source_job_id")
    if provenance.get("contract_source_job_id") != expected_source or provenance.get(
        "resource_source_job_id"
    ) != resolved["resource"].get("source_job_id"):
        raise Refused("OpenFaucet V-JEPA2.0 RTX4090 source bindings drifted")


def validate_vlajepa_openfaucet_vjepa21_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("OpenFaucet evaluation launcher must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"OpenFaucet evaluation launcher has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("OpenFaucet evaluation launcher must not reuse canary exit 42")

    launcher_info = toolchain_config.get(
        "vlajepa_openfaucet_vjepa21_eval_launcher"
    )
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned OpenFaucet evaluation launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("OpenFaucet evaluation command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("OpenFaucet evaluation payload hash is not pinned")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
        raise Refused("OpenFaucet evaluation requires gzip_base64 payload transport")

    required_payload_snippets = (
        "G1WholebodyOpenFaucetTeleop-v0",
        "g1_open_faucet_vjepa21_hiw50k_chunk30_40k",
        "NORMALIZATION_CONTRACT=\"${NORMALIZATION_CONTRACT:-minmax32_meanstd4_v1}\"",
        "EXPECTED_ENCODER_FLAVOR=\"${EXPECTED_ENCODER_FLAVOR:-vjepa2.1}\"",
        "HSSD_SCENE=\"${HSSD_SCENE:-107733960_175999701}\"",
        "training_data_config=\"G1HandoverDataConfig\"",
        "world_model_view_rule=\"single_rs_view_no_duplication\"",
        "assets/articulated/004/output_mjcf/004.xml",
        "checkpoint_digest = sha256_file(checkpoint)",
        "encoder_digest = sha256_file(encoder_path)",
        'BASE_VLM="${BASE_VLM:-$USER_ROOT/models/Qwen3-VL-2B-Instruct}"',
        'require_under "$BASE_VLM" "$USER_ROOT/models" "BASE_VLM"',
        'contract.get("base_vlm_tree_sha256")',
        "VLAJEPA_EXEC_HORIZON=\"${VLAJEPA_EXEC_HORIZON:-30}\"",
        "STATIC_VALIDATE_ONLY",
    )
    for snippet in required_payload_snippets:
        if snippet not in payload_text:
            raise Refused(
                f"OpenFaucet evaluation launcher is missing contract text: {snippet}"
            )

    if output_mode != "resume":
        raise Refused("OpenFaucet evaluation requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("OpenFaucet evaluation forbids recursive ownership repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("OpenFaucet evaluation requires a fresh registry artifact dir")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("OpenFaucet evaluation must not inject secret environment values")
    if runtime.get("wandb_entity_contract") is not None:
        raise Refused("OpenFaucet evaluation does not use W&B")

    checkpoint = (
        CKPT_ROOT
        / "torch"
        / "vlajepa_openfaucet_hiw50k_vjepa21"
        / "g1_open_faucet_vjepa21_hiw50k_chunk30_40k"
        / "checkpoints"
        / "steps_40000_pytorch_model.pt"
    )
    deployment_contract = checkpoint.parents[1] / "deployment_contract.json"
    eval_root = CKPT_ROOT / "torch" / "vlajepa_openfaucet_hiw50k_vjepa21_eval"
    registry_output_root = (
        USER_ROOT / "logs" / "pai" / "vlajepa_openfaucet_vjepa21_eval"
    )
    if artifact_dir.parent != registry_output_root:
        raise Refused("OpenFaucet registry artifact root drifted")
    if write_paths != [str(artifact_dir), str(eval_root)]:
        raise Refused("OpenFaucet evaluation write paths drifted")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("OpenFaucet evaluation evidence contract is missing")
    exact_evidence = {
        "kind": VLAJEPA_OPENFAUCET_VJEPA21_EVAL_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": "G1WholebodyOpenFaucetTeleop-v0",
        "task_family": "openfaucet",
        "training_run_id": "g1_open_faucet_vjepa21_hiw50k_chunk30_40k",
        "checkpoint_step": 40000,
        "checkpoint_path": str(checkpoint),
        "checkpoint_sha256": (
            "ecca765fa701c0130a8dfab1590d521be679216905236ed2f17782867fd7c309"
        ),
        "deployment_contract_path": str(deployment_contract),
        "deployment_contract_sha256": (
            "0f50eec6a73fa7b6ce765ed8ecb0190ca17af9a4e5a23f92a7c60e184865e3cf"
        ),
        "launcher_sha256": (
            "0ee189af1f194c223dee8082ec3ee56213e7867e334c0675dee3f322303923cc"
        ),
        "simple_eval_commit": "c207e4cac0e5b6b07461a770eab7746159f919d2",
        "simple_eval_tree": "f1fa5ce81050b6491bc88a0cafa921a9e98bc3fa",
        "vlajepa_eval_commit": "6d20b3a7ef03a522a9a9ae26ccda5037dce9c5e2",
        "vlajepa_eval_tree": "d61e2cdb9c9271d58b4e6f0d131febafd0ba8357",
        "encoder_flavor": "vjepa2.1",
        "encoder_sha256": (
            "7ea9b7cb4a75d10644a8a8d42cff9e177b10dca8f02173f0eaf2b0bed82838c6"
        ),
        "base_vlm_path": str(USER_ROOT / "models" / "Qwen3-VL-2B-Instruct"),
        "base_vlm_tree_sha256": (
            "74c66c1d0966d845c155ff57079e078afa8b6402a14e3a0d6bbb316327770fbc"
        ),
        "base_vlm_file_count": 13,
        "base_vlm_total_size": 4266647529,
        "normalization": "minmax32_meanstd4_v1",
        "state_dim": 32,
        "action_dim": 36,
        "action_horizon": 30,
        "camera_views": 1,
        "duplicate_single_view": False,
        "levels": ["level-0", "level-1", "level-2"],
        "episodes_per_level": 10,
        "total_episodes": 30,
        "max_episode_steps": 1000,
        "save_video": True,
        "resume": "per_episode_done_markers",
        "eval_dataset_archive_sha256": (
            "f8ef105eecde8a1e66a41392227d12ef3e2091163cb377ac1db8f480c345c98d"
        ),
        "validation_status": "passed",
        "validation_method": "static",
        "pai_probe_created": False,
        "expected_first_work_glob": str(
            eval_root
            / "g1_open_faucet_vjepa21_hiw50k_chunk30_40k_step40000_1gpu4090_eval_level0-2_10rollouts_v3_mixednorm_*"
            / "progress"
            / "level-0_episode_0.done"
        ),
        "expected_complete_glob": str(
            eval_root
            / "g1_open_faucet_vjepa21_hiw50k_chunk30_40k_step40000_1gpu4090_eval_level0-2_10rollouts_v3_mixednorm_*"
            / "EVAL_COMPLETE"
        ),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "evidence_boundary": (
            "SIMPLE closed-loop simulation evaluation; not a real-robot result"
        ),
    }
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(
                f"OpenFaucet evaluation evidence.{field} must equal {expected}"
            )

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("OpenFaucet evaluation fault-tolerance contract is missing")
    exact_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "application_auto_resume": True,
        "pai_automatic_fault_tolerance": False,
    }
    for field, expected in exact_fault.items():
        if fault.get(field) != expected:
            raise Refused(
                f"OpenFaucet fault_tolerance.{field} must equal {expected}"
            )

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("OpenFaucet evaluation submission contract is missing")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("OpenFaucet evaluation reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("OpenFaucet evaluation reserved minutes must be zero")
    if normalize_reserved_minutes(
        submission.get("job_max_running_time_minutes")
    ) != 0:
        raise Refused("OpenFaucet evaluation max running time must be zero")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "g1-open-faucet",
        "model": "vlajepa-vjepa21-hiw50k-step40000",
        "hardware": "1xrtx4090",
        "levels": "0-2",
        "resume": "per-episode",
    }
    if submission.get("tags") != expected_tags:
        raise Refused("OpenFaucet evaluation submission tags drifted")

    expected_source = resolved["resource"].get("contract_source_job_id")
    if provenance.get("contract_source_job_id") != expected_source or provenance.get(
        "resource_source_job_id"
    ) != resolved["resource"].get("source_job_id"):
        raise Refused("OpenFaucet RTX4090 live source bindings drifted")


def validate_fastwam_simple_fsdp8_formal_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("formal FastWAM launcher payload must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME", "TO_BE_FILLED"):
        if marker in payload_text:
            raise Refused(
                f"formal FastWAM launcher has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("formal FastWAM launcher must not reuse canary exit 42")

    launcher_info = toolchain_config.get("fastwam_simple_fsdp8_resume_launcher")
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned FastWAM FSDP8 resume launcher")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("formal FastWAM command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("formal FastWAM payload hash is not pinned")

    if output_mode != "resume":
        raise Refused("formal FastWAM continuation requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("formal FastWAM continuation forbids recursive repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("formal FastWAM continuation needs a fresh artifact dir")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused(
            "formal FastWAM requires transient WANDB_API_KEY and WANDB_ENTITY "
            "secret injection"
        )

    profiles = {
        "G1WholebodyPickAndPlaceAndHugContainerTeleop-v0": {
            "task_alias": "hug_container",
            "task_tag": "g1-hug-container",
            "model_run_id": (
                "fastwam_xxy_hug_container_fullft_fsdp8_a800_20260726_164658"
            ),
            "checkpoint_base": str(
                CKPT_ROOT
                / "torch"
                / "fastwam_xxy_lerobot_fsdp8"
                / "fullft_hug_container"
            ),
            "expected_resume_step": 28000,
        },
        "G1WholebodyOpenFaucetTeleop-v0": {
            "task_alias": "open_faucet",
            "task_tag": "g1-open-faucet",
            "model_run_id": (
                "fastwam_xxy_open_faucet_fullft_fsdp8_a800_20260726_164658"
            ),
            "checkpoint_base": str(
                CKPT_ROOT
                / "torch"
                / "fastwam_xxy_lerobot_fsdp8"
                / "fullft_open_faucet"
            ),
            "expected_resume_step": 16000,
        },
        "G1WholebodyOpenTrashCanTeleop-v0": {
            "task_alias": "open_trash_can",
            "task_tag": "g1-open-trash-can",
            "model_run_id": (
                "fastwam_xxy_open_trashcan_fullft_fsdp8_a800_20260726_164658"
            ),
            "checkpoint_base": str(
                CKPT_ROOT
                / "torch"
                / "fastwam_xxy_lerobot_fsdp8"
                / "fullft_open_trash_can"
            ),
            "expected_resume_step": 22000,
        },
        "G1WholebodyOpenOvenTeleop-v0": {
            "task_alias": "open_oven",
            "task_tag": "g1-open-oven",
            "model_run_id": (
                "fastwam_xxy_open_oven_fullft_fsdp8_a800_20260727_140000"
            ),
            "checkpoint_base": str(
                CKPT_ROOT
                / "torch"
                / "fastwam_xxy_lerobot_fsdp8"
                / "fullft_open_oven"
            ),
            "expected_resume_step": 20000,
        },
    }
    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("formal FastWAM evidence contract is missing")
    task_id = str(evidence.get("task_id", ""))
    profile = profiles.get(task_id)
    if profile is None:
        raise Refused(f"formal FastWAM task is not authorized: {task_id}")

    model_run_id = str(profile["model_run_id"])
    checkpoint_base = Path(str(profile["checkpoint_base"]))
    run_dir = checkpoint_base / model_run_id
    expected_resume_step = int(profile["expected_resume_step"])
    resume_checkpoint = (
        run_dir / "checkpoints" / f"{expected_resume_step:06d}"
    )
    alias = str(resolved.get("resource_alias", ""))
    if alias not in {"exp-efficiency", "exp-robot", "idle-a800"}:
        raise Refused("formal FastWAM resource alias is not authorized")
    idle = alias == "idle-a800"
    platform_restart_limit = 50 if idle else 0
    expected_task_env = {
        "PAI_TASK_AUTO_FAULT_TOLERANCE": "1" if idle else "0",
        "PAI_TASK_PLATFORM_RESTART_LIMIT": str(platform_restart_limit),
    }
    if normalize_pod_env(runtime.get("pod_env")) != expected_task_env:
        raise Refused(
            "formal FastWAM runtime.pod_env must bind the selected resource "
            "to its exact platform fault-tolerance mode"
        )

    exact_evidence = {
        "kind": FASTWAM_SIMPLE_FSDP8_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": task_id,
        "task_alias": profile["task_alias"],
        "model_run_id": model_run_id,
        "checkpoint_base": str(checkpoint_base),
        "resume_checkpoint": str(resume_checkpoint),
        "expected_resume_step": expected_resume_step,
        "expected_terminal_step": 100000,
        "policy": "fastwam_full_ft",
        "action_horizon": 32,
        "n_action_steps": 10,
        "action_dim": 36,
        "proprio_dim": 32,
        "num_gpus": 8,
        "per_gpu_batch_size": 32,
        "global_batch_size": 256,
        "save_frequency_steps": 1000,
        "checkpoint_keep_every_steps": 10000,
        "checkpoint_keep_latest_non_milestone": 3,
        "platform_restart_limit": platform_restart_limit,
        "launcher_attempts": 1,
        "resume_semantics": (
            "model_optimizer_scheduler_rng_global_step_run_identity"
        ),
        "source_runtime_contract_sha256": (
            "4ad40770bc1b2a31e2bca0113544edd5a4153899ac206a79a49bc32818013c3c"
        ),
        "underlying_launcher_sha256": (
            "cc4a6521ae6a7e8da5d8d82c3d4dd4af56e2e8df426d9a08abbfa8ae7127c12c"
        ),
        "checkpoint_helper_sha256": (
            "418021dd254d7e988efb657e830df2f7de88f5a29c8853c390803014174c1ce3"
        ),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "require_post_resume_real_loss": True,
        "stale_partial_policy": "quarantine_incompatible_preserve_for_audit",
        "checkpoint_retention": (
            "keep_all_10000_step_milestones_plus_latest_3_complete_nonmilestones"
        ),
        "wandb_mode": "online_resume_same_run_id",
        "require_actual_idle": resolved.get("resource_alias") == "idle-a800",
    }
    for field, expected in exact_evidence.items():
        if evidence.get(field) != expected:
            raise Refused(
                f"formal FastWAM evidence.{field} must equal {expected}"
            )

    if write_paths != [str(artifact_dir), str(run_dir)]:
        raise Refused("formal FastWAM exact write paths drifted")

    worker = resolved.get("worker")
    if not isinstance(worker, dict):
        raise Refused("formal FastWAM worker contract is missing")
    expected_worker = {
        "count": 1,
        "gpu": 8,
        "cpu": 92,
        "memory": "1600Gi",
        "shared_memory": "1600Gi",
    }
    for field, expected in expected_worker.items():
        if worker.get(field) != expected:
            raise Refused(f"formal FastWAM worker.{field} must equal {expected}")
    if resolved.get("network") != {}:
        raise Refused("formal FastWAM network must remain source-derived and empty")
    if worker.get("driver") not in {None, ""}:
        raise Refused("formal FastWAM driver must remain source-derived and empty")

    fault = resolved.get("fault_tolerance")
    if not isinstance(fault, dict):
        raise Refused("formal FastWAM fault tolerance is missing")
    exact_fault = {
        "launcher_attempts": 1,
        "complete_state_save_interval_steps": 1000,
        "application_auto_resume": True,
    }
    if idle:
        if (
            fault.get("aimaster_args")
            != EXPECTED_IDLE_FASTWAM_SIMPLE_FSDP8_AIMASTER_ARGS
        ):
            raise Refused(
                "idle FastWAM AIMaster must be Sync OnFailure max restart 50"
            )
        if shlex.split(str(fault.get("aimaster_args", ""))) != shlex.split(
            EXPECTED_IDLE_FASTWAM_SIMPLE_FSDP8_AIMASTER_ARGS
        ):
            raise Refused("idle FastWAM AIMaster args contain drift")
        exact_fault.update(
            {
                "maximum_platform_restarts": 50,
                "retry_sleep_seconds": 30,
                "pai_automatic_fault_tolerance": True,
            }
        )
        if "expected_platform_restarts" in fault:
            raise Refused(
                "idle FastWAM must declare a restart limit, not an expected "
                "dedicated restart count"
            )
    else:
        if fault.get("aimaster_args") != "":
            raise Refused("dedicated FastWAM must disable AIMaster restart")
        exact_fault.update(
            {
                "maximum_platform_restarts": 0,
                "expected_platform_restarts": 0,
                "pai_automatic_fault_tolerance": False,
            }
        )
        if "retry_sleep_seconds" in fault:
            raise Refused(
                "dedicated FastWAM must not declare platform restart sleep"
            )
    for field, expected in exact_fault.items():
        if fault.get(field) != expected:
            raise Refused(
                f"formal FastWAM fault_tolerance.{field} must equal {expected}"
            )
    expected_hardware = (
        "8xa800-idle" if alias == "idle-a800" else "8xa800-dedicated"
    )
    expected_oversold = (
        "AcceptQuotaOverSold"
        if alias == "idle-a800"
        else "ForbiddenQuotaOverSold"
    )
    if resolved["resource"].get("oversold_type") != expected_oversold:
        raise Refused("formal FastWAM oversold placement contract drifted")
    if alias == "idle-a800":
        if provenance.get("resource_source_job_id") != "dlct3tq8a7z5lsdd":
            raise Refused("formal FastWAM idle resource source drifted")
    elif provenance.get("resource_source_job_id") is not None:
        raise Refused("formal FastWAM dedicated job must not bind an idle source")

    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("formal FastWAM submission contract is missing")
    if submission.get("priority") != 9:
        raise Refused("formal FastWAM priority must equal 9")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("formal FastWAM reservation policy must be empty")
    if normalize_reserved_minutes(submission.get("job_reserved_minutes")) != 0:
        raise Refused("formal FastWAM reserved minutes must be zero")
    if normalize_reserved_minutes(
        submission.get("job_max_running_time_minutes")
    ) != 0:
        raise Refused("formal FastWAM max running time must be zero")
    if submission.get("tags") != {
        "managed_by": "pai-job-registry",
        "purpose": "training-resume",
        "task": profile["task_tag"],
        "model": "fastwam-full-ft",
        "dataset": "fastwam-simple",
        "resume_step": str(expected_resume_step),
        "hardware": expected_hardware,
        "autoresume": "complete-state",
    }:
        raise Refused("formal FastWAM submission tags drifted")


def validate_resource_fault_tolerance_policy(
    resolved: Dict[str, Any],
) -> None:
    resource = resolved.get("resource")
    fault = resolved.get("fault_tolerance")
    if not isinstance(resource, dict) or not isinstance(fault, dict):
        raise Refused("resource and fault_tolerance contracts are required")
    resource_id = str(resource.get("resource_id", ""))
    oversold_type = str(resource.get("oversold_type", ""))
    aimaster_args = fault.get("aimaster_args")
    if not isinstance(aimaster_args, str):
        raise Refused("fault_tolerance.aimaster_args must be a string")

    if resource_id in DEDICATED_A800_RESOURCE_IDS:
        if oversold_type != "ForbiddenQuotaOverSold":
            raise Refused("dedicated A800 resources must forbid oversold placement")
        if aimaster_args:
            raise Refused(
                "exp-efficiency and exp-robot must disable PAI automatic "
                "fault tolerance and AIMaster restart"
            )
        if fault.get("expected_platform_restarts") != 0:
            raise Refused(
                "exp-efficiency and exp-robot must expect zero platform restarts"
            )
        if fault.get("pai_automatic_fault_tolerance") is not False:
            raise Refused(
                "exp-efficiency and exp-robot require "
                "pai_automatic_fault_tolerance=false"
            )
        if fault.get("maximum_platform_restarts") != 0:
            raise Refused(
                "exp-efficiency and exp-robot require "
                "maximum_platform_restarts=0"
            )
        if fault.get("launcher_attempts") != 1:
            raise Refused(
                "exp-efficiency and exp-robot require launcher_attempts=1"
            )
        return

    if resource_id == IDLE_A800_RESOURCE_ID:
        if oversold_type != "AcceptQuotaOverSold":
            raise Refused("idle A800 requires AcceptQuotaOverSold")
        if fault.get("pai_automatic_fault_tolerance") is not True:
            raise Refused("idle A800 requires PAI automatic fault tolerance")
        evidence_kind = str(resolved.get("evidence", {}).get("kind", ""))
        if evidence_kind == "autofault_owner_canary":
            if aimaster_args != EXPECTED_CANARY_AIMASTER_ARGS:
                raise Refused("idle qualification canary requires exact max-1 AIMaster")
            if fault.get("maximum_platform_restarts") != 1:
                raise Refused(
                    "idle qualification canary requires "
                    "maximum_platform_restarts=1"
                )
            if fault.get("expected_platform_restarts") != 1:
                raise Refused(
                    "idle qualification canary must expect one platform restart"
                )
        else:
            if aimaster_args != EXPECTED_IDLE_A800_AIMASTER_ARGS:
                raise Refused(
                    "formal idle A800 jobs require exact Sync OnFailure max-50 "
                    "AIMaster"
                )
            if fault.get("maximum_platform_restarts") != 50:
                raise Refused(
                    "formal idle A800 jobs require "
                    "maximum_platform_restarts=50"
                )
            if "expected_platform_restarts" in fault:
                raise Refused(
                    "formal idle A800 jobs must declare a restart limit, not "
                    "an expected restart count"
                )
        if fault.get("launcher_attempts") != 1:
            raise Refused("idle A800 requires launcher_attempts=1")
        return

    if (
        aimaster_args
        or fault.get("pai_automatic_fault_tolerance") is True
        or fault.get("maximum_platform_restarts") not in {None, 0}
    ):
        raise Refused(
            "only the idle A800 resource pool may enable PAI automatic "
            "fault tolerance"
        )


def expected_runtime_pod_env(
    resolved: Dict[str, Any],
    current_resource: Dict[str, Any],
) -> Dict[str, str]:
    expected = normalize_pod_env(current_resource.get("required_pod_env"))
    evidence = resolved.get("evidence")
    evidence_kind = (
        str(evidence.get("kind", "")) if isinstance(evidence, dict) else ""
    )
    if evidence_kind != FASTWAM_SIMPLE_FSDP8_EVIDENCE_KIND:
        return expected

    alias = str(resolved.get("resource_alias", ""))
    if alias in {"exp-efficiency", "exp-robot"}:
        fastwam_env = {
            "PAI_TASK_AUTO_FAULT_TOLERANCE": "0",
            "PAI_TASK_PLATFORM_RESTART_LIMIT": "0",
        }
    elif alias == "idle-a800":
        fastwam_env = {
            "PAI_TASK_AUTO_FAULT_TOLERANCE": "1",
            "PAI_TASK_PLATFORM_RESTART_LIMIT": "50",
        }
    else:
        raise Refused("formal FastWAM resource alias is not authorized")

    overlap = set(expected) & set(fastwam_env)
    if any(expected[name] != fastwam_env[name] for name in overlap):
        raise Refused(
            "resource required_pod_env conflicts with the FastWAM "
            "fault-tolerance mode"
        )
    return {**expected, **fastwam_env}


def validate_disable_ecs_stock_check(resolved: Dict[str, Any]) -> bool:
    submission = resolved.get("submission")
    if not isinstance(submission, dict):
        raise Refused("submission contract is required")
    disabled = submission.get("disable_ecs_stock_check", False)
    if type(disabled) is not bool:
        raise Refused("submission.disable_ecs_stock_check must be boolean")
    if not disabled:
        return False

    resource = resolved.get("resource")
    worker = resolved.get("worker")
    evidence = resolved.get("evidence")
    fault = resolved.get("fault_tolerance")
    if not isinstance(resource, dict) or not isinstance(worker, dict):
        raise Refused("stock-check bypass requires resource and worker contracts")
    if not isinstance(evidence, dict):
        raise Refused("stock-check bypass requires workload evidence")
    if not isinstance(fault, dict):
        raise Refused("stock-check bypass requires fault-tolerance evidence")
    tags = submission.get("tags")
    if not isinstance(tags, dict):
        raise Refused("stock-check bypass requires submission tags")
    purpose = str(tags.get("purpose", "")).lower()
    evidence_kind = str(evidence.get("kind", ""))
    specialized_formal = (
        evidence_kind in SPECIALIZED_FORMAL_IDLE_8GPU_EVIDENCE_KINDS
    )
    generic_formal = (
        evidence.get("idle_8gpu_contract")
        == GENERIC_FORMAL_IDLE_8GPU_CONTRACT
    )
    if (
        not str(resolved.get("resource_alias", "")).startswith("idle-a800")
        or resource.get("resource_id") != IDLE_A800_RESOURCE_ID
        or resource.get("oversold_type") != "AcceptQuotaOverSold"
        or worker.get("count") != 1
        or worker.get("gpu") != 8
        or worker.get("cpu") != 92
        or worker.get("memory") != "1600Gi"
        or worker.get("shared_memory") != "1600Gi"
        or not (specialized_formal or generic_formal)
        or evidence.get("contract_ready") is not True
        or tags.get("managed_by") != "pai-job-registry"
        or tags.get("hardware") != "8xa800-idle"
        or any(marker in purpose for marker in ("probe", "smoke", "canary"))
        or fault.get("aimaster_args") != EXPECTED_IDLE_A800_AIMASTER_ARGS
        or fault.get("maximum_platform_restarts") != 50
        or "expected_platform_restarts" in fault
        or fault.get("launcher_attempts") != 1
        or fault.get("pai_automatic_fault_tolerance") is not True
    ):
        raise Refused(
            "stock-check bypass is restricted to a validated formal "
            "8-GPU idle-a800 workload on quotaewyznuc7b9l"
        )
    return True


def validate_generic_formal_idle_8gpu_profile(
    *,
    resolved: Dict[str, Any],
    runtime: Dict[str, Any],
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("generic formal idle evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("generic formal idle submission/fault contract is missing")
    if (
        evidence.get("idle_8gpu_contract")
        != GENERIC_FORMAL_IDLE_8GPU_CONTRACT
    ):
        raise Refused("generic formal idle contract version drifted")
    if resolved.get("resource_alias") not in {
        "idle-a800",
        "idle-a800-stablevla-8gpu",
        STABLEVLA_NATIVE5_IDLE_ALIAS,
    }:
        raise Refused(
            "new generic formal workloads must use an authorized idle-a800 alias"
        )

    workload_type = str(evidence.get("workload_type", ""))
    expected_success_gate = GENERIC_FORMAL_IDLE_SUCCESS_GATES.get(workload_type)
    if expected_success_gate is None:
        raise Refused("generic formal idle workload_type is invalid")
    evidence_kind = str(evidence.get("kind", ""))
    if not re.fullmatch(r"[a-z0-9][a-z0-9_]{2,127}", evidence_kind):
        raise Refused("generic formal idle evidence.kind is invalid")
    if not evidence_kind.endswith(f"_formal_{workload_type}"):
        raise Refused(
            "generic formal idle evidence.kind must end with the workload type"
        )
    if evidence.get("success_gate") != expected_success_gate:
        raise Refused("generic formal idle success_gate drifted")

    bound_values: Dict[str, str] = {}
    for field in ("task_id", "model_id"):
        value = evidence.get(field)
        if (
            not isinstance(value, str)
            or not value
            or len(value) > 256
            or any(char in value for char in ("\n", "\r", "\x00"))
        ):
            raise Refused(f"generic formal idle evidence.{field} is invalid")
        bound_values[field] = value

    if evidence.get("contract_ready") is not True:
        raise Refused("generic formal idle contract_ready must be true")
    if evidence.get("require_actual_idle") is not True:
        raise Refused("generic formal idle requires actual idle evidence")
    if evidence.get("pai_probe_created") is not False:
        raise Refused("generic formal idle must declare pai_probe_created=false")
    if evidence.get("validation_status") != "passed":
        raise Refused("generic formal idle validation_status must be passed")
    if evidence.get("validation_method") not in {
        "static",
        "dev14_smoke",
        "static+dev14_smoke",
    }:
        raise Refused("generic formal idle validation_method is invalid")
    if evidence.get("validated_payload_sha256") != runtime.get("payload_sha256"):
        raise Refused("generic formal idle validation is not bound to the payload")
    if (
        evidence.get("expected_first_work_uid") != 2254
        or evidence.get("expected_first_work_gid") != 2254
    ):
        raise Refused("generic formal idle first-work owner must be 2254:2254")

    tags = submission.get("tags")
    if not isinstance(tags, dict):
        raise Refused("generic formal idle submission tags are missing")
    if tags.get("purpose") != f"formal-{workload_type}":
        raise Refused("generic formal idle purpose tag drifted")
    if tags.get("task") != bound_values["task_id"]:
        raise Refused("generic formal idle task tag drifted")
    if tags.get("model") != bound_values["model_id"]:
        raise Refused("generic formal idle model tag drifted")

    if runtime.get("recursive_repair", False) is not False:
        raise Refused("generic formal idle forbids recursive ownership repair")
    create_artifact_dir = runtime.get("create_artifact_dir", False)
    if output_mode == "resume" and create_artifact_dir is not True:
        raise Refused("generic formal idle resume must create a fresh artifact dir")
    if output_mode == "new" and create_artifact_dir is not False:
        raise Refused("generic formal idle new output forbids create_artifact_dir")

    first_work_path = canonical_write_path(
        str(evidence.get("first_work_evidence_path", ""))
    )
    if first_work_path == artifact_dir:
        raise Refused("generic formal idle first-work evidence must be a file path")
    if not any(
        first_work_path.is_relative_to(Path(path))
        and first_work_path != Path(path)
        for path in write_paths
    ):
        raise Refused(
            "generic formal idle first-work evidence must be under a write path"
        )

    if workload_type == "training":
        if fault.get("application_auto_resume") is not True:
            raise Refused("generic idle training requires application_auto_resume")
        if evidence.get("checkpoint_contract") != (
            "model_optimizer_scheduler_rng_global_step"
        ):
            raise Refused("generic idle training checkpoint contract drifted")
        default_retention = (
            fault.get("complete_state_save_interval_steps") == 1000
            and evidence.get("checkpoint_retention")
            == "all_10000_milestones_plus_latest_3_complete_nonmilestones"
        )
        terminal_40k_override = (
            fault.get("complete_state_save_interval_steps") == 500
            and evidence.get("checkpoint_retention")
            == "terminal_40000_plus_latest_2_complete_nonmilestones"
            and evidence.get("retention_override_authorized") is True
            and evidence.get("terminal_checkpoint_step") == 40000
            and evidence.get("rolling_keep_complete_nonmilestones") == 2
        )
        exact_40k_100k_override = (
            fault.get("complete_state_save_interval_steps") == 500
            and evidence.get("checkpoint_retention")
            == "exact_40000_100000_milestones_plus_latest_2_complete_nonmilestones"
            and evidence.get("retention_override_authorized") is True
            and evidence.get("terminal_checkpoint_step") == 100000
            and evidence.get("checkpoint_keep_steps") == [40000, 100000]
            and evidence.get("rolling_keep_complete_nonmilestones") == 2
        )
        if not (default_retention or terminal_40k_override or exact_40k_100k_override):
            raise Refused("generic idle training checkpoint retention drifted")


def validate_wallx_where_real_npz_e2e_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Fail-closed profile for the one pinned Wall-X real-data regression."""

    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    storage = resolved.get("storage")
    if not all(
        isinstance(value, dict)
        for value in (evidence, submission, fault, provenance, storage)
    ):
        raise Refused("Wall-X E2E manifest sections are missing")

    alias = resolved.get("resource_alias")
    if alias == WALLX_WHERE_REAL_NPZ_E2E_RESOURCE_ALIAS:
        launcher_key = "wallx_where_real_npz_e2e_launcher"
        expected_worker = {
            "count": 1,
            "image": (
                "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
                "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
                "py311-cu121-ubuntu22.04"
            ),
            "gpu": 2,
            "cpu": 12,
            "memory": "200Gi",
            "shared_memory": "200Gi",
        }
        resource_contract = "dedicated_2gpu_carrier_single_gpu_execution_v1"
        mount_contract = "exact_five_new_root_sources_from_live_readback"
        assigned_gpu_carrier = "2xa800_dedicated"
        provenance_contract = "dlcfp1szuc2cgqfp"
        provenance_resource = "dlc1j2p8ui63ulps"
        resource_pool_tag = "exp-efficiency"
        hardware_tag = "2xa800-carrier-1gpu-execution"
        expected_fault = {
            "aimaster_args": "",
            "maximum_platform_restarts": 0,
            "expected_platform_restarts": 0,
            "launcher_attempts": 1,
            "retry_sleep_seconds": 30,
            "pai_automatic_fault_tolerance": False,
        }
        expected_gpu_fragment = "EXPECTED_ASSIGNED_GPUS=2"
    elif alias == WALLX_WHERE_REAL_NPZ_E2E_IDLE_RESOURCE_ALIAS:
        launcher_key = "wallx_where_real_npz_e2e_idle4_launcher"
        expected_worker = {
            "count": 1,
            "image": (
                "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
                "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
                "py311-cu121-ubuntu22.04"
            ),
            "gpu": 4,
            "cpu": 46,
            "memory": "800Gi",
            "shared_memory": "800Gi",
        }
        resource_contract = "preemptible_4gpu_carrier_single_gpu_execution_v1"
        mount_contract = "exact_three_new_root_sources_from_live_idle_readback"
        assigned_gpu_carrier = "4xa800_idle"
        provenance_contract = "dlct3tq8a7z5lsdd"
        provenance_resource = "dlc1x35e210yt1lg"
        resource_pool_tag = "idle-a800"
        hardware_tag = "4xa800-idle-carrier-1gpu-execution"
        expected_fault = {
            "aimaster_args": EXPECTED_IDLE_A800_AIMASTER_ARGS,
            "maximum_platform_restarts": 50,
            "launcher_attempts": 1,
            "retry_sleep_seconds": 30,
            "pai_automatic_fault_tolerance": True,
        }
        expected_gpu_fragment = "EXPECTED_ASSIGNED_GPUS=4"
    else:
        raise Refused("Wall-X E2E requires a specialized verified carrier alias")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("Wall-X E2E runtime fields drifted")
    if resolved.get("network") != {}:
        raise Refused("Wall-X E2E network must be empty and source-derived")
    if resolved.get("worker") != expected_worker:
        raise Refused("Wall-X E2E worker drifted from its verified carrier preset")
    if Path(str(storage.get("output_root", ""))) != (
        WALLX_WHERE_REAL_NPZ_E2E_OUTPUT_ROOT
    ):
        raise Refused("Wall-X E2E output_root drifted")

    launcher_info = toolchain_config.get(launcher_key)
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("Wall-X E2E pinned launcher metadata is absent")
    launcher_relative = Path(str(launcher_info.get("file", "")))
    if launcher_relative.is_absolute() or ".." in launcher_relative.parts:
        raise Refused("Wall-X E2E launcher path is unsafe")
    launcher_path = ROOT / launcher_relative
    try:
        launcher_canonical = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"Wall-X E2E launcher is missing: {exc}") from exc
    if (
        launcher_canonical != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
    ):
        raise Refused("Wall-X E2E launcher is not a canonical regular file")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("Wall-X E2E launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("Wall-X E2E command_file is not the pinned launcher")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("Wall-X E2E command_file_sha256 drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("Wall-X E2E payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("Wall-X E2E decoded payload hash drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("Wall-X E2E payload transport must be base64")
    if runtime.get("pod_env") != {}:
        raise Refused("Wall-X E2E pod_env must be empty")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("Wall-X E2E must be submitted with --no-wandb")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("Wall-X E2E workload identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("Wall-X E2E identity mechanism drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("Wall-X E2E requires a new controller-created artifact run")
    if runtime.get("recursive_repair") is not False:
        raise Refused("Wall-X E2E forbids recursive ownership repair")
    if write_paths != [str(artifact_dir)]:
        raise Refused("Wall-X E2E write_paths must equal [artifact_dir]")

    expected_evidence = {
        "kind": WALLX_WHERE_REAL_NPZ_E2E_EVIDENCE_KIND,
        "resource_contract": resource_contract,
        "workload_type": "evaluation",
        "task_id": "wallx-where-real-npz-e2e-20260811",
        "model_id": "wallx-where-multiview-step58000",
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": (
            "static_plus_real_npz_loader_plus_full_gpu_forward_backward"
        ),
        "validation_status": "ready_for_formal_execution",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "launch-contract.env"),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "full_result_path": str(
            artifact_dir / "wallx-where-real-npz-e2e-result.json"
        ),
        "contract_ready": True,
        "mount_contract": mount_contract,
        "wallx_test_commit": "0bfc1158b5c9a383332e9e09e54aa4dc78de5eeb",
        "wallx_training_parent_commit": (
            "e899861c85e0ef86b879d559ff4901e9c59a2345"
        ),
        "dataset_commit": "f2c24a0557727a75478f267c6149c6e4dbceae24",
        "test_script_sha256": (
            "9dd4fcc046cdf555125478bfe1e780a856024b9934dabc1102efe447de717ee6"
        ),
        "launcher_sha256": launcher_sha,
        "npz_sha256": (
            "ade94fac93df432ef1d814b7eadade57abca1b53cf433305f2e301a16204433a"
        ),
        "checkpoint_step": 58000,
        "checkpoint_sha256": (
            "8a6d4878efe59220bb7723780ae33cf999232236ac85dcf36fc13f779c82c5da"
        ),
        "checkpoint_size_bytes": 18117230372,
        "checkpoint_complete_state_world_size": 8,
        "camera_order": "face_view,left_wrist_view,right_wrist_view",
        "sample_selection": (
            "deterministic_minimum_up_to_three_loader_valid_rows_covering_all_three_views"
        ),
        "batch_contract": (
            "exact_npz_episode_frame_coordinates_validity_and_sentinels_survive_"
            "production_collate"
        ),
        "token_contract": (
            "exactly_three_nonempty_ordered_image_token_runs_per_sample"
        ),
        "loss_contract": (
            "action_ar_smooth_weights_zero_and_total_equals_0.2_times_raw_where_bce"
        ),
        "gradient_contract": (
            "finite_nonzero_reader_where_decoder_visual_backbone_language_backbone_"
            "gradients"
        ),
        "assigned_gpu_carrier": assigned_gpu_carrier,
        "execution_gpu_count": 1,
        "wandb_contract": "explicitly_disabled_for_standalone_regression",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "evidence_boundary": (
            "single-process real-data full-model regression only; not distributed "
            "FSDP convergence, open-loop policy quality, simulation success, or "
            "real-robot evidence"
        ),
    }
    if evidence != expected_evidence:
        raise Refused("Wall-X E2E evidence contract drifted")

    if fault != expected_fault:
        raise Refused("Wall-X E2E fault-tolerance contract drifted")
    expected_provenance = {
        "contract_source_job_id": provenance_contract,
        "resource_source_job_id": provenance_resource,
        "submission_method": "cli_create",
        "pai_clone_performed": False,
        "source_role": "readback_reference",
    }
    if provenance != expected_provenance:
        raise Refused("Wall-X E2E source provenance drifted")

    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "wallx-where-real-npz-e2e-20260811",
        "model": "wallx-where-multiview-step58000",
        "dataset": "drawer-where-real-npz-ade94fac",
        "hardware": hardware_tag,
        "resource_pool": resource_pool_tag,
        "experiment_role": "regression-test",
    }
    if submission.get("tags") != expected_tags:
        raise Refused("Wall-X E2E submission tags drifted")
    if submission.get("priority") != 9:
        raise Refused("Wall-X E2E priority drifted")
    if submission.get("disable_ecs_stock_check") is not False:
        raise Refused("Wall-X E2E stock-check contract drifted")
    if submission.get("job_reserved_policy") not in {"", None}:
        raise Refused("Wall-X E2E must not reserve completed workers")
    if submission.get("job_reserved_minutes") != 0:
        raise Refused("Wall-X E2E reserved minutes must be zero")
    if submission.get("job_max_running_time_minutes") != 0:
        raise Refused("Wall-X E2E max-running-time contract drifted")

    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("Wall-X E2E launcher payload must be UTF-8") from exc
    required_payload_fragments = (
        expected_gpu_fragment,
        "EXPECTED_PROJECT_COMMIT=0bfc1158b5c9a383332e9e09e54aa4dc78de5eeb",
        "EXPECTED_WHERE_NPZ_SHA=ade94fac93df432ef1d814b7eadade57abca1b53cf433305f2e301a16204433a",
        "EXPECTED_CHECKPOINT_SHA=8a6d4878efe59220bb7723780ae33cf999232236ac85dcf36fc13f779c82c5da",
        "export CUDA_VISIBLE_DEVICES=0",
        "--where-loss-weight 0.2",
    )
    for fragment in required_payload_fragments:
        if payload_text.count(fragment) != 1:
            raise Refused(f"Wall-X E2E launcher binding drifted: {fragment}")


def validate_dinowm_pusht_official_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("DINO-WM PushT evaluation evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("DINO-WM PushT submission/fault contract is missing")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        expected_runtime_fields.add("payload_transport")
    if set(runtime) != expected_runtime_fields:
        raise Refused("DINO-WM PushT runtime fields drifted")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("DINO-WM PushT evaluation requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("DINO-WM PushT network must be empty and source-derived")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused(
            "DINO-WM PushT worker must exactly equal the verified 2-GPU preset"
        )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != DINO_WM_PUSHT_OUTPUT_ROOT:
        raise Refused("DINO-WM PushT output_root drifted from the fixed production root")

    tool_specs = {
        "launcher": (
            "dinowm_pusht_official_eval_launcher",
            "launcher_sha256",
        ),
        "cuda_entry_wrapper": (
            "dinowm_pusht_official_cuda_entry_wrapper",
            "cuda_entry_wrapper_sha256",
        ),
        "artifact_validator": (
            "dinowm_pusht_official_artifact_validator",
            "artifact_validator_sha256",
        ),
    }
    observed_tools: Dict[str, Tuple[Path, str]] = {}
    for role, (toolchain_key, evidence_field) in tool_specs.items():
        info = toolchain_config.get(toolchain_key)
        if not isinstance(info, dict) or set(info) != {"file", "sha256"}:
            raise Refused(f"DINO-WM toolchain entry {toolchain_key} drifted")
        relative = Path(str(info.get("file", "")))
        if relative.is_absolute() or ".." in relative.parts:
            raise Refused(f"DINO-WM toolchain path {toolchain_key} is unsafe")
        path = ROOT / relative
        try:
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(f"DINO-WM pinned tool is missing: {path}: {exc}") from exc
        if canonical != path or path.is_symlink() or not path.is_file():
            raise Refused(f"DINO-WM pinned tool is not canonical: {path}")
        observed_hash = sha256(path)
        if observed_hash != info.get("sha256"):
            raise Refused(f"DINO-WM pinned tool hash drifted: {role}")
        if evidence.get(evidence_field) != observed_hash:
            raise Refused(f"DINO-WM evidence does not bind the {role} hash")
        observed_tools[role] = (path, observed_hash)

    launcher_path, launcher_sha = observed_tools["launcher"]
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("DINO-WM command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("DINO-WM frozen payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("DINO-WM decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM launcher payload must be UTF-8") from exc
    for role, variable in (
        ("cuda_entry_wrapper", "EXPECTED_ENTRY_SHA256"),
        ("artifact_validator", "EXPECTED_VALIDATOR_SHA256"),
    ):
        expected_line = f"{variable}={observed_tools[role][1]}"
        if payload_text.count(expected_line) != 1:
            raise Refused(f"DINO-WM launcher does not bind exact {role} hash")

    expected_task = "dinowm-pusht-official-dual-seed-eval-20260805"
    expected_model = "dinowm-pusht-official-latest-e909f0c"
    expected_evidence = {
        "kind": DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "evaluation",
        "task_id": expected_task,
        "model_id": expected_model,
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": "static+dev14_cpu_contract",
        "validation_status": "passed_no_pai_gpu_execution",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir / "replicas" / "seed99" / "result.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "contract_ready": True,
