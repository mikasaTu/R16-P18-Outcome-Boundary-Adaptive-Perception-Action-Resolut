def validate_fastwam_g1_level012_1gpu4090_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: bool,
    provenance: Dict[str, Any],
) -> None:
    evidence = resolved.get("evidence")
    fault = resolved.get("fault_tolerance")
    submission = resolved.get("submission")
    if not isinstance(evidence, dict):
        raise Refused("FastWAM 4090 evaluation evidence contract is missing")
    if not isinstance(fault, dict) or not isinstance(submission, dict):
        raise Refused("FastWAM 4090 evaluation fault/submission contract is missing")
    if evidence.get("kind") != FASTWAM_G1_LEVEL012_1GPU4090_EVIDENCE_KIND:
        raise Refused("unexpected FastWAM 4090 evaluation evidence kind")

    expected_evidence_keys = {
        "base_port",
        "checkpoint_complete_required",
        "checkpoint_root",
        "checkpoint_source",
        "checkpoint_step",
        "check_camera",
        "direct_runtime",
        "episodes_per_level",
        "eval_levels",
        "evaluation_policy",
        "evidence_boundary",
        "expected_complete_path",
        "expected_first_work_gid",
        "expected_first_work_glob",
        "expected_first_work_uid",
        "historical_eval_job_id",
        "historical_launcher_contract",
        "in_job_max_attempts",
        "inter_job_resume",
        "kind",
        "retry_delay_seconds",
        "save_video",
        "server_cuda_memory_fraction",
        "server_cuda_memory_gib",
        "simulation_backend",
        "source_dataset",
        "source_zip_sha256",
        "task_alias",
        "task_id",
        "total_episodes",
    }
    inter_job_resume = evidence.get("inter_job_resume") is True
    if inter_job_resume:
        expected_evidence_keys.update(
            {
                "cache_policy",
                "resume_imported_complete_levels",
                "resume_imported_partial_episodes",
                "resume_restart_episode",
                "resume_source_job_id",
                "resume_source_root",
                "resume_source_run_id",
            }
        )
    if set(evidence) != expected_evidence_keys:
        raise Refused("FastWAM 4090 evaluation evidence keys drifted")

    task_alias = str(evidence.get("task_alias", ""))
    task_contract = FASTWAM_G1_LEVEL012_1GPU4090_TASKS.get(task_alias)
    if task_contract is None:
        raise Refused("FastWAM 4090 evaluation task alias is unsupported")
    if evidence.get("task_id") != task_contract["task_id"]:
        raise Refused("FastWAM 4090 evaluation task identity drifted")
    if evidence.get("checkpoint_root") != task_contract["checkpoint_root"]:
        raise Refused("FastWAM 4090 evaluation checkpoint lineage drifted")
    checkpoint_step = evidence.get("checkpoint_step")
    if type(checkpoint_step) is not int or checkpoint_step not in {40000, 100000}:
        raise Refused("FastWAM 4090 evaluation supports only 40k or 100k")
    expected_checkpoint_source = str(
        Path(task_contract["checkpoint_root"])
        / "checkpoints"
        / f"{checkpoint_step:06d}"
        / "pretrained_model"
    )
    if evidence.get("checkpoint_source") != expected_checkpoint_source:
        raise Refused("FastWAM 4090 evaluation checkpoint source drifted")
    step_token = "40k" if checkpoint_step == 40000 else "100k"
    expected_run_prefix = (
        f"fastwam-{task_contract['run_token']}-{step_token}-l012-"
    )
    if not re.fullmatch(
        re.escape(expected_run_prefix) + r"[a-z0-9][a-z0-9-]{2,24}",
        str(resolved["run_id"]),
    ):
        raise Refused("FastWAM 4090 evaluation run_id/task/step binding drifted")
    if inter_job_resume:
        expected_resume = {
            "cache_policy": "pod_local_tmp_per_run",
            "resume_imported_complete_levels": ["level-0", "level-1"],
            "resume_imported_partial_episodes": [0, 1, 2, 3],
            "resume_restart_episode": 4,
            "resume_source_job_id": "dlc1r0oc22ylx2pb",
            "resume_source_root": str(
                FASTWAM_G1_LEVEL012_1GPU4090_OUTPUT_ROOT
                / "fastwam-oven-100k-l012-20260808-r1"
            ),
            "resume_source_run_id": "fastwam-oven-100k-l012-20260808-r1",
        }
        if (
            task_alias != "open_oven"
            or checkpoint_step != 100000
            or resolved["run_id"] != "fastwam-oven-100k-l012-20260809-r2"
        ):
            raise Refused("FastWAM inter-job resume is sealed to the Oven r2 repair")
        for key, expected in expected_resume.items():
            if evidence.get(key) != expected:
                raise Refused(f"FastWAM resume evidence drifted: {key}")

    expected_artifact_dir = (
        FASTWAM_G1_LEVEL012_1GPU4090_OUTPUT_ROOT / str(resolved["run_id"])
    )
    if artifact_dir != expected_artifact_dir:
        raise Refused("FastWAM 4090 evaluation artifact directory drifted")
    if resolved.get("storage", {}).get("output_root") != str(
        FASTWAM_G1_LEVEL012_1GPU4090_OUTPUT_ROOT
    ):
        raise Refused("FastWAM 4090 evaluation output root drifted")
    if write_paths != [str(artifact_dir)]:
        raise Refused("FastWAM 4090 evaluation may write only its run directory")
    if output_mode != "resume" or recursive_repair is not False:
        raise Refused(
            "FastWAM 4090 evaluation requires durable resume output without "
            "recursive ownership repair"
        )
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("FastWAM 4090 evaluation requires a fresh artifact directory")

    expected_values = {
        "base_port": 12400,
        "checkpoint_complete_required": True,
        "check_camera": True,
        "direct_runtime": True,
        "episodes_per_level": 10,
        "eval_levels": ["level-0", "level-1", "level-2"],
        "evaluation_policy": "fastwam_decoupled_wbc",
        "evidence_boundary": (
            "SIMPLE closed-loop simulation evaluation; not a real-robot result"
        ),
        "expected_complete_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "expected_first_work_gid": 2254,
        "expected_first_work_glob": str(
            artifact_dir
            / ("level-2/shard0.result" if inter_job_resume else "level-0/shard0.result")
        ),
        "expected_first_work_uid": 2254,
        "historical_eval_job_id": "dlc1ayqcqy40msh5",
        "historical_launcher_contract": (
            "pai_fastwam_simple_eval_1gpu_4090_autoresume.sh"
        ),
        "in_job_max_attempts": 6,
        "inter_job_resume": inter_job_resume,
        "retry_delay_seconds": 120,
        "save_video": True,
        "server_cuda_memory_fraction": "0.80",
        "server_cuda_memory_gib": 19,
        "simulation_backend": "mujoco_isaac",
        "source_dataset": "USC-PSI-Lab/psi-data",
        "source_zip_sha256": task_contract["source_zip_sha256"],
        "total_episodes": 30,
    }
    for key, expected in expected_values.items():
        if evidence.get(key) != expected:
            raise Refused(f"FastWAM 4090 evaluation evidence drifted: {key}")

    launcher_info = toolchain_config.get(
        "fastwam_g1_level012_1gpu4090_eval_launcher"
    )
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned FastWAM 4090 evaluator")
    expected_launcher = ROOT / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("FastWAM 4090 command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("FastWAM 4090 launcher payload hash drifted")
    if sha256_bytes(payload) != launcher_info.get("sha256"):
        raise Refused("FastWAM 4090 frozen payload content drifted")

    if fault != {
        "aimaster_args": "",
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "maximum_platform_restarts": 0,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused(
            "FastWAM 4090 evaluation requires AIMaster off, zero platform "
            "restarts, and one launcher attempt"
        )
    expected_tags = {
        "checkpoint_step": str(checkpoint_step),
        "hardware": "1xrtx4090",
        "levels": "level012",
        "managed_by": "pai-job-registry",
        "purpose": "fastwam-g1-level012-formal-evaluation",
        "task": str(task_contract["task_id"]),
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_max_running_time_minutes": 0,
        "job_reserved_minutes": 0,
        "job_reserved_policy": "",
        "tags": expected_tags,
    }:
        raise Refused("FastWAM 4090 exact submission contract drifted")
    expected_source = resolved["resource"].get("contract_source_job_id")
    if provenance.get("contract_source_job_id") != expected_source or provenance.get(
        "resource_source_job_id"
    ) != resolved["resource"].get("source_job_id"):
        raise Refused("FastWAM 4090 live source bindings drifted")


def validate_r22p10_libero_phase1_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R22-P10 LIBERO Phase-1 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R22-P10 LIBERO Phase-1 submission/fault contract is missing")
    evidence_kind = str(evidence.get("kind", ""))
    if evidence_kind not in {
        R22P10_LIBERO_PHASE1_TRAIN_EVIDENCE_KIND,
        R22P10_LIBERO_PHASE1_EVAL_EVIDENCE_KIND,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 evidence kind is not authorized")
    is_training = evidence_kind == R22P10_LIBERO_PHASE1_TRAIN_EVIDENCE_KIND

    if resolved.get("resource_alias") != R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        raise Refused("R22-P10 LIBERO Phase-1 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P10 LIBERO Phase-1 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P10 LIBERO Phase-1 worker must equal the verified preset")

    output_root = (
        R22P10_LIBERO_PHASE1_TRAIN_OUTPUT_ROOT
        if is_training
        else R22P10_LIBERO_PHASE1_EVAL_OUTPUT_ROOT
    )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != output_root:
        raise Refused("R22-P10 LIBERO Phase-1 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P10 LIBERO Phase-1 runtime fields drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("R22-P10 LIBERO Phase-1 explicitly disables W&B/job env")
    if "wandb_entity_contract" in runtime:
        raise Refused("R22-P10 LIBERO Phase-1 must not request W&B credentials")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P10 LIBERO Phase-1 requires base64 payload transport")

    toolchain_key = (
        "r22p10_libero_phase1_train_launcher"
        if is_training
        else "r22p10_libero_phase1_eval_launcher"
    )
    launcher_info = toolchain_config.get(toolchain_key)
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R22-P10 LIBERO Phase-1 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P10 LIBERO Phase-1 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R22-P10 LIBERO Phase-1 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R22-P10 LIBERO Phase-1 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R22-P10 LIBERO Phase-1 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-1 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P10 LIBERO Phase-1 launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={R22P10_LIBERO_PHASE1_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R22P10_LIBERO_PHASE1_SOURCE_TREE}",
        "EXPECTED_LIBERO_COMMIT=2319dbd914673f6ef34a00584536212b10e10395",
        "test \"${PAI_CANARY_EXPECTED_GPUS:-}\" = 2",
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R22-P10 LIBERO Phase-1 payload binding drifted: {fragment}")

    common_evidence = {
        "kind": evidence_kind,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training" if is_training else "evaluation",
        "task_id": (
            "r22p10-libero-phase1-small-bc-20260812"
            if is_training
            else "r22p10-libero-phase1-token-causality-20260812"
        ),
        "model_id": (
            "state-chunk-bc-w256-d4-c10-e5"
            if is_training
            else "state-chunk-bc-checkpoint-grid"
        ),
        "success_gate": (
            "persisted_step_and_loss"
            if is_training
            else "persisted_completed_evaluation_result"
        ),
        "validation_method": (
            "static+dev14_cpu_contract+single_batch_gpu_smoke"
            if is_training
            else "static+dev14_cpu_deterministic_replay_contract"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": (
            str(
                R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT
                / "push_the_plate_to_the_front_of_the_stove"
                / "FIRST_WORK.json"
            )
            if is_training
            else str(
                artifact_dir
                / "evaluation"
                / "push_the_plate_to_the_front_of_the_stove"
                / "FIRST_COMPLETED_ROLLOUT.json"
            )
        ),
        "completed_evidence_path": str(
            artifact_dir
            / ("TRAINING_COMPLETE.json" if is_training else "EVALUATION_COMPLETE.json")
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R22P10_LIBERO_PHASE1_SOURCE_COMMIT,
        "source_tree": R22P10_LIBERO_PHASE1_SOURCE_TREE,
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
        "launcher_sha256": launcher_sha,
        "formal_python_sha256": (
            "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a"
        ),
        "formal_torch": "2.5.1+cu124",
        "overlay_manifest_sha256": (
            "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459"
        ),
        "overlay_file_count": 1688,
        "checkpoint_root": str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT),
        "chunk_size": 10,
        "execution_prefix": 5,
        "gpu_execution": "gpu0_push_plus_gpu1_drawer_then_gpu0_wine",
        "wandb_mode": "disabled_task_local_jsonl_v1",
        "experiment_scope": (
            "preliminary_small_bc_only"
            if is_training
            else "preliminary_not_formal_go"
        ),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if is_training:
        common_evidence.update(
            {
                "demo_sha256": {
                    "push": "36b4e1bced49d2f4ff6b2fce6b1596a63978e14199e2513cd0df71e127bf47a6",
                    "drawer": "1b50d99a053a7e4547c9ae9ccd2e3cd762543d27be78f240f13440d7ae487ae8",
                    "wine": "f9092aa70734fc4083e97fc58c3ba25f87c614d18326182ddc7a455f0ab4da2e",
                },
                "checkpoint_cadence_steps": 2000,
                "full_state_resume": True,
                "max_steps_per_task": 12000,
                "batch_size_per_process": 256,
                "tasks": [
                    "push_the_plate_to_the_front_of_the_stove",
                    "open_the_top_drawer_and_put_the_bowl_inside",
                    "put_the_wine_bottle_on_the_rack",
                ],
            }
        )
    else:
        common_evidence.update(
            {
                "checkpoint_steps": [2000, 4000, 6000, 8000, 10000, 12000],
                "baseline_fixed_seeds_per_checkpoint": 20,
                "baseline_selection_band": [0.45, 0.9],
                "controlled_episodes_per_task": 5,
                "natural_failures_per_task_max": 5,
                "natural_directions_per_token": 8,
                "snapshot_contract": (
                    "mujoco_mjSTATE_INTEGRATION_plus_controller_"
                    "interpolator_gripper"
                ),
            }
        )
    if evidence != common_evidence:
        raise Refused("R22-P10 LIBERO Phase-1 exact evidence contract drifted")

    expected_write_paths = [str(artifact_dir)]
    if is_training:
        expected_write_paths.append(str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT))
    if write_paths != expected_write_paths:
        raise Refused("R22-P10 LIBERO Phase-1 write paths drifted")
    if is_training:
        if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
            raise Refused("R22-P10 training requires resumable application output")
    elif output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R22-P10 evaluation requires a fresh artifact directory")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P10 LIBERO Phase-1 forbids recursive ownership repair")

    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training" if is_training else "formal-evaluation",
        "task": (
            "r22p10-libero-phase1-small-bc-20260812"
            if is_training
            else "r22p10-libero-phase1-token-causality-20260812"
        ),
        "model": (
            "state-chunk-bc-w256-d4-c10-e5"
            if is_training
            else "state-chunk-bc-checkpoint-grid"
        ),
        "dataset": "libero-goal-three-task-locked",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "preliminary-token-causality-qualification",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 submission contract drifted")


def validate_r16p18_libero_stage1_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P18 LIBERO Stage-1 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P18 LIBERO Stage-1 submission/fault contract is missing")
    if evidence.get("kind") != R16P18_LIBERO_STAGE1_EVIDENCE_KIND:
        raise Refused("R16-P18 LIBERO Stage-1 evidence kind is not authorized")
    if resolved.get("resource_alias") != R16P18_LIBERO_STAGE1_RESOURCE_ALIAS:
        raise Refused("R16-P18 LIBERO Stage-1 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P18 LIBERO Stage-1 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P18 LIBERO Stage-1 worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P18_LIBERO_STAGE1_OUTPUT_ROOT:
        raise Refused("R16-P18 LIBERO Stage-1 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R16-P18 LIBERO Stage-1 runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P18 LIBERO Stage-1 public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R16-P18 LIBERO Stage-1 requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R16-P18 LIBERO Stage-1 W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P18 LIBERO Stage-1 requires base64 payload transport")

    launcher_info = toolchain_config.get("r16p18_libero_stage1_baseline_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R16-P18 LIBERO Stage-1 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P18 LIBERO Stage-1 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R16-P18 LIBERO Stage-1 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R16-P18 LIBERO Stage-1 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R16-P18 LIBERO Stage-1 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P18 LIBERO Stage-1 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P18 LIBERO Stage-1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P18 LIBERO Stage-1 launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={R16P18_LIBERO_STAGE1_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R16P18_LIBERO_STAGE1_SOURCE_TREE}",
        "EXPECTED_CONFIG_SHA256=d4344c056e1c7682cec9deabd0c82888bd6ec29d6d473b9a1870a262aeaa64bf",
        "test \"${PAI_CANARY_EXPECTED_GPUS:-}\" = 2",
        "test \"${WANDB_ENTITY:-}\" = chen_jian-cj-workspace",
        "cd \"$PROJECT_DIR\"",
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R16-P18 LIBERO Stage-1 payload binding drifted: {fragment}")

    checkpoint_run_dir = R16P18_LIBERO_STAGE1_CHECKPOINT_BASE / resolved["run_id"]
    expected_evidence = {
        "kind": R16P18_LIBERO_STAGE1_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_rollout_evaluation",
        "task_id": "r16p18-libero-stage1-boundarybc-baseline-20260812",
        "model_id": "boundarybc-s-resnet18-h8-e4-three-seeds",
        "success_gate": "persisted_step_loss_completed_rollout_and_baseline_gate",
        "validation_method": "static+dev14_one_gpu_batch_one_smoke",
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            checkpoint_run_dir
            / "models/push_plate/seed_16018/FIRST_WORK.json"
        ),
        "evaluation_first_work_evidence_path": str(
            artifact_dir
            / "evaluation/push_plate/seed_16018.first_rollout.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "reports/baseline_gate.json"
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R16P18_LIBERO_STAGE1_SOURCE_COMMIT,
        "source_tree": R16P18_LIBERO_STAGE1_SOURCE_TREE,
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "config_sha256": "d4344c056e1c7682cec9deabd0c82888bd6ec29d6d473b9a1870a262aeaa64bf",
        "project_launcher_sha256": "506f6a98490c3eca7dad8096a550c46e694629192a1deb7a03c8c102e116574f",
        "registry_launcher_sha256": launcher_sha,
        "dev14_smoke_result_sha256": "8a5cb0c1c3f5b68f45f34c7e75227086d61e34bd709a54003875b2c2a6658fb2",
        "formal_python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "formal_torch": "2.5.1+cu124",
        "formal_cuda": "12.4",
        "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
        "overlay_file_count": 1688,
        "demo_sha256": {
            "push_plate": "36b4e1bced49d2f4ff6b2fce6b1596a63978e14199e2513cd0df71e127bf47a6",
            "bottle_rack": "f9092aa70734fc4083e97fc58c3ba25f87c614d18326182ddc7a455f0ab4da2e",
            "bowl_plate": "e69528b0cf10dfc59b20698e12ec2affc03f3887309034d3eb74cac3ec929406",
        },
        "requested_demos_per_task": 200,
        "available_official_demos_per_task": 50,
        "data_protocol_deviation": True,
        "split_by_stable_init_state_identity": [40, 5, 5],
        "tasks": [
            "push_the_plate_to_the_front_of_the_stove",
            "put_the_wine_bottle_on_the_rack",
            "put_the_bowl_on_the_plate",
        ],
        "model_seeds": [16018, 16019, 16020],
        "optimizer_steps_per_model": 3000,
        "batch_size_per_model": 64,
        "checkpoint_cadence_steps": 250,
        "checkpoint_retention": "latest_3_complete_per_task_seed",
        "checkpoint_contract": "model_optimizer_scheduler_rng_batch_generator_global_step",
        "full_state_resume": True,
        "gpu_execution": "two_independent_single_gpu_model_queues",
        "closed_loop_episodes_per_task_seed": 50,
        "total_models": 9,
        "total_closed_loop_episodes": 450,
        "baseline_ranges": {
            "push_plate": [0.40, 0.90],
            "bottle_rack": [0.25, 0.80],
            "bowl_plate": [0.80, 1.00],
        },
        "adaptive_components_implemented_before_gate": False,
        "pilot_can_return_stage1_go": False,
        "stop_after_baseline_failure": True,
        "stop_after_stage1": True,
        "superseded_terminal_jobs": [
            {
                "run_id": "r16-p18-libero-stage1-bc-gate-20260812-002",
                "job_id": "dlc1eloj62mdzw2y",
                "expected_status": "Failed",
                "expected_purpose": "formal-training",
            }
        ],
        "wandb_mode": "online_exact_entity_grouped_by_pai_run",
        "experiment_scope": "necessary_condition_baseline_gate_then_conditional_stage1_only",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R16-P18 LIBERO Stage-1 exact evidence contract drifted")
    if write_paths != [str(artifact_dir), str(checkpoint_run_dir)]:
        raise Refused("R16-P18 LIBERO Stage-1 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P18 LIBERO Stage-1 requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P18 LIBERO Stage-1 forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P18 LIBERO Stage-1 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training",
        "task": "r16p18-libero-stage1-boundarybc-baseline-20260812",
        "model": "boundarybc-s-resnet18-h8-e4-three-seeds",
        "dataset": "libero-goal-three-task-50-demo-pilot",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage1-necessary-condition-baseline-gate",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P18 LIBERO Stage-1 submission contract drifted")


def validate_resolved(resolved: Dict[str, Any]) -> None:
    assert_no_legacy_or_placeholder(resolved)
    ensure_run_id(str(resolved.get("run_id", "")))
    controller_version = str(resolved.get("controller_version", ""))
    if controller_version not in SUPPORTED_CONTROLLER_VERSIONS:
        raise Refused(
            "resolved manifest controller version is unsupported; "
            f"expected one of {sorted(SUPPORTED_CONTROLLER_VERSIONS)}"
        )
    if resolved.get("workspace_id") != "179169":
        raise Refused("workspace_id must be 179169")
    provenance = validate_provenance(resolved.get("provenance"))

    current_resources = resource_map()
    alias = resolved.get("resource_alias")
    if alias not in current_resources:
        raise Refused(f"resource alias disappeared: {alias}")
    for field in (
        "resource_id",
        "oversold_type",
        "display_name",
        "contract_data_sources_mode",
        "source_worker_contracts",
    ):
        if resolved["resource"].get(field) != current_resources[alias].get(field):
            raise Refused(f"resource mapping drift for {alias}.{field}; re-clone manifest")

    tc = load_json(TOOLCHAIN_PATH)
    current_resource = current_resources[alias]
    expected_contract_source = current_resource.get(
        "contract_source_job_id", tc.get("contract_source_job_id")
    )
    if provenance["contract_source_job_id"] != expected_contract_source:
        raise Refused("resolved contract source drifted from resource/toolchain")
    expected_resource_source = current_resources[alias].get("source_job_id")
    if expected_resource_source and provenance.get(
        "resource_source_job_id"
    ) != expected_resource_source:
        raise Refused("resolved resource source drifted from resource registry")
    current_source_contract = validate_resource_source_contract(current_resource)
    validate_resource_fault_tolerance_policy(resolved)
    validate_disable_ecs_stock_check(resolved)
    if (
        "source_contract" in resolved["resource"]
        and resolved["resource"].get("source_contract") != current_source_contract
    ):
        raise Refused("resolved resource source_contract drifted from registry")
    storage = resolved.get("storage")
    if not isinstance(storage, dict):
        raise Refused("resolved storage contract is missing")
    validate_data_sources(storage.get("data_sources"), tc, current_resource)
    output_root = canonical_write_path(str(storage.get("output_root", "")))
    artifact_dir = canonical_write_path(str(resolved.get("artifact_dir", "")))
    expected_artifact_dir = output_root / str(resolved["run_id"])
    if artifact_dir != expected_artifact_dir:
        raise Refused(
            f"artifact_dir must equal output_root/run_id: "
            f"{artifact_dir} != {expected_artifact_dir}"
        )

    runtime = resolved.get("runtime")
    if not isinstance(runtime, dict):
        raise Refused("resolved runtime is missing")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("resolved identity mechanism is not the controller bootstrap")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("resolved runtime identity must be 2254:2254")
    pod_env = normalize_pod_env(runtime.get("pod_env"))
    expected_pod_env = expected_runtime_pod_env(resolved, current_resource)
    if pod_env != expected_pod_env:
        raise Refused("runtime.pod_env differs from the resource registry contract")
    validate_secret_env_contract(
        runtime.get("secret_env_names"),
        pod_env,
    )
    validate_wandb_entity_contract(
        runtime.get("wandb_entity_contract"),
        normalize_secret_env_names(runtime.get("secret_env_names")),
    )
    nonce = str(runtime.get("canary_nonce", ""))
    if not re.fullmatch(r"[a-f0-9]{32}", nonce):
        raise Refused("resolved nonce is missing or invalid")
    try:
        payload = base64.b64decode(str(runtime.get("payload_base64", "")), validate=True)
    except (ValueError, TypeError) as exc:
        raise Refused(f"resolved payload_base64 is invalid: {exc}") from exc
    if sha256_bytes(payload) != runtime.get("payload_sha256"):
        raise Refused("resolved payload content/hash mismatch")
    if runtime.get("command_file_sha256") != runtime.get("payload_sha256"):
        raise Refused("command-file and frozen payload hashes differ")
    write_paths_raw = runtime.get("write_paths")
    if not isinstance(write_paths_raw, list) or not write_paths_raw:
        raise Refused("resolved write_paths must be a non-empty list")
    write_paths = [str(canonical_write_path(str(path))) for path in write_paths_raw]
    if write_paths[0] != str(artifact_dir):
        raise Refused("artifact_dir must be the first declared write path")
    output_mode = runtime.get("output_mode")
    if output_mode not in {"new", "resume"}:
        raise Refused("resolved output_mode must be new or resume")
    recursive_repair = runtime.get(
        "recursive_repair", output_mode == "resume"
    )
    if type(recursive_repair) is not bool:
        raise Refused("resolved runtime.recursive_repair must be boolean")
    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict):
        raise Refused("resolved task-specific evidence is missing")
    root_symlinks = normalize_root_symlinks(runtime.get("root_symlinks"))
    if root_symlinks != root_symlinks_for_evidence(evidence):
        raise Refused("resolved runtime.root_symlinks differs from evidence")
    payload_transport = payload_transport_for_manifest(
        runtime=runtime,
        evidence=evidence,
        controller_version=controller_version,
    )
    sentinel = tc.get("mount_sentinel")
    new_cpfs = tc.get("new_cpfs")
    if not isinstance(sentinel, dict) or not isinstance(new_cpfs, dict):
        raise Refused("toolchain is missing mount_sentinel or new_cpfs")
    rebuilt_command = build_inline_bootstrap(
        run_id=str(resolved["run_id"]),
        nonce=nonce,
        payload=payload,
        write_paths=write_paths,
        output_mode=str(output_mode),
        recursive_repair=recursive_repair,
        expected_gpus=int(resolved["worker"]["gpu"]),
        sentinel_path=str(sentinel["path"]),
        sentinel_sha256=str(sentinel["sha256"]),
        cpfs_id=str(new_cpfs["id"]),
        root_symlinks=root_symlinks,
        workload_env=formal_wrc_workload_env(
            dict(resolved.get("evidence", {}))
        ),
        payload_transport=payload_transport,
    )
    if controller_version == CONTROLLER_VERSION:
        require_safe_user_command_size(rebuilt_command)
    if runtime.get("command") != rebuilt_command:
        raise Refused(
            "resolved UserCommand does not byte-match the deterministic "
            "inline bootstrap; regenerate the run"
        )

    worker = resolved.get("worker")
    if not isinstance(worker, dict):
        raise Refused("worker contract is missing")
    if int(worker.get("count", 0)) < 1 or int(worker.get("gpu", 0)) < 1:
        raise Refused("worker count and GPU count must be positive")
    split_source_workers = current_resource.get("source_worker_contracts")
    if split_source_workers is not None:
        if not isinstance(split_source_workers, dict) or set(
            split_source_workers
        ) != {"contract", "resource"}:
            raise Refused(
                "resource source_worker_contracts must contain exact "
                "contract and resource roles"
            )
        target_worker = split_source_workers.get("resource")
        required_worker_fields = {
            "count",
            "image",
            "cpu",
            "gpu",
            "memory",
            "shared_memory",
        }
        if not isinstance(target_worker, dict) or set(
            target_worker
        ) != required_worker_fields:
            raise Refused(
                "resource source worker contract must contain exact worker fields"
            )
        for field, expected in target_worker.items():
            if worker.get(field) != expected:
                raise Refused(
                    f"target worker must equal the verified resource-source "
                    f"preset: worker.{field}={expected}"
                )
    resource_id = str(resolved["resource"].get("resource_id", ""))
    if not re.fullmatch(r"quota[a-z0-9]+", resource_id):
        raise Refused(f"invalid resource_id: {resource_id}")

    if alias in {
        "idle-a800",
        "idle-a800-stablevla-8gpu",
        STABLEVLA_NATIVE5_IDLE_ALIAS,
        "idle-a800-wrc-4gpu",
    }:
        if alias == "idle-a800-wrc-4gpu":
            expected = {
                "count": 1,
                "gpu": 4,
                "cpu": 46,
                "memory": "800Gi",
                "shared_memory": "800Gi",
            }
        else:
            expected = {
                "count": 1,
                "gpu": 8,
                "cpu": 92,
                "memory": "1600Gi",
                "shared_memory": "1600Gi",
            }
        for key, value in expected.items():
            if worker.get(key) != value:
                raise Refused(
                    f"idle {expected['gpu']}-card contract requires "
                    f"worker.{key}={value}"
                )
        if resolved["resource"].get("oversold_type") != "AcceptQuotaOverSold":
            raise Refused("idle contract requires AcceptQuotaOverSold")
        if resolved.get("network") != {}:
            raise Refused("idle A800 network must be empty and source-derived")
        if worker.get("driver") not in {None, ""}:
            raise Refused("idle A800 driver must be empty and source-derived")
        evidence = resolved.get("evidence", {})
        if not isinstance(evidence, dict):
            raise Refused("idle A800 evidence contract is missing")
        if alias in {
            "idle-a800-stablevla-8gpu",
            STABLEVLA_NATIVE5_IDLE_ALIAS,
        }:
            if (
                evidence.get("idle_8gpu_contract")
                == GENERIC_FORMAL_IDLE_8GPU_CONTRACT
            ):
                validate_generic_formal_idle_8gpu_profile(
                    resolved=resolved,
                    runtime=runtime,
                    write_paths=write_paths,
                    artifact_dir=artifact_dir,
                    output_mode=output_mode,
                )
                return
            validate_stablevla_target_ib_idle_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
            )
            return
        if alias == "idle-a800-wrc-4gpu" and evidence.get(
            "kind"
        ) != WRC_FORMAL_EVIDENCE_KIND:
            raise Refused(
                "idle-a800-wrc-4gpu is restricted to formal WRC training"
            )
        if evidence.get("kind") == FASTWAM_SIMPLE_FSDP8_EVIDENCE_KIND:
            validate_fastwam_simple_fsdp8_formal_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == WRC_FORMAL_EVIDENCE_KIND:
            validate_wrc_task_success_q_formal_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == VLAJEPA_TRASHCAN_EVIDENCE_KIND:
            validate_vlajepa_trashcan_vjepa20_formal_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if (
            evidence.get("idle_8gpu_contract")
            == GENERIC_FORMAL_IDLE_8GPU_CONTRACT
        ):
            validate_generic_formal_idle_8gpu_profile(
                resolved=resolved,
                runtime=runtime,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
            )
            return
        if evidence.get("kind") != "autofault_owner_canary":
            raise Refused(
                "idle A800 profile only permits qualification canary or "
                "a specialized or generic formal workload evidence contract"
            )
        if output_mode != "new":
            raise Refused("idle canary output_mode must be new")
        if write_paths != [str(artifact_dir)]:
            raise Refused("idle canary write_paths must equal [artifact_dir]")
        launcher_info = tc.get("canary_launcher")
        if not isinstance(launcher_info, dict):
            raise Refused("toolchain has no pinned canary launcher")
        expected_launcher_path = ROOT / str(launcher_info.get("file", ""))
        if runtime.get("command_file") != str(expected_launcher_path):
            raise Refused("idle canary command_file is not the pinned launcher")
        if runtime.get("payload_sha256") != launcher_info.get("sha256"):
            raise Refused("idle canary payload hash is not the pinned launcher hash")
        fault = resolved.get("fault_tolerance", {})
        if not isinstance(fault, dict):
            raise Refused("fault_tolerance contract is missing")
        validate_aimaster_exact(str(fault.get("aimaster_args", "")))
        if fault.get("expected_platform_restarts") != 1:
            raise Refused("canary must expect exactly one platform restart")
        if evidence.get("require_platform_restart_count") != 1:
            raise Refused("canary evidence must require exactly one platform restart")
        if evidence.get("require_actual_idle") is not True:
            raise Refused("idle canary must require actual idle placement")
        if evidence.get("require_dev14_unlink") is not True:
            raise Refused("idle canary must require the dev14 Leon unlink proof")
        if evidence.get("require_distinct_pod_uids") != 2:
            raise Refused("canary evidence must require two distinct pod UIDs")
        if evidence.get("require_uid") != 2254 or evidence.get("require_gid") != 2254:
            raise Refused("canary evidence must require numeric Leon 2254:2254")
        if evidence.get("require_terminal_status") != "Succeeded":
            raise Refused("canary evidence must require terminal Succeeded")
        submission = resolved.get("submission")
        if not isinstance(submission, dict):
            raise Refused("idle canary submission contract is missing")
        if submission.get("job_reserved_policy") not in {"", None}:
            raise Refused(
                "qualification canary must not reserve a completed workload"
            )
        if submission.get("job_reserved_minutes") != 0:
            raise Refused(
                "qualification canary job_reserved_minutes must be 0"
            )
        if not provenance.get("resource_source_job_id"):
            raise Refused("idle canary requires a resource_source_job_id")
    elif alias in {
        WALLX_WHERE_REAL_NPZ_E2E_RESOURCE_ALIAS,
        WALLX_WHERE_REAL_NPZ_E2E_IDLE_RESOURCE_ALIAS,
    }:
        if resolved.get("evidence", {}).get("kind") != (
            WALLX_WHERE_REAL_NPZ_E2E_EVIDENCE_KIND
        ):
            raise Refused(
                "the Wall-X E2E carrier aliases are restricted to their pinned "
                "real-NPZ regression profile"
            )
        validate_wallx_where_real_npz_e2e_profile(
            resolved=resolved,
            toolchain_config=tc,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    elif alias == R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        validate_r22p10_libero_phase1_profile(
            resolved=resolved,
            toolchain_config=tc,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    elif alias == R16P18_LIBERO_STAGE1_RESOURCE_ALIAS:
        validate_r16p18_libero_stage1_profile(
            resolved=resolved,
            toolchain_config=tc,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    elif alias == "exp-efficiency-a800-2gpu":
        evidence_kind = resolved.get("evidence", {}).get("kind")
        if evidence_kind not in {
            DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND,
            DINO_WM_WALL_SINGLE_OFFICIAL_EVAL_EVIDENCE_KIND,
        }:
            raise Refused(
                "the verified 2-GPU exp-efficiency alias is restricted to "
                "the pinned DINO-WM official evaluation profiles"
            )
        validator = (
            validate_dinowm_pusht_official_eval_profile
            if evidence_kind == DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND
            else validate_dinowm_wall_single_official_eval_profile
        )
        validator(
            resolved=resolved,
            toolchain_config=tc,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    elif alias == "rtx4090-general-1gpu":
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{2,63}", str(resolved["run_id"])):
            raise Refused(
                "Panel-A registry run_id must use lowercase letters, digits and hyphens"
            )
        expected = {
            "count": 1,
            "gpu": 1,
            "cpu": 14,
            "memory": "120Gi",
            "shared_memory": "120Gi",
        }
        for key, value in expected.items():
            if worker.get(key) != value:
                raise Refused(
                    f"RTX4090 1-gpu contract requires worker.{key}={value}"
                )
        expected_resource = {
            "display_name": "通用计算-rtx4090",
            "resource_source": "resource_quota",
            "resource_type": "general_compute",
            "task_template": "1-gpu",
            "oversold_type": "ForbiddenQuotaOverSold",
        }
        for key, value in expected_resource.items():
            if resolved["resource"].get(key) != value:
                raise Refused(f"RTX4090 resource contract requires {key}={value}")
        if resolved.get("network") != {}:
            raise Refused("RTX4090 source-derived network must be empty")
        if worker.get("driver") not in {None, ""}:
            raise Refused("RTX4090 source-derived driver must be empty")
        if pod_env != {
            "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"
        }:
            raise Refused(
                "RTX4090 pilot requires Pod-before "
                "NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics"
            )
        if output_mode != "resume":
            raise Refused("Panel-A pilot must use registry output_mode=resume")
        if recursive_repair is not False:
            raise Refused("Panel-A pilot forbids recursive ownership repair")
        if runtime.get("create_artifact_dir") is not True:
            raise Refused(
                "Panel-A pilot requires one fresh registry artifact directory"
            )
        evidence = resolved.get("evidence", {})
        if not isinstance(evidence, dict):
            raise Refused("Panel-A pilot evidence contract is missing")
        if evidence.get("kind") == FASTWAM_G1_LEVEL012_1GPU4090_EVIDENCE_KIND:
            validate_fastwam_g1_level012_1gpu4090_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == VLAJEPA_TRASHCAN_VJEPA20_EVAL_EVIDENCE_KIND:
            validate_vlajepa_trashcan_vjepa20_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == VLAJEPA_OPENFAUCET_VJEPA21_EVAL_EVIDENCE_KIND:
            validate_vlajepa_openfaucet_vjepa21_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == VLAJEPA_OPENFAUCET_VJEPA20_EVAL_EVIDENCE_KIND:
            validate_vlajepa_openfaucet_vjepa20_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") == VLAJEPA_LEGACY_PICK_BETWEEN_TABLES_EVAL_EVIDENCE_KIND:
            validate_vlajepa_legacy_pick_between_tables_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") in VLAJEPA_SIMPLE4_VJEPA20_EVAL_EVIDENCE_KINDS:
            validate_vlajepa_simple4_vjepa20_eval_profile(
                resolved=resolved,
                toolchain_config=tc,
                runtime=runtime,
                payload=payload,
                write_paths=write_paths,
                artifact_dir=artifact_dir,
                output_mode=output_mode,
                recursive_repair=recursive_repair,
                provenance=provenance,
            )
            return
        if evidence.get("kind") != "qpilots_panel_a_level1_pilot_probe":
            raise Refused("RTX4090 template is restricted to the Panel-A probe")
        if evidence.get("cell_ordinal") != 0:
            raise Refused("Panel-A probe cell ordinal must equal zero")
        if evidence.get("expected_first_work_uid") != 2254 or evidence.get(
            "expected_first_work_gid"
        ) != 2254:
            raise Refused("Panel-A first-real-work owner must be 2254:2254")
        if evidence.get("arms") != ["base", "bon_k5", "bon_k8", "u_a005"]:
            raise Refused("Panel-A pilot arm order drifted")
        if (
            evidence.get("episodes_per_arm") != 10
            or evidence.get("total_episodes") != 40
            or evidence.get("resume") != "auto"
        ):
            raise Refused("Panel-A pilot episode/resume contract drifted")
        expected_eval_root = str(
            USER_ROOT
            / "logs"
            / "qpilots"
            / "simple_pi05_eval"
            / str(evidence.get("eval_id", ""))
        )
        expected_bank_root = str(
            DATA_ROOT
            / "qpilots"
            / "candidate_banks"
            / str(evidence.get("eval_id", ""))
        )
        if str(artifact_dir) != str(
            Path(expected_eval_root) / str(resolved["run_id"])
        ):
            raise Refused(
                "Panel-A registry artifact must stay inside the exact eval root"
            )
        if write_paths != [str(artifact_dir), expected_eval_root, expected_bank_root]:
            raise Refused(
                "Panel-A pilot write_paths must be the registry artifact, "
                "exact eval root, and exact candidate-bank root"
            )
        launcher_info = tc.get("qpilots_panel_a_ordinal0_launcher")
        if not isinstance(launcher_info, dict):
            raise Refused("toolchain has no pinned Panel-A ordinal0 launcher")
        expected_launcher_path = ROOT / str(launcher_info.get("file", ""))
        if runtime.get("command_file") != str(expected_launcher_path):
            raise Refused("Panel-A command_file is not the pinned launcher")
        if runtime.get("payload_sha256") != launcher_info.get("sha256"):
            raise Refused("Panel-A payload hash is not the pinned launcher hash")
        fault = resolved.get("fault_tolerance", {})
        if not isinstance(fault, dict):
            raise Refused("Panel-A fault-tolerance contract is missing")
        if (
            fault.get("aimaster_args") != ""
            or fault.get("expected_platform_restarts") != 0
            or fault.get("launcher_attempts") != 1
            or fault.get("pai_automatic_fault_tolerance") is not False
        ):
            raise Refused(
                "Panel-A probe requires AIMaster off, zero platform restarts, "
                "one launcher attempt, and PAI automatic fault tolerance off"
            )
        submission = resolved.get("submission")
        if not isinstance(submission, dict):
            raise Refused("Panel-A submission contract is missing")
        if submission.get("job_reserved_policy") not in {"", None}:
            raise Refused("Panel-A probe must not reserve a completed workload")
        if submission.get("job_reserved_minutes") != 0:
            raise Refused("Panel-A probe job_reserved_minutes must be zero")
        if normalize_reserved_minutes(
            submission.get("job_max_running_time_minutes")
        ) != 0:
            raise Refused(
                "Panel-A probe job_max_running_time_minutes must be zero"
            )
        expected_source = resolved["resource"].get("contract_source_job_id")
        if provenance.get("contract_source_job_id") != expected_source or provenance.get(
            "resource_source_job_id"
        ) != resolved["resource"].get("source_job_id"):
            raise Refused("Panel-A live source bindings drifted")
    elif (
        isinstance(resolved.get("evidence"), dict)
        and resolved["evidence"].get("kind")
        == FASTWAM_SIMPLE_FSDP8_EVIDENCE_KIND
    ):
        validate_fastwam_simple_fsdp8_formal_profile(
            resolved=resolved,
            toolchain_config=tc,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
            recursive_repair=recursive_repair,
            provenance=provenance,
        )
        return
    elif resolved["resource"].get("oversold_type") != "ForbiddenQuotaOverSold":
        raise Refused("dedicated resources must forbid oversold placement")


def format_data_sources(items: List[Dict[str, Any]]) -> str:
    normalized = [normalize_data_source(item) for item in items]
    return ",".join(
        f"{item['id']}:{item['version']}:{item['mount_path']}:{item['options']}"
        for item in normalized
    )


def resolved_submission_tags(resolved: Dict[str, Any]) -> Dict[str, str]:
    tags = {
        str(key): str(value)
        for key, value in dict(resolved["submission"].get("tags", {})).items()
    }
    tags.update(
        {
            "run_id": resolved["run_id"],
            "nonce": resolved["runtime"]["canary_nonce"],
            "contract_source_job_id": resolved["provenance"][
                "contract_source_job_id"
            ],
        }
    )
    return tags


def build_submit_argv(
    resolved: Dict[str, Any],
    dlc_path: Path,
    config_path: Path,
    secret_env: Optional[Dict[str, str]] = None,
) -> List[str]:
    resource = resolved["resource"]
    network = resolved["network"]
    storage = resolved["storage"]
    worker = resolved["worker"]
    runtime = resolved["runtime"]
    fault = resolved["fault_tolerance"]
    submission = resolved["submission"]
    argv = [
        str(dlc_path),
        "-c",
        str(config_path),
        "submit",
        "pytorchjob",
        f"--name={resolved['name']}",
        f"--command={runtime['command']}",
        f"--data_sources={format_data_sources(storage['data_sources'])}",
        f"--resource_id={resource['resource_id']}",
        f"--workspace_id={resolved['workspace_id']}",
        f"--priority={submission.get('priority', 9)}",
        f"--oversold_type={resource['oversold_type']}",
        f"--workers={worker['count']}",
        f"--worker_image={worker['image']}",
        f"--worker_cpu={worker['cpu']}",
        f"--worker_memory={worker['memory']}",
        f"--worker_gpu={worker['gpu']}",
    ]
    optional_network_flags = {
        "vpc_id": "--vpc_id",
        "switch_id": "--switch_id",
        "security_group_id": "--security_group_id",
        "default_route": "--default_route",
        "extended_cidrs": "--extended_cidrs",
    }
    for field, flag in optional_network_flags.items():
        if network.get(field):
            argv.append(f"{flag}={network[field]}")
    if worker.get("driver"):
        argv.append(f"--driver={worker['driver']}")
    if worker.get("shared_memory"):
        argv.append(f"--worker_shared_memory={worker['shared_memory']}")
    disable_ecs_stock_check = submission.get(
        "disable_ecs_stock_check", False
    )
    if type(disable_ecs_stock_check) is not bool:
        raise Refused("submission.disable_ecs_stock_check must be boolean")
    if disable_ecs_stock_check:
        argv.append("--disable_ecs_stock_check=true")
    submit_env = normalize_pod_env(runtime.get("pod_env"))
    for name, value in (secret_env or {}).items():
        if name in submit_env:
            raise Refused(f"secret environment overlaps public value: {name}")
        submit_env[name] = value
    expected_secret_names = normalize_secret_env_names(
        runtime.get("secret_env_names")
    )
    if sorted((secret_env or {}).keys()) != expected_secret_names:
        raise Refused("submit-time secret environment names differ from the manifest")
    if submit_env:
        argv.append(f"--envs={format_pod_env(submit_env)}")
    if fault.get("aimaster_args"):
        argv.append(f"--aimaster_args={fault['aimaster_args']}")
    if submission.get("job_max_running_time_minutes"):
        argv.append(
            f"--job_max_running_time_minutes="
            f"{submission['job_max_running_time_minutes']}"
        )
    if submission.get("job_reserved_policy"):
        argv.append(f"--job_reserved_policy={submission['job_reserved_policy']}")
    if submission.get("job_reserved_minutes") is not None:
        argv.append(f"--job_reserved_minutes={submission['job_reserved_minutes']}")
    tags = resolved_submission_tags(resolved)
    for key, value in tags.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", str(key)):
            raise Refused(f"invalid tag key: {key}")
        if "," in str(value) or "=" in str(value):
            raise Refused(f"invalid tag value for {key}")
    argv.append(
        "--tags=" + ",".join(f"{key}={value}" for key, value in sorted(tags.items()))
    )
    return argv


def submission_gate(target_dir: Path) -> None:
    state_path = target_dir / "submission-state.json"
    if state_path.exists():
        state = load_json(state_path).get("state", "unknown")
        raise Refused(
            f"run_id is permanently sealed by submission state '{state}'. "
            "Never retry this run_id; reconcile or clone to a new run_id."
        )
    if (target_dir / "result.json").exists():
        result = load_json(target_dir / "result.json")
        raise Refused(
            f"run_id already has result state "
            f"{result.get('submission_state') or result.get('job_id')}"
        )


def write_fsync_probe(directory: Path, nonce: str) -> None:
    probe = directory / f".pai-registry-fsync-probe-{nonce}"
    descriptor = -1
    try:
        descriptor = os.open(
            probe,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        body = b"WRC_TASK_Q_WRITE_PROBE\n"
        body += b"x" * (4096 - len(body))
        written = os.write(descriptor, body)
        if written != 4096:
            raise Refused(
                f"formal WRC write probe was short in {directory}: {written}/4096"
            )
        os.fsync(descriptor)
        observed = os.fstat(descriptor)
        if (
            not stat.S_ISREG(observed.st_mode)
            or observed.st_uid != 2254
            or observed.st_gid != 2254
            or stat.S_IMODE(observed.st_mode) != 0o600
        ):
            raise Refused(
                f"formal WRC write probe owner/mode mismatch in {directory}"
            )
    except OSError as exc:
        raise Refused(
            f"formal WRC exact-path write+fsync probe failed in {directory}: {exc}"
        ) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            probe.unlink(missing_ok=True)
            fsync_directory(directory)
        except OSError as exc:
            raise Refused(
                f"formal WRC write-probe cleanup failed in {directory}: {exc}"
            ) from exc


def prepare_write_paths(resolved: Dict[str, Any]) -> None:
    runtime = resolved["runtime"]
    output_mode = runtime["output_mode"]
    create_artifact_dir = runtime.get("create_artifact_dir", False)
    if type(create_artifact_dir) is not bool:
        raise Refused("runtime.create_artifact_dir must be boolean")
    if create_artifact_dir and output_mode != "resume":
        raise Refused("create_artifact_dir is only valid for resume workloads")
    paths = [
        canonical_write_path(str(path_text))
        for path_text in runtime["write_paths"]
    ]
    if output_mode == "resume" and create_artifact_dir:
        artifact_path = paths[0]
        if artifact_path.exists():
            raise Refused(
                "fresh registry artifact path already exists; "
                f"stale attempt markers are forbidden: {artifact_path}"
            )
        for path in paths[1:]:
            if not path.is_dir():
                raise Refused(f"resume write path does not exist: {path}")
            path_stat = path.stat()
            if path_stat.st_uid != 2254 or path_stat.st_gid != 2254:
                raise Refused(f"dev14 write path is not 2254:2254: {path}")
        if (
            resolved.get("evidence", {}).get("kind")
            == WRC_FORMAL_EVIDENCE_KIND
        ):
            nonce = str(runtime.get("canary_nonce", ""))
            for path in paths[1:]:
                write_fsync_probe(path, nonce)
        try:
            artifact_path.mkdir(mode=0o700)
        except OSError as exc:
            raise Refused(
                f"cannot create fresh registry artifact path: {artifact_path}: {exc}"
            ) from exc
        artifact_stat = artifact_path.stat()
        if artifact_stat.st_uid != 2254 or artifact_stat.st_gid != 2254:
            raise Refused(
                f"dev14 write path is not 2254:2254: {artifact_path}"
            )
        if any(artifact_path.iterdir()):
            raise Refused(f"fresh run write path is not empty: {artifact_path}")
        return

    for path in paths:
        if output_mode == "new":
            if path.exists():
                raise Refused(
                    f"new run write path already exists; stale markers are forbidden: {path}"
                )
            path.mkdir(parents=True, mode=0o700)
        elif not path.is_dir():
            raise Refused(f"resume write path does not exist: {path}")
        path_stat = path.stat()
        if path_stat.st_uid != 2254 or path_stat.st_gid != 2254:
            raise Refused(f"dev14 write path is not 2254:2254: {path}")
        if output_mode == "new" and any(path.iterdir()):
            raise Refused(f"fresh run write path is not empty: {path}")
    if (
        output_mode == "new"
        and resolved.get("evidence", {}).get("kind")
        == WRC_FORMAL_EVIDENCE_KIND
    ):
        nonce = str(runtime.get("canary_nonce", ""))
        for path in paths[1:]:
            write_fsync_probe(path, nonce)


def append_ledger_unlocked(entry: Dict[str, Any]) -> None:
    with open_private_append(LEDGER_PATH) as handle:
        handle.write(json.dumps(entry, ensure_ascii=False, sort_keys=True) + "\n")
        handle.flush()
        os.fsync(handle.fileno())


def parse_json_output(text: str) -> Dict[str, Any]:
    try:
        value = json.loads(text)
        if isinstance(value, dict):
            return value
    except json.JSONDecodeError:
        pass
    start = text.find("{")
    end = text.rfind("}")
    if start >= 0 and end > start:
        try:
            value = json.loads(text[start : end + 1])
        except json.JSONDecodeError as exc:
            raise Refused(f"DLC output contained malformed JSON: {exc}") from exc
        if isinstance(value, dict):
            return value
    raise Refused("DLC output was not machine-readable JSON")


def parse_submit_stdout(text: str) -> Dict[str, Any]:
    request_start = text.find("{")
    if request_start < 0:
        raise Refused("DLC submit stdout has no CreateJob request JSON")
    try:
        request, request_end = json.JSONDecoder().raw_decode(text, request_start)
    except json.JSONDecodeError as exc:
        raise Refused(f"DLC submit request JSON is malformed: {exc}") from exc
    if not isinstance(request, dict):
        raise Refused("DLC submit request JSON is not an object")

    prefix_lines = [
        line.strip()
        for line in text[:request_start].splitlines()
        if line.strip()
    ]
    if any(
        not line.startswith("[OK] Using config file")
        for line in prefix_lines
    ):
        raise Refused("DLC submit stdout has unexpected text before request JSON")

    suffix = text[request_end:]
    nonempty_lines = [
        line.strip() for line in suffix.splitlines() if line.strip()
    ]
    table_rows = [line for line in nonempty_lines if line.startswith("|")]
    borders = [line for line in nonempty_lines if line.startswith("+")]
    if len(table_rows) != 2 or len(borders) != 3:
        raise Refused("DLC submit stdout success table has an unexpected shape")
    if any(not re.fullmatch(r"\+[+-]+\+", line) for line in borders):
        raise Refused("DLC submit stdout contains an invalid table border")
    if len(table_rows) + len(borders) != len(nonempty_lines):
        raise Refused("DLC submit stdout has unexpected text after request JSON")

    def cells(line: str) -> List[str]:
        if not line.endswith("|"):
            raise Refused("DLC submit table row is not closed")
        return [part.strip() for part in line[1:-1].split("|")]

    if cells(table_rows[0]) != ["JobId", "RequestId"]:
        raise Refused("DLC submit table header is not exactly JobId/RequestId")
    data_cells = cells(table_rows[1])
    if len(data_cells) != 2:
        raise Refused("DLC submit table data row does not have two cells")
    job_id, request_id = data_cells
    if not JOB_ID_RE.fullmatch(job_id):
        raise Refused("DLC submit table JobId is missing or invalid")
    if not request_id or "|" in request_id or "\n" in request_id:
        raise Refused("DLC submit table RequestId is missing or invalid")
    suffix_job_ids = sorted(set(JOB_ID_RE.findall(suffix)))
    if suffix_job_ids != [job_id]:
        raise Refused("DLC submit suffix does not contain exactly its table JobId")
    return {
        "job_id": job_id,
        "request_id": request_id,
        "request": request,
        "request_sha256": sha256_bytes(
            json.dumps(request, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ),
        "request_job_ids": sorted(
            set(JOB_ID_RE.findall(text[request_start:request_end]))
        ),
    }


def find_job_objects(value: Any, job_id: str) -> List[Dict[str, Any]]:
    found: List[Dict[str, Any]] = []
    if isinstance(value, dict):
        if value.get("JobId") == job_id:
            found.append(value)
        for item in value.values():
            found.extend(find_job_objects(item, job_id))
    elif isinstance(value, list):
        for item in value:
            found.extend(find_job_objects(item, job_id))
    return found


def find_job_object(value: Any, job_id: str) -> Optional[Dict[str, Any]]:
    """Return the first exact JobId object for non-contract status displays only."""
    found = find_job_objects(value, job_id)
    return found[0] if found else None


def get_job(job_id: str, config_path: Path) -> Tuple[Dict[str, Any], str, str]:
    _, dlc_path = toolchain()
    try:
        completed = subprocess.run(
            [
                str(dlc_path),
                "-c",
                str(config_path),
                "get",
                "job",
                job_id,
                "--show_detail",
            ],
            text=True,
            capture_output=True,
            timeout=120,
            check=False,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        raise Refused(f"GetJob transport failure: {exc}") from exc
    if completed.returncode != 0:
        body = (completed.stdout + "\n" + completed.stderr).encode("utf-8")
        raise Refused(
            f"GetJob failed with exit {completed.returncode}; "
            f"response_sha256={sha256_bytes(body)}"
        )
    return parse_json_output(completed.stdout), completed.stdout, completed.stderr


def normalize_observed_data_sources(value: Any) -> List[Tuple[str, str, str, str]]:
    if not isinstance(value, list):
        return []
    observed: List[Tuple[str, str, str, str]] = []
    for item in value:
        if not isinstance(item, dict):
            continue
        try:
            observed.append(
                (
                    str(item.get("DataSourceId", "")),
                    str(item.get("DataSourceVersion", "")),
                    normalized_mount_path(item.get("MountPath")),
                    str(item.get("Options", "")),
                )
            )
        except Refused:
            continue
    return observed


def source_data_sources_match(
    *,
    resource_alias: str,
    resource: Dict[str, Any],
    expected: List[Tuple[str, str, str, str]],
    observed: List[Tuple[str, str, str, str]],
) -> bool:
    mode = str(
        resource.get("contract_data_sources_mode", SOURCE_DATA_SOURCES_EXACT)
    )
    if mode == SOURCE_DATA_SOURCES_EXACT:
        return observed == expected
    if mode != SOURCE_DATA_SOURCES_REQUESTED_SUBSET:
        raise Refused(f"unsupported contract_data_sources_mode: {mode}")
    if resource_alias not in STABLEVLA_SOURCE_SUBSET_ALIASES:
        raise Refused(
            "requested-subset source validation is restricted to StableVLA "
            "native five-mount aliases"
        )
    expected_set = set(expected)
    observed_set = set(observed)
    return (
        bool(expected_set)
        and len(expected_set) == len(expected)
        and expected_set.issubset(observed_set)
    )


def normalize_reserved_policy(value: Any) -> Optional[str]:
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    return None


def normalize_reserved_minutes(value: Any) -> Optional[int]:
    if value is None or value == "":
        return 0
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value if value >= 0 else None
    if isinstance(value, str) and re.fullmatch(r"0|[1-9][0-9]*", value):
        return int(value)
    return None


def normalize_optional_bool(value: Any) -> Optional[bool]:
    if value is None or value == "":
        return False
    if type(value) is bool:
        return value
    return None


def verify_submit_request(
    request: Dict[str, Any], resolved: Dict[str, Any]
) -> Dict[str, Any]:
    settings = request.get("Settings")
    if not isinstance(settings, dict):
        settings = {}
    specs = request.get("JobSpecs")
    if not isinstance(specs, list):
        specs = []
    worker_specs = [
        spec
        for spec in specs
        if isinstance(spec, dict) and spec.get("Type") == "Worker"
    ]
    worker_spec = worker_specs[0] if len(worker_specs) == 1 else {}
    resource_config = worker_spec.get("ResourceConfig")
    if not isinstance(resource_config, dict):
        resource_config = {}
    expected_data_sources = sorted(
        service_data_source_key(normalize_data_source(item))
        for item in resolved["storage"]["data_sources"]
    )
    observed_data_sources = sorted(
        (
            source_id,
            version,
            "/" if mount_path == "/" else mount_path.rstrip("/"),
            options,
        )
        for source_id, version, mount_path, options in normalize_observed_data_sources(
            request.get("DataSources")
        )
    )
    worker = resolved["worker"]
    submission = resolved["submission"]
    checks = {
        "display_name": request.get("DisplayName") == resolved["name"],
        "workspace_id": str(request.get("WorkspaceId"))
        == resolved["workspace_id"],
        "resource_id": request.get("ResourceId")
        == resolved["resource"]["resource_id"],
        "job_type": request.get("JobType") == "PyTorchJob",
        "priority": str(request.get("Priority"))
        == str(submission.get("priority", 9)),
        "user_command": request.get("UserCommand")
        == resolved["runtime"]["command"],
        "pod_env": observed_pod_env_matches(request.get("Envs"), resolved),
        "data_sources": observed_data_sources == expected_data_sources,
        "single_worker_spec": len(specs) == 1 and len(worker_specs) == 1,
        "worker_count": str(worker_spec.get("PodCount"))
        == str(worker["count"]),
        "worker_image": worker_spec.get("Image") == worker["image"],
        "worker_cpu": str(resource_config.get("CPU")) == str(worker["cpu"]),
        "worker_gpu": str(resource_config.get("GPU")) == str(worker["gpu"]),
        "worker_memory": resource_config.get("Memory") == worker["memory"],
        "worker_shared_memory": resource_config.get("SharedMemory")
        == worker.get("shared_memory"),
        "aimaster_enabled": normalize_optional_bool(
            settings.get("EnableErrorMonitoringInAIMaster")
        )
        is bool(resolved["fault_tolerance"].get("aimaster_args")),
        "aimaster_args": settings.get("ErrorMonitoringArgs", "")
        == resolved["fault_tolerance"].get("aimaster_args", ""),
        "oversold_type": settings.get("OversoldType")
        == resolved["resource"]["oversold_type"],
        "disable_ecs_stock_check": normalize_optional_bool(
            settings.get("DisableEcsStockCheck")
        )
        is submission.get("disable_ecs_stock_check", False),
        "tags": settings.get("Tags") == resolved_submission_tags(resolved),
        "job_reserved_policy": normalize_reserved_policy(
            settings.get("JobReservedPolicy")
        )
        == normalize_reserved_policy(submission.get("job_reserved_policy", "")),
        "job_reserved_minutes": normalize_reserved_minutes(
            settings.get("JobReservedMinutes")
        )
        == normalize_reserved_minutes(submission.get("job_reserved_minutes")),
        "job_max_running_time_minutes": normalize_reserved_minutes(
            request.get("JobMaxRunningTimeMinutes")
        )
        == normalize_reserved_minutes(
            submission.get("job_max_running_time_minutes")
        ),
        "empty_network": not bool(request.get("UserVpc"))
        and resolved.get("network") == {},
        "empty_driver": (settings.get("Driver") or "") == ""
        and not worker.get("driver"),
    }
    return {
        "checks": checks,
        "complete": all(checks.values()),
        "observed": {
            "display_name": request.get("DisplayName"),
            "workspace_id": request.get("WorkspaceId"),
            "resource_id": request.get("ResourceId"),
            "priority": request.get("Priority"),
            "pod_env": redacted_observed_pod_env(
                request.get("Envs"), resolved
            ),
            "worker_spec": worker_spec,
            "data_sources": observed_data_sources,
            "settings": {
                "aimaster_enabled": settings.get(
                    "EnableErrorMonitoringInAIMaster"
                ),
                "aimaster_args": settings.get("ErrorMonitoringArgs"),
                "oversold_type": settings.get("OversoldType"),
                "disable_ecs_stock_check": settings.get(
                    "DisableEcsStockCheck"
                ),
                "tags": settings.get("Tags"),
                "job_reserved_policy": settings.get("JobReservedPolicy"),
                "job_reserved_minutes": settings.get("JobReservedMinutes"),
                "driver": settings.get("Driver", ""),
            },
            "job_max_running_time_minutes": request.get(
                "JobMaxRunningTimeMinutes"
            ),
            "user_command_sha256": sha256_bytes(
                str(request.get("UserCommand") or "").encode("utf-8")
            ),
        },
    }


def normalize_extended_cidrs(value: Any) -> List[str]:
    if isinstance(value, str):
        return sorted(part for part in value.split(",") if part)
    if isinstance(value, list):
        return sorted(str(part) for part in value)
    return []


def verify_getjob_contract(
    response: Dict[str, Any], job_id: str, resolved: Dict[str, Any]
) -> Dict[str, Any]:
    matching_jobs = find_job_objects(response, job_id)
    if len(matching_jobs) != 1:
        return {
            "checks": {"exact_job_object": False},
            "complete": False,
            "observed": {
                "error": (
                    f"expected exactly one object for JobId {job_id}; "
                    f"observed {len(matching_jobs)}"
                ),
                "matching_job_object_count": len(matching_jobs),
            },
        }
    job = matching_jobs[0]
    settings = job.get("Settings")
    if not isinstance(settings, dict):
        settings = {}
    specs = job.get("JobSpecs")
    if not isinstance(specs, list):
        specs = []
    worker_specs = [
        spec
        for spec in specs
        if isinstance(spec, dict) and spec.get("Type") == "Worker"
    ]
    worker_spec: Dict[str, Any] = worker_specs[0] if len(worker_specs) == 1 else {}
    resource_config = worker_spec.get("ResourceConfig")
    if not isinstance(resource_config, dict):
        resource_config = {}
    user_vpc = job.get("UserVpc")
    if not isinstance(user_vpc, dict):
        user_vpc = {}
    expected_network = resolved["network"]
    expected_fault = str(resolved["fault_tolerance"].get("aimaster_args", ""))
    observed_tags = settings.get("Tags")
    if not isinstance(observed_tags, dict):
        observed_tags = {}
    expected_tags = resolved_submission_tags(resolved)
    expected_data_sources = sorted(
        service_data_source_key(normalize_data_source(item))
        for item in resolved["storage"]["data_sources"]
    )
    observed_data_sources = sorted(
        (
            source_id,
            version,
            "/" if mount_path == "/" else mount_path.rstrip("/"),
            options,
        )
        for source_id, version, mount_path, options in normalize_observed_data_sources(
            job.get("DataSources")
        )
    )
    observed_driver = settings.get("Driver") or worker_spec.get("Driver") or ""
    expected_driver = resolved["worker"].get("driver") or ""

    checks = {
        "exact_job_object": True,
        "job_id": job.get("JobId") == job_id,
        "display_name": job.get("DisplayName") == resolved["name"],
        "workspace_id": str(job.get("WorkspaceId")) == resolved["workspace_id"],
        "resource_id": job.get("ResourceId") == resolved["resource"]["resource_id"],
        "oversold_type": settings.get("OversoldType")
        == resolved["resource"]["oversold_type"],
        "disable_ecs_stock_check": normalize_optional_bool(
            settings.get("DisableEcsStockCheck")
        )
        is resolved["submission"].get("disable_ecs_stock_check", False),
        "aimaster_enabled": settings.get("EnableErrorMonitoringInAIMaster")
        is bool(expected_fault),
        "aimaster_args": settings.get("ErrorMonitoringArgs", "") == expected_fault,
        "user_command": job.get("UserCommand") == resolved["runtime"]["command"],
        "pod_env": observed_pod_env_matches(job.get("Envs"), resolved),
        "single_worker_spec": len(specs) == 1 and len(worker_specs) == 1,
        "worker_count": str(worker_spec.get("PodCount"))
        == str(resolved["worker"]["count"]),
        "worker_image": worker_spec.get("Image") == resolved["worker"]["image"],
        "worker_gpu": str(resource_config.get("GPU"))
        == str(resolved["worker"]["gpu"]),
        "worker_cpu": str(resource_config.get("CPU"))
        == str(resolved["worker"]["cpu"]),
        "worker_memory": resource_config.get("Memory")
        == resolved["worker"]["memory"],
        "worker_shared_memory": resource_config.get("SharedMemory")
        == resolved["worker"].get("shared_memory"),
        "driver": observed_driver == expected_driver,
        "priority": str(job.get("Priority"))
        == str(resolved["submission"].get("priority", 9)),
        "tags": all(
            observed_tags.get(key) == value
            for key, value in expected_tags.items()
        ),
        "job_reserved_policy": normalize_reserved_policy(
            settings.get("JobReservedPolicy")
        )
        == normalize_reserved_policy(
            resolved["submission"].get("job_reserved_policy", "")
        ),
        "job_reserved_minutes": normalize_reserved_minutes(
            settings.get("JobReservedMinutes")
        )
        == normalize_reserved_minutes(
            resolved["submission"].get("job_reserved_minutes")
        ),
        "data_sources": observed_data_sources == expected_data_sources,
        "empty_network": bool(expected_network) or not bool(user_vpc),
        "vpc_id": (
            not expected_network.get("vpc_id")
            or user_vpc.get("VpcId") == expected_network["vpc_id"]
        ),
        "switch_id": (
            not expected_network.get("switch_id")
            or user_vpc.get("SwitchId") == expected_network["switch_id"]
        ),
        "security_group_id": (
            not expected_network.get("security_group_id")
            or user_vpc.get("SecurityGroupId")
            == expected_network["security_group_id"]
        ),
        "extended_cidrs": (
            not expected_network.get("extended_cidrs")
            or normalize_extended_cidrs(
                user_vpc.get("ExtendedCIDRs")
                if "ExtendedCIDRs" in user_vpc
                else user_vpc.get("ExtendedCidrs")
            )
            == normalize_extended_cidrs(expected_network["extended_cidrs"])
        ),
    }
    return {
        "checks": checks,
        "complete": all(checks.values()),
        "observed": {
            "display_name": job.get("DisplayName"),
            "workspace_id": job.get("WorkspaceId"),
            "resource_id": job.get("ResourceId"),
            "pod_env": redacted_observed_pod_env(job.get("Envs"), resolved),
            "settings": settings,
            "worker_spec": worker_spec,
            "user_vpc": user_vpc,
            "data_sources": observed_data_sources,
            "user_command_sha256": sha256_bytes(
                str(job.get("UserCommand") or "").encode("utf-8")
            ),
        },
    }


def reference_worker_snapshot(
    job: Dict[str, Any]
) -> Tuple[Dict[str, Any], int, int]:
    specs = job.get("JobSpecs")
    if not isinstance(specs, list):
        specs = []
    worker_specs = [
        spec
        for spec in specs
        if isinstance(spec, dict) and spec.get("Type") == "Worker"
    ]
    worker_spec = worker_specs[0] if len(worker_specs) == 1 else {}
    resource_config = worker_spec.get("ResourceConfig")
    if not isinstance(resource_config, dict):
        resource_config = {}
    return (
        {
            "pod_count": worker_spec.get("PodCount"),
            "image": worker_spec.get("Image"),
            "cpu": resource_config.get("CPU"),
            "gpu": resource_config.get("GPU"),
            "memory": resource_config.get("Memory"),
            "shared_memory": resource_config.get("SharedMemory"),
        },
        len(specs),
        len(worker_specs),
    )


def expected_worker_checks(
    snapshot: Dict[str, Any], resolved: Dict[str, Any]
) -> Dict[str, bool]:
    worker = resolved["worker"]
    return {
        "worker_count": str(snapshot.get("pod_count")) == str(worker["count"]),
        "worker_image": snapshot.get("image") == worker["image"],
        "worker_cpu": str(snapshot.get("cpu")) == str(worker["cpu"]),
        "worker_gpu": str(snapshot.get("gpu")) == str(worker["gpu"]),
        "worker_memory": snapshot.get("memory") == worker["memory"],
        "worker_shared_memory": snapshot.get("shared_memory")
        == worker.get("shared_memory"),
    }


def expected_source_worker_checks(
    snapshot: Dict[str, Any], resolved: Dict[str, Any], role: str
) -> Dict[str, bool]:
    split_contracts = resolved.get("resource", {}).get(
        "source_worker_contracts"
    )
    if split_contracts is not None:
        if not isinstance(split_contracts, dict) or set(split_contracts) != {
            "contract",
            "resource",
        }:
            raise Refused(
                "resource source_worker_contracts must contain exact "
                "contract and resource roles"
            )
        if role not in split_contracts:
            raise Refused(f"source worker contract has no {role} role")
        expected = split_contracts[role]
        required = {
            "count",
            "image",
            "cpu",
            "gpu",
            "memory",
            "shared_memory",
        }
        if not isinstance(expected, dict) or set(expected) != required:
            raise Refused(
                f"source worker contract {role} must contain exact worker fields"
            )
        return {
            f"source_{role}_worker_count": str(snapshot.get("pod_count"))
            == str(expected["count"]),
            f"source_{role}_worker_image": snapshot.get("image")
            == expected["image"],
            f"source_{role}_worker_cpu": str(snapshot.get("cpu"))
            == str(expected["cpu"]),
            f"source_{role}_worker_gpu": str(snapshot.get("gpu"))
            == str(expected["gpu"]),
            f"source_{role}_worker_memory": snapshot.get("memory")
            == expected["memory"],
            f"source_{role}_worker_shared_memory": snapshot.get("shared_memory")
            == expected["shared_memory"],
        }
    if resolved.get("resource_alias") != "idle-a800-wrc-4gpu":
        return expected_worker_checks(snapshot, resolved)
    # The pinned source job is the successful full-node qualification job.
    # It supplies the exact image, mounts, resource quota, network, driver and
    # AIMaster policy. The target intentionally selects the quota's four-card
    # preset, so the source and target worker shapes must differ in this one
    # explicitly gated case.
    expected = {
        "pod_count": 1,
        "image": resolved["worker"]["image"],
        "cpu": "92",
        "gpu": "8",
        "memory": "1600Gi",
        "shared_memory": "1600Gi",
    }
    return {
        "source_worker_count": str(snapshot.get("pod_count"))
        == str(expected["pod_count"]),
        "source_worker_image": snapshot.get("image") == expected["image"],
        "source_worker_cpu": str(snapshot.get("cpu")) == expected["cpu"],
        "source_worker_gpu": str(snapshot.get("gpu")) == expected["gpu"],
        "source_worker_memory": snapshot.get("memory") == expected["memory"],
        "source_worker_shared_memory": snapshot.get("shared_memory")
        == expected["shared_memory"],
    }


def live_source_readback(
    resolved: Dict[str, Any], config_path: Path
) -> Tuple[Dict[str, Any], Dict[str, Dict[str, Any]]]:
    provenance = resolved["provenance"]
    source_roles = {
        "contract": str(provenance["contract_source_job_id"]),
    }
    if provenance.get("resource_source_job_id"):
        source_roles["resource"] = str(provenance["resource_source_job_id"])

    raw_responses: Dict[str, Dict[str, Any]] = {}
    role_evidence: Dict[str, Any] = {}
    expected_data_sources = sorted(
        data_source_key(normalize_data_source(item))
        for item in resolved["storage"]["data_sources"]
    )
    current_resource = resource_map().get(resolved["resource_alias"], {})
    for role, source_job_id in source_roles.items():
        response, stdout, stderr = get_job(source_job_id, config_path)
        raw_responses[role] = response
        matching_jobs = find_job_objects(response, source_job_id)
        if len(matching_jobs) != 1:
            role_evidence[role] = {
                "job_id": source_job_id,
                "checks": {"exact_job_object": False},
                "complete": False,
                "matching_job_object_count": len(matching_jobs),
                "stdout_sha256": sha256_bytes(stdout.encode("utf-8")),
                "stderr_sha256": sha256_bytes(stderr.encode("utf-8")),
            }
            continue
        job = matching_jobs[0]
        settings = job.get("Settings")
        if not isinstance(settings, dict):
            settings = {}
        worker_snapshot, job_spec_count, worker_spec_count = (
            reference_worker_snapshot(job)
        )
        checks = {
            "exact_job_object": True,
            "job_id": job.get("JobId") == source_job_id,
            "workspace_id": str(job.get("WorkspaceId"))
            == resolved["workspace_id"],
            "single_worker_spec": job_spec_count == 1 and worker_spec_count == 1,
            **expected_source_worker_checks(worker_snapshot, resolved, role),
        }
        if role == "contract":
            observed_data_sources = sorted(
                normalize_observed_data_sources(job.get("DataSources"))
            )
            checks.update(
                {
                    "data_sources": source_data_sources_match(
                        resource_alias=str(resolved["resource_alias"]),
                        resource=current_resource,
                        expected=expected_data_sources,
                        observed=observed_data_sources,
                    ),
                    "empty_driver": (settings.get("Driver") or "") == "",
                    "no_user_vpc": not bool(job.get("UserVpc")),
                }
            )
        elif role == "resource":
            source_contract = validate_resource_source_contract(current_resource)
            if source_contract is None:
                raise Refused("resource source role is missing a source_contract")
            checks.update(
                {
                    "succeeded_reference": job.get("Status")
                    == source_contract["require_status"],
                    "resource_id": job.get("ResourceId")
                    == resolved["resource"]["resource_id"],
                    "oversold_type": settings.get("OversoldType")
                    == resolved["resource"]["oversold_type"],
                    "aimaster_reference_enabled": settings.get(
                        "EnableErrorMonitoringInAIMaster"
                    )
                    is source_contract["aimaster_enabled"],
                    "aimaster_reference_args": settings.get(
                        "ErrorMonitoringArgs", ""
                    )
                    == source_contract["aimaster_args"],
                }
            )
        role_evidence[role] = {
            "job_id": source_job_id,
            "status": job.get("Status"),
            "resource_id": job.get("ResourceId"),
            "settings": {
                "oversold_type": settings.get("OversoldType"),
                "aimaster_enabled": settings.get(
                    "EnableErrorMonitoringInAIMaster"
                ),
                "aimaster_args": settings.get("ErrorMonitoringArgs", ""),
                "driver": settings.get("Driver", ""),
            },
            "worker": worker_snapshot,
            "job_spec_count": job_spec_count,
            "worker_spec_count": worker_spec_count,
            "data_sources": sorted(
                normalize_observed_data_sources(job.get("DataSources"))
            ),
            "checks": checks,
            "complete": all(checks.values()),
            "stdout_sha256": sha256_bytes(stdout.encode("utf-8")),
            "stderr_sha256": sha256_bytes(stderr.encode("utf-8")),
        }
    evidence = {
        "checked_at_utc": utc_now(),
        "roles": role_evidence,
        "complete": bool(role_evidence)
        and all(item.get("complete") is True for item in role_evidence.values()),
    }
    return evidence, raw_responses


def actual_idle_value(
    job_id: str, *responses: Optional[Dict[str, Any]]
) -> Optional[bool]:
    observed: List[bool] = []
    for response in responses:
        if response is None:
            continue
        job = find_job_object(response, job_id)
        if job is None:
            continue
        value = job.get("UseOversoldResource")
        if isinstance(value, bool):
            observed.append(value)
        elif isinstance(value, str) and value.lower() in {"true", "false"}:
            observed.append(value.lower() == "true")
    if not observed:
        return None
    if len(set(observed)) != 1:
        raise Refused(
            f"conflicting UseOversoldResource values for exact JobId {job_id}: "
            f"{observed}"
        )
    return observed[0]


def external_idle_source_spec(
    *,
    source_kind: Optional[str] = None,
    source_label: Optional[str] = None,
) -> Tuple[str, Dict[str, str]]:
    matches = []
    for kind, raw_spec in EXTERNAL_IDLE_SOURCE_SPECS.items():
        spec = {key: str(value) for key, value in raw_spec.items()}
        if source_kind is not None and kind != source_kind:
            continue
        if source_label is not None and spec["label"] != source_label:
            continue
        matches.append((kind, spec))
    if len(matches) != 1:
        raise Refused("external placement source kind is invalid")
    return matches[0]


def parse_external_idle_source(
    body: bytes,
    resolved: Dict[str, Any],
    job_id: str,
    *,
    expected_source_label: Optional[str] = None,
) -> Dict[str, Any]:
    try:
        envelope = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused(f"external placement source is not valid JSON: {exc}") from exc
    if not isinstance(envelope, dict):
        raise Refused("external placement source is not a JSON object")
    if envelope.get("schema_version") != 1:
        raise Refused("external placement source schema_version must be 1")
    source_label = str(envelope.get("source", ""))
    source_kind, source_spec = external_idle_source_spec(
        source_label=source_label
    )
    if (
        expected_source_label is not None
        and source_label != expected_source_label
    ):
        raise Refused("external placement source label does not match the command")
    observed_at_utc = require_utc_timestamp(
        envelope.get("observed_at_utc"), "external placement observed_at_utc"
    )
    response = envelope.get("response")
    if not isinstance(response, dict):
        raise Refused("external placement source has no raw response object")

    if source_kind == "openapi":
        tc = load_json(TOOLCHAIN_PATH)
        resource = resolved.get("resource")
        if not isinstance(resource, dict):
            raise Refused("resolved manifest has no resource object")
        expected_query = {
            "JobId": job_id,
            "Order": "desc",
            "PageNumber": "1",
            "PageSize": "10",
            "ResourceId": str(resource.get("resource_id", "")),
            "SortBy": "GmtCreateTime",
            "WorkspaceId": resolved["workspace_id"],
        }
        expected_request = {
            "action": OPENAPI_LISTJOBS_ACTION,
            "api_path": OPENAPI_LISTJOBS_PATH,
            "endpoint": str(tc.get("endpoint", "")),
            "http_method": "GET",
            "query": expected_query,
            "version": OPENAPI_LISTJOBS_VERSION,
        }
        if envelope.get("request") != expected_request:
            raise Refused(
                "OpenAPI placement source request metadata differs from the "
                "pinned exact-JobId ListJobs request"
            )
        jobs = response.get("Jobs")
        if (
            not isinstance(jobs, list)
            or len(jobs) != 1
            or not isinstance(jobs[0], dict)
        ):
            raise Refused(
                "OpenAPI ListJobs source must contain exactly one job object"
            )
        total_count = response.get("TotalCount")
        if isinstance(total_count, str) and total_count.isdigit():
            total_count = int(total_count)
        if total_count != 1:
            raise Refused("OpenAPI ListJobs TotalCount must be exactly 1")
        job = jobs[0]
    else:
        job = find_job_object(response, job_id)
    if job is None:
        raise Refused("external placement source does not contain the exact JobId")
    settings = job.get("Settings")
    if not isinstance(settings, dict):
        settings = {}
    oversold_type = job.get("OversoldType") or settings.get("OversoldType")
    checks = {
        "job_id": job.get("JobId") == job_id,
        "display_name": job.get("DisplayName") == resolved["name"],
        "workspace_id": str(job.get("WorkspaceId"))
        == resolved["workspace_id"],
        "resource_id": job.get("ResourceId")
        == resolved["resource"]["resource_id"],
        "oversold_type": oversold_type
        == resolved["resource"]["oversold_type"],
        "use_oversold_resource": job.get("UseOversoldResource") is True,
    }
    if not all(checks.values()):
        failed = sorted(key for key, value in checks.items() if not value)
        raise Refused(
            f"external placement source failed exact-job checks: {failed}"
        )
    return {
        "source_kind": source_kind,
        "source_label": source_spec["label"],
        "observed_at_utc": observed_at_utc,
        "checks": checks,
        "response_sha256": sha256_bytes(
            json.dumps(response, sort_keys=True, separators=(",", ":")).encode(
                "utf-8"
            )
        ),
        "source_file_sha256": sha256_bytes(body),
    }


def external_idle_evidence(
    resolved: Dict[str, Any], job_id: str
) -> Optional[Dict[str, Any]]:
    evidence_path = run_dir(resolved["run_id"]) / "placement-evidence.external.json"
    if not evidence_path.exists():
        return None
    if evidence_path.is_symlink() or not evidence_path.is_file():
        raise Refused("external placement evidence is not a regular non-symlink file")
    evidence_stat = evidence_path.stat()
    if (
        evidence_stat.st_uid != 2254
        or evidence_stat.st_gid != 2254
        or stat.S_IMODE(evidence_stat.st_mode) != 0o600
    ):
        raise Refused("external placement evidence must be 2254:2254 mode 0600")
    evidence = load_json(evidence_path)
    source_kind, source_spec = external_idle_source_spec(
        source_label=str(evidence.get("source", ""))
    )
    expected = {
        "schema_version": 1,
        "run_id": resolved["run_id"],
        "job_id": job_id,
        "display_name": resolved["name"],
        "resource_id": resolved["resource"]["resource_id"],
        "oversold_type": resolved["resource"]["oversold_type"],
        "use_oversold_resource": True,
        "source": source_spec["label"],
        "recorded_by_uid": 2254,
        "recorded_by_gid": 2254,
        "complete": True,
    }
    for key, value in expected.items():
        if evidence.get(key) != value:
            raise Refused(f"invalid external placement evidence field: {key}")
    if not re.fullmatch(r"[a-f0-9]{64}", str(evidence.get("raw_response_sha256", ""))):
        raise Refused("external placement evidence has no raw-response SHA256")
    require_utc_timestamp(
        evidence.get("observed_at_utc"), "external observed_at_utc"
    )
    sealed_path = Path(str(evidence.get("sealed_source_path", "")))
    expected_sealed_path = (
        run_dir(resolved["run_id"]) / source_spec["sealed_name"]
    )
    if sealed_path != expected_sealed_path:
        raise Refused("external placement evidence sealed-source path is invalid")
    sealed_body, sealed_stat = read_regular_path(sealed_path)
    if stat.S_IMODE(sealed_stat.st_mode) != 0o600:
        raise Refused("sealed external placement source must be mode 0600")
    parsed_source = parse_external_idle_source(
        sealed_body,
        resolved,
        job_id,
        expected_source_label=source_spec["label"],
    )
    if parsed_source["source_kind"] != source_kind:
        raise Refused("sealed external placement source kind changed")
    if parsed_source["source_file_sha256"] != evidence.get("sealed_source_sha256"):
        raise Refused("sealed placement source hash does not match evidence")
    if parsed_source["response_sha256"] != evidence.get("raw_response_sha256"):
        raise Refused("raw placement response hash does not match evidence")
    if parsed_source["observed_at_utc"] != evidence.get("observed_at_utc"):
        raise Refused("placement observation timestamp does not match evidence")
    return evidence


def parse_int(value: Any) -> Optional[int]:
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.strip().isdigit():
        return int(value.strip())
    return None


def restart_evidence(
    response: Dict[str, Any],
    job_id: str,
    expected_count: int,
    required_distinct_workload_pod_uids: int,
    previous: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    job = find_job_object(response, job_id)
    if job is None:
        return {
            "expected_count": expected_count,
            "required_distinct_workload_pod_uids": (
                required_distinct_workload_pod_uids
            ),
            "complete": False,
            "error": f"exact JobId {job_id} was absent from GetJob",
        }
    raw_times = job.get("RestartTimes")
    used: Optional[int] = None
    maximum: Optional[int] = None
    if isinstance(raw_times, int):
        used = raw_times
    elif isinstance(raw_times, str):
        match = re.fullmatch(r"\s*(\d+)(?:\s*/\s*(\d+))?\s*", raw_times)
        if match:
            used = int(match.group(1))
            maximum = int(match.group(2)) if match.group(2) else None
    records = job.get("RestartRecord")
    if not isinstance(records, list):
        records = []
    triggered_records: List[Dict[str, Any]] = []
    triggered_counts: List[int] = []
    fail_reasons: List[str] = []
    for record in records:
        if not isinstance(record, dict):
            continue
        detail = record.get("DetailErrorInfoList")
        if not isinstance(detail, list):
            detail = []
        triggered = any(
            isinstance(item, dict) and item.get("TriggerRestart") is True
            for item in detail
        )
        if triggered:
            triggered_records.append(record)
            count = parse_int(record.get("JobRestartCount"))
            if count is not None:
                triggered_counts.append(count)
        reason = str(record.get("RestartFailReason") or "").strip()
        if reason:
            fail_reasons.append(reason)
    top_reason = str(job.get("RestartFailReason") or "").strip()
    if top_reason:
        fail_reasons.append(top_reason)

    previous = previous if isinstance(previous, dict) else {}
    workload_pod_uids = {
        str(value)
        for value in previous.get("workload_pod_uids", [])
        if value
    }
    pod_observations = [
        item
        for item in previous.get("pod_observations", [])
        if isinstance(item, dict)
    ]
    observation_keys = {
        (
            str(item.get("type", "")),
            str(item.get("pod_uid", "")),
            str(item.get("status", "")),
        )
        for item in pod_observations
    }
    failed_history_pods = 0
    pods = job.get("Pods")
    if not isinstance(pods, list):
        pods = []
    for pod in pods:
        if not isinstance(pod, dict):
            continue
        pod_type = str(pod.get("Type") or "").lower()
        if pod_type == "aimaster":
            continue
        pod_uid = str(pod.get("PodUid") or "")
        pod_status = str(pod.get("Status") or "")
        if pod_uid:
            workload_pod_uids.add(pod_uid)
            key = (pod_type, pod_uid, pod_status)
            if key not in observation_keys:
                pod_observations.append(
                    {
                        "observed_at_utc": utc_now(),
                        "type": pod_type,
                        "pod_id": str(pod.get("PodId") or ""),
                        "pod_uid": pod_uid,
                        "status": pod_status,
                    }
                )
                observation_keys.add(key)
        histories = pod.get("HistoryPods")
        if not isinstance(histories, list):
            histories = []
        for history in histories:
            if not isinstance(history, dict):
                continue
            history_uid = str(history.get("PodUid") or "")
            history_status = str(history.get("Status") or "")
            if history_uid:
                workload_pod_uids.add(history_uid)
                history_key = (pod_type, history_uid, history_status)
                if history_key not in observation_keys:
                    pod_observations.append(
                        {
                            "observed_at_utc": utc_now(),
                            "type": pod_type,
                            "pod_id": str(history.get("PodId") or ""),
                            "pod_uid": history_uid,
                            "status": history_status,
                            "source": "HistoryPods",
                        }
                    )
                    observation_keys.add(history_key)
            if history.get("Status") == "Failed":
                failed_history_pods += 1

    explicit_restart_fields_present = (
        raw_times is not None or bool(records)
    )
    explicit_restart_fields_match = (
        used == expected_count
        and (maximum is None or maximum == expected_count)
        and len(triggered_records) == expected_count
        and sorted(triggered_counts) == list(range(1, expected_count + 1))
        and not fail_reasons
    )
    explicit_restart_conflict = (
        (used is not None and used != expected_count)
        or (maximum is not None and maximum != expected_count)
        or bool(fail_reasons)
    )
    workload_pod_transition = (
        len(workload_pod_uids) >= required_distinct_workload_pod_uids
    )
    complete = (
        workload_pod_transition
        and not explicit_restart_conflict
        and (
            not explicit_restart_fields_present
            or explicit_restart_fields_match
        )
    )
    return {
        "expected_count": expected_count,
        "required_distinct_workload_pod_uids": (
            required_distinct_workload_pod_uids
        ),
        "restart_times": raw_times,
        "used_count": used,
        "maximum_count": maximum,
        "triggered_record_count": len(triggered_records),
        "triggered_job_restart_counts": sorted(triggered_counts),
        "restart_fail_reasons": fail_reasons,
        "history_failed_pod_count": failed_history_pods,
        "workload_pod_uids": sorted(workload_pod_uids),
        "distinct_workload_pod_uid_count": len(workload_pod_uids),
        "pod_observations": pod_observations,
        "workload_pod_transition": workload_pod_transition,
        "explicit_restart_fields_present": explicit_restart_fields_present,
        "explicit_restart_fields_match": explicit_restart_fields_match,
        "evidence_boundary": (
            "The pinned DLC GetJob may omit RestartTimes/RestartRecord. AIMaster "
            "configuration plus distinct non-AIMaster workload PodUid values "
            "from current Pods, HistoryPods, or cross-poll observations, combined "
            "with nonce-bound attempt-1/attempt-2 artifacts, is used."
        ),
        "records": records,
        "complete": complete,
    }


def read_regular_at(
    directory_fd: int, name: str
) -> Tuple[bytes, os.stat_result]:
    entry_stat = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    if not stat.S_ISREG(entry_stat.st_mode):
        raise Refused(f"artifact is not a regular file: {name}")
    file_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
    try:
        opened_stat = os.fstat(file_fd)
        if (
            opened_stat.st_dev != entry_stat.st_dev
            or opened_stat.st_ino != entry_stat.st_ino
        ):
            raise Refused(f"artifact changed while opening: {name}")
        chunks: List[bytes] = []
        while True:
            chunk = os.read(file_fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(file_fd)
    return b"".join(chunks), entry_stat


def parse_context_body(
    body: bytes, name: str, run_id: str, nonce: str
) -> Dict[str, Any]:
    try:
        value = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused(f"artifact is not valid JSON: {name}: {exc}") from exc
    if not isinstance(value, dict):
        raise Refused(f"artifact JSON is not an object: {name}")
    if value.get("run_id") != run_id or value.get("nonce") != nonce:
        raise Refused(f"stale or foreign canary artifact: {name}")
    return value


def validated_delete_evidence(resolved: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    evidence_path = run_dir(resolved["run_id"]) / "dev14-delete-evidence.json"
    if not evidence_path.exists():
        return None
    evidence = load_json(evidence_path)
    target = str(Path(resolved["artifact_dir"]) / "dev14-delete-proof.json")
    expected = {
        "run_id": resolved["run_id"],
        "nonce": resolved["runtime"]["canary_nonce"],
        "path": target,
        "after_exists": False,
        "performed_by_uid": 2254,
        "performed_by_gid": 2254,
        "complete": True,
    }
    for key, value in expected.items():
        if evidence.get(key) != value:
            raise Refused(f"invalid persisted dev14 delete evidence field: {key}")
    if Path(target).exists():
        raise Refused("delete evidence exists but target file still exists")
    return evidence


def verify_canary_artifacts(resolved: Dict[str, Any]) -> Dict[str, Any]:
    artifact_dir = Path(resolved["artifact_dir"])
    canonical_write_path(str(artifact_dir))
    run_id = resolved["run_id"]
    nonce = resolved["runtime"]["canary_nonce"]
    delete_evidence = validated_delete_evidence(resolved)
    expected_names = {
        "identity.json",
        "gpu-inventory-attempt-1.txt",
        "gpu-inventory-attempt-2.txt",
        "attempt-1.json",
        "intentional-failure.json",
        "attempt-2.json",
        "recovered-success.json",
    }
    if delete_evidence is None:
        expected_names.add("dev14-delete-proof.json")
    evidence: Dict[str, Any] = {
        "artifact_dir": str(artifact_dir),
        "expected_names": sorted(expected_names),
        "files": {},
        "delete_evidence_reused": delete_evidence is not None,
    }
    if not artifact_dir.is_dir() or artifact_dir.is_symlink():
        evidence.update({"observed_names": [], "strict_file_set": False, "complete": False})
        return evidence

    directory_fd = os.open(
        artifact_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    parsed: Dict[str, Dict[str, Any]] = {}
    try:
        observed_names = set(os.listdir(directory_fd))
        evidence["observed_names"] = sorted(observed_names)
        evidence["strict_file_set"] = observed_names == expected_names
        complete = bool(evidence["strict_file_set"])
        for name in sorted(expected_names):
            item: Dict[str, Any] = {"path": str(artifact_dir / name)}
            try:
                body, item_stat = read_regular_at(directory_fd, name)
            except (FileNotFoundError, Refused) as exc:
                item.update({"exists": False, "error": str(exc)})
                complete = False
                evidence["files"][name] = item
                continue
            item.update(
                {
                    "exists": True,
                    "uid": item_stat.st_uid,
                    "gid": item_stat.st_gid,
                    "owner_ok": item_stat.st_uid == 2254
                    and item_stat.st_gid == 2254,
                    "sha256": sha256_bytes(body),
                }
            )
            complete = complete and bool(item["owner_ok"])
            if name.endswith(".json"):
                try:
                    parsed[name] = parse_context_body(body, name, run_id, nonce)
                    item["context_ok"] = True
                except Refused as exc:
                    item["context_ok"] = False
                    item["error"] = str(exc)
                    complete = False
            evidence["files"][name] = item
    finally:
        os.close(directory_fd)

    identity = parsed.get("identity.json", {})
    attempt_1 = parsed.get("attempt-1.json", {})
    failure = parsed.get("intentional-failure.json", {})
    attempt_2 = parsed.get("attempt-2.json", {})
    success = parsed.get("recovered-success.json", {})
    inv1 = evidence["files"].get("gpu-inventory-attempt-1.txt", {})
    inv2 = evidence["files"].get("gpu-inventory-attempt-2.txt", {})
    semantic_checks = {
        "identity_2254": identity.get("uid") == 2254 and identity.get("gid") == 2254,
        "attempt_1": attempt_1.get("attempt") == 1
        and attempt_1.get("gpu_count") == 8,
        "attempt_1_inventory_hash": attempt_1.get("gpu_inventory_sha256")
        == inv1.get("sha256"),
        "failure_42": failure.get("exit_code") == 42,
        "attempt_2": attempt_2.get("attempt") == 2
        and attempt_2.get("gpu_count") == 8,
        "attempt_2_inventory_hash": attempt_2.get("gpu_inventory_sha256")
        == inv2.get("sha256"),
        "success_after_restart": success.get("status")
        == "succeeded_after_platform_restart"
        and success.get("attempt") == 2
        and success.get("gpu_count") == 8,
        "timestamp_order": bool(attempt_1.get("timestamp_utc"))
        and attempt_1.get("timestamp_utc", "")
        <= attempt_2.get("timestamp_utc", ""),
    }
    evidence["semantic_checks"] = semantic_checks
    evidence["complete"] = complete and all(semantic_checks.values())
    return evidence


def perform_dev14_unlink(resolved: Dict[str, Any]) -> Dict[str, Any]:
    require_leon_controller()
    target_dir = private_run_dir(resolved["run_id"])
    lock_path = target_dir / "dev14-delete.lock"
    with open_private_append(lock_path) as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        existing = validated_delete_evidence(resolved)
        if existing is not None:
            return existing

        artifact_dir = Path(resolved["artifact_dir"])
        canonical_write_path(str(artifact_dir))
        target_name = "dev14-delete-proof.json"
        target = artifact_dir / target_name
        intent_path = target_dir / "dev14-delete-intent.json"
        directory_fd = os.open(
            artifact_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        )
        try:
            try:
                body, target_stat = read_regular_at(directory_fd, target_name)
            except FileNotFoundError:
                if not intent_path.exists():
                    raise Refused(
                        "PAI-created delete target is absent and no durable intent exists"
                    )
                intent = load_json(intent_path)
                if (
                    intent.get("run_id") != resolved["run_id"]
                    or intent.get("nonce") != resolved["runtime"]["canary_nonce"]
                    or intent.get("path") != str(target)
                ):
                    raise Refused("delete intent has stale or foreign context")
                evidence = {
                    **intent,
                    "performed_at_utc": utc_now(),
                    "after_exists": False,
                    "performed_by_uid": os.getuid(),
                    "performed_by_gid": os.getgid(),
                    "recovered_after_controller_interruption": True,
                    "complete": True,
                }
                atomic_json(target_dir / "dev14-delete-evidence.json", evidence)
                return evidence

            if not stat.S_ISREG(target_stat.st_mode):
                raise Refused(f"delete proof is not a regular file: {target}")
            if target_stat.st_uid != 2254 or target_stat.st_gid != 2254:
                raise Refused(
                    f"delete proof is not PAI-created Leon-owned content: {target}"
                )
            value = parse_context_body(
                body, target_name, resolved["run_id"], resolved["runtime"]["canary_nonce"]
            )
            intent = {
                "intent_at_utc": utc_now(),
                "run_id": resolved["run_id"],
                "nonce": resolved["runtime"]["canary_nonce"],
                "path": str(target),
                "before_uid": target_stat.st_uid,
                "before_gid": target_stat.st_gid,
                "before_dev": target_stat.st_dev,
                "before_ino": target_stat.st_ino,
                "before_sha256": sha256_bytes(body),
                "before_content": value,
            }
            atomic_json(intent_path, intent)
            os.unlink(target_name, dir_fd=directory_fd)
            os.fsync(directory_fd)
            try:
                os.stat(target_name, dir_fd=directory_fd, follow_symlinks=False)
            except FileNotFoundError:
                pass
            else:
                raise Refused(f"dev14 Leon unlink did not remove {target}")
        finally:
            os.close(directory_fd)

        evidence = {
            **intent,
            "performed_at_utc": utc_now(),
            "after_exists": False,
            "performed_by_uid": os.getuid(),
            "performed_by_gid": os.getgid(),
            "recovered_after_controller_interruption": False,
            "complete": True,
        }
        atomic_json(target_dir / "dev14-delete-evidence.json", evidence)
        return evidence


def submit_resolved(
    resolved: Dict[str, Any],
    config_path: Path,
    requested: Dict[str, Any],
) -> str:
    require_leon_controller()
    validate_resolved(resolved)
    if resolved.get("controller_version") != CONTROLLER_VERSION:
        raise Refused(
            "legacy controller manifests are lifecycle-readable but cannot "
            "be submitted; structurally clone them with the current controller"
        )
    tc, dlc_path = toolchain()
    secret_env = declared_secret_env_values(resolved)
    secret_names = sorted(secret_env)
    target_dir = private_run_dir(resolved["run_id"], create=True)

    with open_private_append(LOCK_PATH) as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        submission_gate(target_dir)
        atomic_json(
            target_dir / "submission-state.json",
            {
                "state": "preparing",
                "started_at_utc": utc_now(),
                "unique_name": resolved["name"],
            },
        )
        try:
            atomic_json(target_dir / "requested.json", requested)
            atomic_json(target_dir / "resolved.json", resolved)
            source_evidence, source_raw_responses = live_source_readback(
                resolved, config_path
            )
            atomic_json(target_dir / "source-readback.json", source_evidence)
            for role, response in source_raw_responses.items():
                atomic_json(
                    target_dir / f"source-readback.{role}.raw.json",
                    response,
                )
            if source_evidence.get("complete") is not True:
                raise Refused(
                    "live source readback drifted from the template/toolchain contract"
                )
            prepare_write_paths(resolved)
            payload = base64.b64decode(resolved["runtime"]["payload_base64"])
            payload_path = (
                target_dir
                / "payload"
                / f"{resolved['runtime']['payload_sha256']}.sh"
            )
            atomic_bytes(payload_path, payload, mode=0o500)
            argv = build_submit_argv(
                resolved,
                dlc_path,
                config_path,
                secret_env=secret_env,
            )
            atomic_json(
                target_dir / "submit.argv.json",
                {
                    "created_at_utc": utc_now(),
                    "argv": redact_submit_argv(argv, secret_env),
                    "secret_env_names": secret_names,
                    "config_path": str(config_path),
                    "dlc_version": tc["dlc"]["version"],
                    "dlc_sha256": tc["dlc"]["sha256"],
                },
            )
            verify_and_record_wandb_precreate(target_dir, secret_env)
        except BaseException as exc:
            state = load_json(target_dir / "submission-state.json")
            state.update(
                {
                    "state": "preflight_failed_sealed",
                    "finished_at_utc": utc_now(),
                    "error_type": type(exc).__name__,
                }
            )
            atomic_json(target_dir / "submission-state.json", state)
            raise

        atomic_json(
            target_dir / "submission-state.json",
            {
                "state": "submitting",
                "started_at_utc": utc_now(),
                "unique_name": resolved["name"],
            },
        )
        try:
            completed = subprocess.run(
                argv,
                text=True,
                capture_output=True,
                timeout=180,
                check=False,
            )
        except subprocess.TimeoutExpired as exc:
            atomic_text(
                target_dir / "submit.stdout.txt",
                redact_sensitive_text(exc.stdout, secret_env.values()),
            )
            atomic_text(
                target_dir / "submit.stderr.txt",
                redact_sensitive_text(exc.stderr, secret_env.values()),
            )
            result = {
                "submission_state": "uncertain_timeout",
                "finished_at_utc": utc_now(),
                "name": resolved["name"],
                "run_id": resolved["run_id"],
                "warning": "This run_id is sealed; do not retry it.",
            }
            atomic_json(target_dir / "result.json", result)
            atomic_json(
                target_dir / "submission-state.json",
                {
                    "state": "uncertain_timeout",
                    "finished_at_utc": utc_now(),
                    "unique_name": resolved["name"],
                },
            )
            raise Refused(
                "submission timed out in an uncertain remote state; run_id is sealed"
            )
        except BaseException:
            atomic_json(
                target_dir / "submission-state.json",
                {
                    "state": "uncertain_interrupted",
                    "finished_at_utc": utc_now(),
                    "unique_name": resolved["name"],
                },
            )
            raise

        atomic_text(
            target_dir / "submit.stdout.txt",
            redact_sensitive_text(completed.stdout, secret_env.values()),
        )
        atomic_text(
            target_dir / "submit.stderr.txt",
            redact_sensitive_text(completed.stderr, secret_env.values()),
        )
        stdout_job_ids = sorted(set(JOB_ID_RE.findall(completed.stdout)))
        stderr_job_ids = sorted(set(JOB_ID_RE.findall(completed.stderr)))
        parsed_submit: Optional[Dict[str, Any]] = None
        parsed_submit_summary: Optional[Dict[str, Any]] = None
        request_contract: Optional[Dict[str, Any]] = None
        submit_parse_error = ""
        try:
            parsed_submit = parse_submit_stdout(completed.stdout)
            parsed_request = parsed_submit.pop("request")
            parsed_submit_summary = parsed_submit
            request_contract = verify_submit_request(parsed_request, resolved)
            atomic_json(
                target_dir / "submit-request-contract.json",
                request_contract,
            )
        except Refused as exc:
            submit_parse_error = str(exc)
        job_id = (
            str(parsed_submit["job_id"])
            if (
                completed.returncode == 0
                and parsed_submit is not None
                and not stderr_job_ids
            )
            else None
        )
        state = (
            "uncertain_submit_nonzero"
            if completed.returncode != 0
            else (
                "uncertain_job_id_parse"
                if job_id is None
                else (
                    "submitted_request_contract_mismatch"
                    if request_contract is None
                    or request_contract.get("complete") is not True
                    else "submitted_pending_readback"
                )
            )
        )
        result = {
            "submission_state": state,
            "finished_at_utc": utc_now(),
            "returncode": completed.returncode,
            "job_id": job_id,
            "stdout_job_ids": stdout_job_ids,
            "stderr_job_ids": stderr_job_ids,
            "submit_parse": parsed_submit_summary,
            "submit_parse_error": submit_parse_error,
            "submit_request_contract": request_contract,
            "name": resolved["name"],
            "run_id": resolved["run_id"],
        }
        atomic_json(target_dir / "result.json", result)
        atomic_json(
            target_dir / "submission-state.json",
            {
                "state": state,
                "finished_at_utc": utc_now(),
                "unique_name": resolved["name"],
                "job_id": job_id,
            },
        )
        if completed.returncode != 0:
            raise Refused(
                f"DLC submit returned exit {completed.returncode} in an uncertain "
                f"remote state; run_id is sealed"
            )
        if job_id is None:
            raise Refused(
                "DLC response did not contain one strictly parsed success-table "
                "JobId with no JobId on stderr; run_id is sealed"
            )
        append_ledger_unlocked(
            {
                "recorded_at_utc": utc_now(),
                "run_id": resolved["run_id"],
                "job_id": job_id,
                "name": resolved["name"],
                "resource_alias": resolved["resource_alias"],
                "resource_id": resolved["resource"]["resource_id"],
                "oversold_type": resolved["resource"]["oversold_type"],
                "aimaster_args": resolved["fault_tolerance"].get(
                    "aimaster_args", ""
                ),
                "nonce": resolved["runtime"]["canary_nonce"],
                "contract_source_job_id": resolved["provenance"][
                    "contract_source_job_id"
                ],
                "resolved_path": str(target_dir / "resolved.json"),
            }
        )
        if request_contract is None or request_contract.get("complete") is not True:
            raise Refused(
                f"JobId {job_id} was created but the printed CreateJob request "
                "did not match the sealed resolved manifest"
            )

    readback_error = ""
    received_response = False
    last_contract: Optional[Dict[str, Any]] = None
    for _ in range(10):
        try:
            response, stdout, stderr = get_job(job_id, config_path)
        except Refused as exc:
            readback_error = str(exc)
            time.sleep(3)
            continue
        received_response = True
        contract = verify_getjob_contract(response, job_id, resolved)
        last_contract = contract
        atomic_json(
            target_dir / "getjob-initial.json",
            redact_secret_envs_in_object(response, secret_names),
        )
        atomic_text(
            target_dir / "getjob-initial.stdout.txt",
            redact_sensitive_text(stdout, secret_env.values()),
        )
        atomic_text(
            target_dir / "getjob-initial.stderr.txt",
            redact_sensitive_text(stderr, secret_env.values()),
        )
        atomic_json(target_dir / "contract-readback.initial.json", contract)
        result = load_json(target_dir / "result.json")
        result["submission_state"] = (
            "submitted_verified"
            if contract["complete"]
            else "submitted_contract_mismatch"
        )
        result["initial_readback_at_utc"] = utc_now()
        atomic_json(target_dir / "result.json", result)
        state_value = load_json(target_dir / "submission-state.json")
        state_value["state"] = result["submission_state"]
        state_value["initial_readback_at_utc"] = utc_now()
        atomic_json(target_dir / "submission-state.json", state_value)
        if contract["complete"]:
            return job_id
        failed = sorted(
            key for key, value in contract["checks"].items() if not value
        )
        readback_error = f"GetJob contract failed checks: {failed}"
        time.sleep(3)

    result = load_json(target_dir / "result.json")
    final_state = (
        "submitted_contract_mismatch"
        if received_response
        else "submitted_pending_readback"
    )
    result["submission_state"] = final_state
    result["initial_readback_error"] = readback_error
    if last_contract is not None:
        result["initial_readback_failed_checks"] = sorted(
            key for key, value in last_contract["checks"].items() if not value
        )
    atomic_json(target_dir / "result.json", result)
    state_value = load_json(target_dir / "submission-state.json")
    state_value["state"] = final_state
    state_value["initial_readback_error"] = readback_error
    atomic_json(target_dir / "submission-state.json", state_value)
    if received_response:
        raise Refused(
            f"JobId {job_id} was created but its GetJob contract remained mismatched"
        )
    raise Refused(
        f"JobId {job_id} was created but initial GetJob did not settle; "
        f"continue with watch. Last error: {readback_error}"
    )


def require_exact_ledger_binding(
    run_id: str, job_id: str, resolved: Dict[str, Any], target_dir: Path
) -> None:
    body, _ = read_regular_path(LEDGER_PATH)
    matches: List[Dict[str, Any]] = []
    for line_number, raw_line in enumerate(body.decode("utf-8").splitlines(), 1):
        if not raw_line:
            continue
        try:
            entry = json.loads(raw_line)
        except json.JSONDecodeError as exc:
            raise Refused(
                f"jobs ledger line {line_number} is malformed JSON"
            ) from exc
        if not isinstance(entry, dict):
            raise Refused(f"jobs ledger line {line_number} is not an object")
        if entry.get("run_id") == run_id:
            matches.append(entry)
    if len(matches) != 1:
        raise Refused(
            f"expected exactly one jobs ledger entry for {run_id}, got {len(matches)}"
        )
    entry = matches[0]
    expected = {
        "run_id": run_id,
        "job_id": job_id,
        "name": resolved["name"],
        "resource_alias": resolved["resource_alias"],
        "resource_id": resolved["resource"]["resource_id"],
        "oversold_type": resolved["resource"]["oversold_type"],
        "aimaster_args": resolved["fault_tolerance"].get("aimaster_args", ""),
        "nonce": resolved["runtime"]["canary_nonce"],
        "contract_source_job_id": resolved["provenance"][
            "contract_source_job_id"
        ],
        "resolved_path": str(target_dir / "resolved.json"),
    }
    failed = [
        key for key, value in expected.items() if entry.get(key) != value
    ]
    if failed:
        raise Refused(f"jobs ledger binding mismatch: {sorted(failed)}")


def reconcile_created_submission(
    run_id: str, job_id: str, config_path: Path
) -> str:
    require_leon_controller()
    if not JOB_ID_RE.fullmatch(job_id):
        raise Refused("reconcile-created requires one exact DLC JobId")
    target_dir = private_run_dir(run_id)

    with open_private_append(LOCK_PATH) as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        requested = load_json(target_dir / "requested.json")
        resolved = load_json(target_dir / "resolved.json")
        result = load_json(target_dir / "result.json")
        state = load_json(target_dir / "submission-state.json")
        validate_resolved(resolved)
        if resolved.get("run_id") != run_id or result.get("run_id") != run_id:
            raise Refused("sealed run_id binding does not match reconcile-created")
        allowed_states = {
            "submitted_request_contract_mismatch",
            "submitted_pending_readback",
            "submitted_contract_mismatch",
        }
        result_state = result.get("submission_state")
        state_value = state.get("state")
        if result_state not in allowed_states or state_value not in allowed_states:
            raise Refused(
                "reconcile-created only accepts a sealed, already-created "
                "submission awaiting contract reconciliation"
            )
        if result_state != state_value:
            raise Refused("result and submission-state disagree")
        if result.get("job_id") != job_id or state.get("job_id") != job_id:
            raise Refused("sealed JobId binding does not match reconcile-created")
        if result.get("name") != resolved["name"]:
            raise Refused("sealed display-name binding does not match resolved manifest")
        if result.get("returncode") != 0:
            raise Refused("original DLC submit did not return exit 0")
        if result.get("stderr_job_ids") != []:
            raise Refused("original stderr contained a JobId")

        stdout_body, _ = read_regular_path(target_dir / "submit.stdout.txt")
        stderr_body, _ = read_regular_path(target_dir / "submit.stderr.txt")
        try:
            stdout = stdout_body.decode("utf-8")
            stderr = stderr_body.decode("utf-8")
        except UnicodeDecodeError as exc:
            raise Refused("original DLC submit output is not UTF-8") from exc
        if sorted(set(JOB_ID_RE.findall(stderr))) != []:
            raise Refused("original stderr now contains a JobId")
        parsed = parse_submit_stdout(stdout)
        parsed_request = parsed.pop("request")
        if parsed.get("job_id") != job_id:
            raise Refused("strictly reparsed submit JobId does not match sealed JobId")
        expected_stdout_job_ids = sorted(
            {job_id, *parsed.get("request_job_ids", [])}
        )
        if result.get("stdout_job_ids") != expected_stdout_job_ids:
            raise Refused(
                "original stdout JobIds do not match the sealed request and result"
            )
        if parsed != result.get("submit_parse"):
            raise Refused("strictly reparsed submit summary changed from sealed result")

        request_contract = verify_submit_request(parsed_request, resolved)
        atomic_json(
            target_dir / "submit-request-contract.json",
            request_contract,
        )
        if request_contract.get("complete") is not True:
            failed = sorted(
                key
                for key, value in request_contract.get("checks", {}).items()
                if not value
            )
            raise Refused(
                f"reconciled CreateJob request still mismatches: {failed}"
            )
        require_exact_ledger_binding(run_id, job_id, resolved, target_dir)

        readback_error = ""
        received_response = False
        last_contract: Optional[Dict[str, Any]] = None
        for _ in range(10):
            try:
                response, get_stdout, get_stderr = get_job(job_id, config_path)
            except Refused as exc:
                readback_error = str(exc)
                time.sleep(3)
                continue
            received_response = True
            contract = verify_getjob_contract(response, job_id, resolved)
            last_contract = contract
            secret_names = normalize_secret_env_names(
                resolved.get("runtime", {}).get("secret_env_names")
            )
            safe_response = redact_secret_envs_in_object(response, secret_names)
            atomic_json(target_dir / "getjob-initial.json", safe_response)
            atomic_text(
                target_dir / "getjob-initial.stdout.txt",
                json.dumps(safe_response, ensure_ascii=False, indent=2) + "\n",
            )
            atomic_text(target_dir / "getjob-initial.stderr.txt", get_stderr)
            atomic_json(target_dir / "contract-readback.initial.json", contract)
            if contract.get("complete") is True:
                reconciled_at = utc_now()
                result["submission_state"] = "submitted_verified"
                result["submit_request_contract"] = request_contract
                result["reconciled_at_utc"] = reconciled_at
                result["initial_readback_at_utc"] = reconciled_at
                result.pop("initial_readback_error", None)
                result.pop("initial_readback_failed_checks", None)
                atomic_json(target_dir / "result.json", result)
                state["state"] = "submitted_verified"
                state["reconciled_at_utc"] = reconciled_at
                state["initial_readback_at_utc"] = reconciled_at
                state.pop("initial_readback_error", None)
                atomic_json(target_dir / "submission-state.json", state)
                return job_id
            failed = sorted(
                key for key, value in contract.get("checks", {}).items() if not value
            )
            readback_error = f"GetJob contract failed checks: {failed}"
            time.sleep(3)

        result["initial_readback_error"] = readback_error
        if last_contract is not None:
            result["initial_readback_failed_checks"] = sorted(
                key
                for key, value in last_contract.get("checks", {}).items()
                if not value
            )
        atomic_json(target_dir / "result.json", result)
        state["initial_readback_error"] = readback_error
        atomic_json(target_dir / "submission-state.json", state)
        if received_response:
            raise Refused(
                f"JobId {job_id} GetJob contract remained mismatched during reconciliation"
            )
        raise Refused(
            f"JobId {job_id} GetJob did not settle during reconciliation: "
            f"{readback_error}"
        )


def capture_terminal_diagnostics(
    job_id: str, config_path: Path, data: Dict[str, Any], target_dir: Path
) -> None:
    _, dlc_path = toolchain()
    commands: List[Tuple[str, List[str]]] = [
        (
            "events",
            [
                str(dlc_path),
                "-c",
                str(config_path),
                "get",
                "job",
                job_id,
                "--events",
                "--events_only",
            ],
        )
    ]
    job = find_job_object(data, job_id)
    pod_ids = set()
    if isinstance(job, dict):
        pods = job.get("Pods")
        if not isinstance(pods, list):
            pods = []
        for pod in pods:
            if not isinstance(pod, dict):
                continue
            if pod.get("PodId"):
                pod_ids.add(str(pod["PodId"]))
            histories = pod.get("HistoryPods")
            if not isinstance(histories, list):
                histories = []
            for history in histories:
                if isinstance(history, dict) and history.get("PodId"):
                    pod_ids.add(str(history["PodId"]))
    for pod_id in sorted(pod_ids):
        commands.append(
            (
                f"pod-{pod_id}-logs",
                [
                    str(dlc_path),
                    "-c",
                    str(config_path),
                    "logs",
                    job_id,
                    pod_id,
                ],
            )
        )
    for label, argv in commands:
        try:
            completed = subprocess.run(
                argv,
                text=True,
                capture_output=True,
                timeout=120,
                check=False,
            )
        except (subprocess.TimeoutExpired, OSError) as exc:
            atomic_text(target_dir / "diagnostics" / f"{label}.error.txt", str(exc))
            continue
        atomic_text(target_dir / "diagnostics" / f"{label}.stdout.txt", completed.stdout)
        atomic_text(target_dir / "diagnostics" / f"{label}.stderr.txt", completed.stderr)


def command_resources(_: argparse.Namespace) -> int:
    print(json.dumps(load_json(RESOURCES_PATH), ensure_ascii=False, indent=2))
    return 0


def command_validate(args: argparse.Namespace) -> int:
    _, resolved = resolve_template(
        Path(args.template).resolve(),
        args.run_id,
        with_wandb=not args.no_wandb,
    )
    tc, dlc_path = toolchain()
    print(
        json.dumps(
            {
                "valid": True,
                "run_id": resolved["run_id"],
                "name": resolved["name"],
                "resource_alias": resolved["resource_alias"],
                "resource_id": resolved["resource"]["resource_id"],
                "oversold_type": resolved["resource"]["oversold_type"],
                "worker": resolved["worker"],
                "data_sources": resolved["storage"]["data_sources"],
                "provenance": resolved["provenance"],
                "identity": {
                    "mechanism": resolved["runtime"]["identity_mechanism"],
                    "uid": resolved["runtime"]["uid"],
                    "gid": resolved["runtime"]["gid"],
                    "nonce": resolved["runtime"]["canary_nonce"],
                    "payload_sha256": resolved["runtime"]["payload_sha256"],
                },
                "write_paths": resolved["runtime"]["write_paths"],
                "secret_env_names": resolved["runtime"]["secret_env_names"],
                "wandb_entity_contract": resolved["runtime"].get(
                    "wandb_entity_contract"
                ),
                "aimaster_args": resolved["fault_tolerance"].get(
                    "aimaster_args", ""
                ),
                "dlc": {"path": str(dlc_path), **tc["dlc"]},
                "mount_sentinel": tc["mount_sentinel"],
            },
            ensure_ascii=False,
            indent=2,
        )
    )
    return 0


def command_submit(args: argparse.Namespace) -> int:
    config_path = checked_config(args.config)
    if args.with_wandb:
        raise Refused(
            "--with-wandb transient credentials are forbidden; use the active "
            "private config created by pai-wandb-setup"
        )
    requested, resolved = resolve_template(
        Path(args.template).resolve(),
        args.run_id,
        with_wandb=not args.no_wandb,
    )
    job_id = submit_resolved(resolved, config_path, requested)
    print(job_id)
    return 0


def command_submit_resolved(args: argparse.Namespace) -> int:
    config_path = checked_config(args.config)
    if args.with_wandb:
        raise Refused(
            "--with-wandb transient credentials are forbidden; use the active "
            "private config created by pai-wandb-setup"
        )
    target_dir = private_run_dir(args.run_id)
    requested = load_json(target_dir / "requested.json")
    resolved = load_json(target_dir / "resolved.json")
    if not args.no_wandb:
        apply_wandb_secret_contract(requested)
        apply_wandb_secret_contract(resolved)
    if resolved.get("run_id") != args.run_id:
        raise Refused("resolved manifest run_id does not match CLI --run-id")
    job_id = submit_resolved(resolved, config_path, requested)
    print(job_id)
    return 0


def command_reconcile_created(args: argparse.Namespace) -> int:
    config_path = checked_config(args.config)
    job_id = reconcile_created_submission(
        args.run_id,
        args.job_id,
        config_path,
    )
    print(job_id)
    return 0


def command_clone(args: argparse.Namespace) -> int:
    require_leon_controller()
    ensure_run_id(args.from_run)
    ensure_run_id(args.run_id)
    source_dir = private_run_dir(args.from_run)
    requested = load_json(source_dir / "requested.json")
    source_secret_names = normalize_secret_env_names(
        requested.get("runtime", {}).get("secret_env_names")
    )
    if source_secret_names:
        apply_wandb_secret_contract(requested)
    resolved = resolve_manifest(
        requested,
        f"registry-structural-clone:{args.from_run}",
        args.run_id,
    )
    target_dir = run_dir(args.run_id)
    if target_dir.exists() or target_dir.is_symlink():
        raise Refused(f"clone target already exists: {target_dir}")
    os.mkdir(target_dir, 0o700)
    require_private_directory(target_dir)
    atomic_json(target_dir / "requested.json", requested)
    atomic_json(target_dir / "resolved.json", resolved)
    parent_result = (
        load_json(source_dir / "result.json")
        if (source_dir / "result.json").is_file()
        else {}
    )
    atomic_json(
        target_dir / "clone.json",
        {
            "clone_kind": "registry_structural_clone_not_pai_clone",
            "cloned_at_utc": utc_now(),
            "from_run": args.from_run,
            "from_job_id": parent_result.get("job_id"),
            "to_run": args.run_id,
            "new_nonce": resolved["runtime"]["canary_nonce"],
            "parent_requested_sha256": sha256(source_dir / "requested.json"),
            "parent_resolved_sha256": sha256(source_dir / "resolved.json"),
            "refreshed_resource": resolved["resource"],
            "refreshed_payload_sha256": resolved["runtime"]["payload_sha256"],
        },
    )
    print(target_dir / "resolved.json")
    return 0


def command_record_idle_evidence(args: argparse.Namespace) -> int:
    require_leon_controller()
    toolchain()
    target_dir = private_run_dir(args.run_id)
    resolved = load_json(target_dir / "resolved.json")
    result = load_json(target_dir / "result.json")
    if resolved.get("run_id") != args.run_id:
        raise Refused("resolved manifest run_id does not match evidence --run-id")
    if result.get("job_id") != args.job_id:
        raise Refused("placement evidence JobId is not bound to this registry run")
    if resolved["resource_alias"] not in {
        "idle-a800",
        "idle-a800-stablevla-8gpu",
        STABLEVLA_NATIVE5_IDLE_ALIAS,
        "idle-a800-wrc-4gpu",
    }:
        raise Refused("external idle evidence is only valid for the idle resource")
    _, source_spec = external_idle_source_spec(source_kind=args.source)
    source_path = Path(args.response_file)
    expected_source_path = target_dir / source_spec["staged_name"]
    if source_path != expected_source_path:
        raise Refused(
            f"--response-file must be the exact staged path {expected_source_path}"
        )
    source_body, source_stat = read_regular_path(source_path)
    if stat.S_IMODE(source_stat.st_mode) != 0o600:
        raise Refused("staged external placement response must be mode 0600")
    parsed_source = parse_external_idle_source(
        source_body,
        resolved,
        args.job_id,
        expected_source_label=source_spec["label"],
    )
    observed_time = parse_utc_datetime(
        parsed_source["observed_at_utc"], "external placement observed_at_utc"
    )
    age = datetime.now(timezone.utc) - observed_time
    if age.total_seconds() < -300 or age.total_seconds() > 1800:
        raise Refused(
            "external placement observation must be within the last 30 minutes"
        )

    sealed_path = target_dir / source_spec["sealed_name"]
    evidence_path = target_dir / "placement-evidence.external.json"
    for path in (sealed_path, evidence_path):
        if path.exists() or path.is_symlink():
            raise Refused("external placement evidence is immutable and already exists")
    atomic_create_bytes(sealed_path, source_body, mode=0o600)
    evidence = {
        "schema_version": 1,
        "observed_at_utc": parsed_source["observed_at_utc"],
        "recorded_at_utc": utc_now(),
        "run_id": args.run_id,
        "job_id": args.job_id,
        "display_name": resolved["name"],
        "resource_id": resolved["resource"]["resource_id"],
        "oversold_type": resolved["resource"]["oversold_type"],
        "use_oversold_resource": True,
        "source": source_spec["label"],
        "raw_response_sha256": parsed_source["response_sha256"],
        "sealed_source_path": str(sealed_path),
        "sealed_source_sha256": parsed_source["source_file_sha256"],
        "recorded_by_uid": os.getuid(),
        "recorded_by_gid": os.getgid(),
        "complete": True,
        "note": (
            "The pinned DLC CLI omits UseOversoldResource. This immutable "
            f"attestation records an exact-JobId read-only PAI {args.source}/"
            "ListJobs response and binds it to the registry run."
        ),
    }
    atomic_create_json(evidence_path, evidence, mode=0o600)
    external_idle_evidence(resolved, args.job_id)
    print(evidence_path)
    return 0


def command_get(args: argparse.Namespace) -> int:
    config_path = checked_config(args.config)
    data, stdout, stderr = get_job(args.job_id, config_path)
    display_data = data
    if args.run_id:
        target_dir = private_run_dir(args.run_id)
        result = load_json(target_dir / "result.json")
        if result.get("job_id") != args.job_id:
            raise Refused("JobId is not bound to the requested registry run")
        resolved = load_json(target_dir / "resolved.json")
        secret_names = normalize_secret_env_names(
            resolved.get("runtime", {}).get("secret_env_names")
        )
        display_data = redact_secret_envs_in_object(data, secret_names)
        atomic_json(target_dir / "getjob-latest.json", display_data)
        atomic_text(
            target_dir / "getjob-latest.stdout.txt",
            json.dumps(display_data, ensure_ascii=False, indent=2) + "\n",
        )
        atomic_text(target_dir / "getjob-latest.stderr.txt", stderr)
    print(json.dumps(display_data, ensure_ascii=False, indent=2))
    return 0


def verify_dinowm_artifact_record(
    record: Any,
    expected_path: Path,
    artifact_dir: Path,
    label: str,
    *,
    allow_empty: bool = False,
    expected_mode: Optional[int] = 0o600,
    capture_body: bool = False,
    max_size_bytes: Optional[int] = None,
) -> Tuple[Optional[bytes], os.stat_result]:
    if not isinstance(record, dict) or set(record) != {"path", "sha256"}:
        raise Refused(f"DINO-WM {label} artifact record is not exact")
    try:
        expected_path.relative_to(artifact_dir)
    except ValueError as exc:
        raise Refused(f"DINO-WM {label} artifact path escaped the run") from exc
    if record.get("path") != str(expected_path):
        raise Refused(f"DINO-WM {label} artifact path drifted")
    declared_sha = record.get("sha256")
    if not isinstance(declared_sha, str) or not re.fullmatch(
        r"[a-f0-9]{64}", declared_sha
    ):
        raise Refused(f"DINO-WM {label} artifact hash is malformed")
    try:
        if expected_path.resolve(strict=True) != expected_path:
            raise Refused(f"DINO-WM {label} artifact path is not canonical")
    except OSError as exc:
        raise Refused(f"DINO-WM {label} artifact path is unavailable: {exc}") from exc
    body, observed_sha, size_bytes, metadata = inspect_dinowm_regular_path(
        expected_path,
        capture_body=capture_body,
        max_size_bytes=max_size_bytes,
    )
    if not allow_empty and size_bytes == 0:
        raise Refused(f"DINO-WM {label} artifact is empty")
    if expected_mode is not None and stat.S_IMODE(metadata.st_mode) != expected_mode:
        raise Refused(f"DINO-WM {label} artifact mode drifted")
    if observed_sha != declared_sha:
        raise Refused(f"DINO-WM {label} artifact content hash drifted")
    return body, metadata


def require_dinowm_private_directory(path: Path, *, exact_mode: int = 0o700) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise Refused(f"DINO-WM directory is unavailable: {path}: {exc}") from exc
    if not stat.S_ISDIR(metadata.st_mode) or path.is_symlink():
        raise Refused(f"DINO-WM path is not a regular directory: {path}")
    if metadata.st_uid != 2254 or metadata.st_gid != 2254:
        raise Refused(f"DINO-WM directory owner drifted: {path}")
    if stat.S_IMODE(metadata.st_mode) != exact_mode:
        raise Refused(f"DINO-WM directory mode drifted: {path}")
    try:
        if path.resolve(strict=True) != path:
            raise Refused(f"DINO-WM directory path is not canonical: {path}")
    except OSError as exc:
        raise Refused(f"DINO-WM directory cannot be resolved: {path}: {exc}") from exc


def reject_dinowm_undeclared_artifacts(artifact_dir: Path) -> None:
    root_files = {
        "EVALUATION_COMPLETE.json",
        "HARDWARE_PREFLIGHT.json",
        "compute_apps_after.csv",
        "compute_apps_before.csv",
        "frozen_source.files.sha256",
        "frozen_source.tar",
        "launch_contract.json",
        "nvidia_smi_after.csv",
        "nvidia_smi_before.csv",
        "validator_complete.stdout.json",
        "validator_preflight.stdout.json",
    }
    root_directories = {"frozen_source", "frozen_tools", "replicas"}
    for path in artifact_dir.iterdir():
        if path.name in root_files:
            if path.is_symlink() or not path.is_file():
                raise Refused(f"DINO-WM declared root artifact type drifted: {path}")
        elif path.name in root_directories:
            if path.is_symlink() or not path.is_dir():
                raise Refused(f"DINO-WM declared root directory type drifted: {path}")
        else:
            raise Refused(f"DINO-WM undeclared root artifact exists: {path}")

    replicas_root = artifact_dir / "replicas"
    if not replicas_root.exists():
        return
    replica_files = set(DINO_WM_PUSHT_REPLICA_ARTIFACT_PATHS.values()) | {
        "result.json",
        "validator.stdout.json",
    }
    replica_directories = {
        "cache",
        "home",
        "matplotlib",
        "output",
        "tmp",
        "wandb",
    }
    output_files = {
        "logs.json",
        "plan.log",
        "plan_targets.pkl",
        "plan0.png",
        "output_final.png",
    }
    final_video_pattern = re.compile(
        r"output_final_([0-9]+)_(success|failure)\.mp4"
    )
    outer_video_pattern = re.compile(r"plan0_([0-9]+)_(success|failure)\.mp4")
    outer_plot_pattern = re.compile(r"plan_0_output_([0-9]+)\.png")
    for replica_root in replicas_root.iterdir():
        if replica_root.name not in {"seed99", "seed100"}:
            raise Refused(f"DINO-WM undeclared replica exists: {replica_root}")
        if replica_root.is_symlink() or not replica_root.is_dir():
            raise Refused(f"DINO-WM replica root type drifted: {replica_root}")
        for path in replica_root.iterdir():
            if path.name in replica_files:
                if path.is_symlink() or not path.is_file():
                    raise Refused(
                        f"DINO-WM declared replica artifact type drifted: {path}"
                    )
            elif path.name in replica_directories:
                if path.is_symlink() or not path.is_dir():
                    raise Refused(
                        f"DINO-WM declared replica directory type drifted: {path}"
                    )
            else:
                raise Refused(f"DINO-WM undeclared replica artifact exists: {path}")
        output_root = replica_root / "output"
        if not output_root.exists():
            continue
        observed_final_videos: Dict[int, str] = {}
        observed_outer_videos: Dict[int, str] = {}
        observed_outer_plots: set[int] = set()
        for path in output_root.iterdir():
            if path.name == ".hydra":
                if path.is_symlink() or not path.is_dir():
                    raise Refused(f"DINO-WM Hydra directory type drifted: {path}")
                for hydra_path in path.iterdir():
                    if hydra_path.name not in {
                        "config.yaml",
                        "hydra.yaml",
                        "overrides.yaml",
                    }:
                        raise Refused(
                            f"DINO-WM undeclared Hydra artifact exists: {hydra_path}"
                        )
                    if hydra_path.is_symlink() or not hydra_path.is_file():
                        raise Refused(
                            f"DINO-WM Hydra artifact type drifted: {hydra_path}"
                        )
            elif (
                path.name in output_files
                or final_video_pattern.fullmatch(path.name)
                or outer_video_pattern.fullmatch(path.name)
                or outer_plot_pattern.fullmatch(path.name)
            ):
                if path.is_symlink() or not path.is_file():
                    raise Refused(f"DINO-WM output artifact type drifted: {path}")
                final_video_match = final_video_pattern.fullmatch(path.name)
                outer_video_match = outer_video_pattern.fullmatch(path.name)
                outer_plot_match = outer_plot_pattern.fullmatch(path.name)
                if final_video_match is not None:
                    video_index = int(final_video_match.group(1))
                    if video_index not in range(10):
                        raise Refused(
                            f"DINO-WM rollout-video index drifted: {path}"
                        )
                    if video_index in observed_final_videos:
                        raise Refused(
                            "DINO-WM rollout-video outcome is not mutually "
                            f"exclusive for index {video_index}: {path}"
                        )
                    observed_final_videos[video_index] = final_video_match.group(2)
                elif outer_video_match is not None:
                    video_index = int(outer_video_match.group(1))
                    if video_index not in range(10):
                        raise Refused(f"DINO-WM outer-video index drifted: {path}")
                    if video_index in observed_outer_videos:
                        raise Refused(
                            "DINO-WM outer-video outcome is not mutually "
                            f"exclusive for index {video_index}: {path}"
                        )
                    observed_outer_videos[video_index] = outer_video_match.group(2)
                elif outer_plot_match is not None:
                    plot_index = int(outer_plot_match.group(1))
                    if (
                        plot_index not in range(1, 31)
                        or plot_index in observed_outer_plots
                    ):
                        raise Refused(
                            f"DINO-WM outer-optimization plot index drifted: {path}"
                        )
                    observed_outer_plots.add(plot_index)
            else:
                raise Refused(f"DINO-WM undeclared output artifact exists: {path}")

        if set(observed_final_videos) != set(range(10)):
            raise Refused(
                f"DINO-WM rollout-video inventory drifted: {replica_root}"
            )
        if set(observed_outer_videos) != set(range(10)):
            raise Refused(f"DINO-WM outer-video inventory drifted: {replica_root}")
        if observed_outer_plots != set(range(1, 31)):
            raise Refused(
                f"DINO-WM outer-optimization plot inventory drifted: {replica_root}"
            )

        for scratch_name in replica_directories - {"output"}:
            scratch_root = replica_root / scratch_name
            if not scratch_root.exists():
                continue
            for path in scratch_root.rglob("*"):
                if path.is_symlink() or (not path.is_file() and not path.is_dir()):
                    raise Refused(f"DINO-WM scratch tree contains unsafe path: {path}")


def inspect_dinowm_regular_path(
    path: Path,
    *,
    capture_body: bool,
    max_size_bytes: Optional[int] = None,
) -> Tuple[Optional[bytes], str, int, os.stat_result]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise Refused(f"DINO-WM artifact is unavailable: {path}: {exc}") from exc
    if not stat.S_ISREG(before.st_mode):
        raise Refused(f"DINO-WM artifact is not a regular non-symlink file: {path}")
    if before.st_uid != 2254 or before.st_gid != 2254:
        raise Refused(f"DINO-WM artifact owner drifted: {path}")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise Refused(f"DINO-WM artifact could not be opened: {path}: {exc}") from exc
    digest = hashlib.sha256()
    chunks: Optional[List[bytes]] = [] if capture_body else None
    size_bytes = 0
    try:
        opened = os.fstat(descriptor)
        if (
            opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != 2254
            or opened.st_gid != 2254
        ):
            raise Refused(f"DINO-WM artifact changed while opening: {path}")
        if max_size_bytes is not None and opened.st_size > max_size_bytes:
            raise Refused(f"DINO-WM artifact exceeds size limit: {path}")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            size_bytes += len(chunk)
            if max_size_bytes is not None and size_bytes > max_size_bytes:
                raise Refused(
                    f"DINO-WM artifact exceeds size limit while hashing: {path}"
                )
            if chunks is not None:
                chunks.append(chunk)
        after = os.fstat(descriptor)
        try:
            rebound = path.lstat()
        except OSError as exc:
            raise Refused(
                f"DINO-WM artifact path changed while hashing: {path}: {exc}"
            ) from exc
        if (
            after.st_dev != opened.st_dev
            or after.st_ino != opened.st_ino
            or after.st_size != opened.st_size
            or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns
            or size_bytes != opened.st_size
            or rebound.st_dev != opened.st_dev
            or rebound.st_ino != opened.st_ino
            or rebound.st_size != opened.st_size
            or rebound.st_mtime_ns != opened.st_mtime_ns
            or rebound.st_ctime_ns != opened.st_ctime_ns
        ):
            raise Refused(f"DINO-WM artifact changed while hashing: {path}")
    finally:
        os.close(descriptor)
    body = b"".join(chunks) if chunks is not None else None
    return body, digest.hexdigest(), size_bytes, opened


def verify_dinowm_frozen_runtime_artifacts(
    resolved: Dict[str, Any],
    artifact_dir: Path,
    frozen_runtime: Dict[str, Any],
) -> None:
    evidence = resolved["evidence"]
    launch_contract_path = artifact_dir / "launch_contract.json"
    launch_body, launch_sha, _, launch_metadata = inspect_dinowm_regular_path(
        launch_contract_path,
        capture_body=True,
        max_size_bytes=DINO_WM_MAX_JSON_BYTES,
    )
    if stat.S_IMODE(launch_metadata.st_mode) != 0o600 or launch_body is None:
        raise Refused("DINO-WM launch contract mode or content drifted")
    try:
        launch_contract = json.loads(launch_body)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("DINO-WM launch contract is not valid JSON") from exc
    expected_launch_contract = {
        "schema": "dinowm.pusht.dual_seed_launch_contract.v3",
        "run_id": resolved["run_id"],
        "nonce": resolved["runtime"]["canary_nonce"],
        "uid": 2254,
        "gid": 2254,
        "worker_gpu_count": 2,
        "execution_order": ["seed99_gpu0", "seed100_gpu1"],
        "execution_mode": (
            "sequential_to_preserve_the_official_50_env_memory_contract"
        ),
        "replica_write_scope": (
            "home_tmp_cache_wandb_matplotlib_and_outputs_under_each_replica"
        ),
        "hydra_job_chdir": True,
        "paper_budget_contract": DINO_WM_PUSHT_PAPER_BUDGET_CONTRACT,
        "gpu_execution_binding_contract": (
            DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT
        ),
        "model_asset_download_modes": {
            "hf_hub_offline": True,
            "transformers_offline": True,
            "torch_hub_network_forbidden": True,
            "torch_hub_exact_cache_only": True,
        },
        "source_commit": evidence["source_commit"],
        "source_tree": evidence["source_tree"],
        **frozen_runtime,
        "checkpoint_sha256": evidence["checkpoint_sha256"],
        "checkpoint_hydra_sha256": evidence["checkpoint_hydra_sha256"],
        "runtime_inputs": DINO_WM_PUSHT_RUNTIME_INPUTS,
        "launcher_sha256": evidence["launcher_sha256"],
        "wandb_mode": "disabled_no_service_run_disabled_adapter_v1",
        "pai_probe_created": False,
        "accepted": False,
    }
    if launch_contract != expected_launch_contract:
        raise Refused("DINO-WM persisted launch contract drifted")
    if launch_sha != sha256_bytes(launch_body):
        raise Refused("DINO-WM launch contract changed while validating")

    fixed_files = {
        "frozen_source_tar": (
            artifact_dir / "frozen_source.tar",
            frozen_runtime["frozen_source_tar_sha256"],
            0o600,
        ),
        "frozen_source_manifest": (
            artifact_dir / "frozen_source.files.sha256",
            frozen_runtime["frozen_source_manifest_sha256"],
            0o600,
        ),
        "frozen_entry": (
            artifact_dir
            / "frozen_tools"
            / "dinowm_pusht_official_eval_entry.py",
            frozen_runtime["frozen_entry_sha256"],
            0o500,
        ),
        "frozen_validator": (
            artifact_dir
            / "frozen_tools"
            / "validate_dinowm_pusht_official_eval.py",
            frozen_runtime["frozen_validator_sha256"],
            0o500,
        ),
    }
    fixed_bodies: Dict[str, bytes] = {}
    for role, (path, expected_sha, expected_mode) in fixed_files.items():
        capture = role == "frozen_source_manifest"
        observed_body, observed_sha, size_bytes, metadata = (
            inspect_dinowm_regular_path(
                path,
                capture_body=capture,
                max_size_bytes=(
                    DINO_WM_MAX_MANIFEST_BYTES
                    if role == "frozen_source_manifest"
                    else (
                        DINO_WM_MAX_SMALL_ARTIFACT_BYTES
                        if role in {"frozen_entry", "frozen_validator"}
                        else None
                    )
                ),
            )
        )
        if observed_sha != expected_sha:
            raise Refused(f"DINO-WM persisted {role} hash drifted")
        if size_bytes <= 0:
            raise Refused(f"DINO-WM persisted {role} is empty")
        if stat.S_IMODE(metadata.st_mode) != expected_mode:
            raise Refused(f"DINO-WM persisted {role} mode drifted")
        if observed_body is not None:
            fixed_bodies[role] = observed_body

    frozen_tools = artifact_dir / "frozen_tools"
    require_dinowm_private_directory(frozen_tools)
    expected_tool_names = {
        "dinowm_pusht_official_eval_entry.py",
        "validate_dinowm_pusht_official_eval.py",
    }
    if {path.name for path in frozen_tools.iterdir()} != expected_tool_names:
        raise Refused("DINO-WM frozen tool file set drifted")

    manifest_body = fixed_bodies.get("frozen_source_manifest")
    if manifest_body is None:
        raise Refused("DINO-WM frozen source manifest was not captured")
    try:
        manifest_text = manifest_body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM frozen source manifest is not UTF-8") from exc
    expected_files: Dict[Path, str] = {}
    for line_number, line in enumerate(manifest_text.splitlines(), start=1):
        match = re.fullmatch(r"([a-f0-9]{64})  (\./[^\\\r\n]+)", line)
        if match is None:
            raise Refused(
                f"DINO-WM frozen source manifest line {line_number} is malformed"
            )
        relative = Path(match.group(2)[2:])
        if relative.is_absolute() or ".." in relative.parts or relative in expected_files:
            raise Refused("DINO-WM frozen source manifest path is unsafe or duplicate")
        expected_files[relative] = match.group(1)
    if len(expected_files) != frozen_runtime["frozen_source_file_count"]:
        raise Refused("DINO-WM frozen source manifest file count drifted")

    source_root = artifact_dir / "frozen_source"
    require_dinowm_private_directory(source_root)
    observed_files: set[Path] = set()
    for path in source_root.rglob("*"):
        if path.is_symlink():
            raise Refused("DINO-WM frozen source contains a symlink")
        if path.is_dir():
            require_dinowm_private_directory(path)
            continue
        if not path.is_file():
            raise Refused("DINO-WM frozen source contains a special file")
        relative = path.relative_to(source_root)
        observed_files.add(relative)
        _, observed_sha, size_bytes, metadata = inspect_dinowm_regular_path(
            path, capture_body=False
        )
        if observed_sha != expected_files.get(relative):
            raise Refused(f"DINO-WM frozen source file hash drifted: {relative}")
        if stat.S_IMODE(metadata.st_mode) not in {0o600, 0o700}:
            raise Refused(f"DINO-WM frozen source file mode drifted: {relative}")
    if observed_files != set(expected_files):
        raise Refused("DINO-WM frozen source file set differs from its manifest")


def parse_dinowm_gpu_inventory(body: bytes, label: str) -> Dict[str, Dict[str, str]]:
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"DINO-WM {label} GPU inventory is not UTF-8") from exc
    rows = list(csv.reader(io.StringIO(text), skipinitialspace=True))
    if len(rows) != 2 or any(len(row) != 7 for row in rows):
        raise Refused(f"DINO-WM {label} GPU inventory must contain two rows")
    inventory: Dict[str, Dict[str, str]] = {}
    for row in rows:
        index, uuid, name, total, used, free, utilization = (
            field.strip() for field in row
        )
        if index not in {"0", "1"} or index in inventory:
            raise Refused(f"DINO-WM {label} GPU inventory index set drifted")
        require_dinowm_gpu_uuid(uuid, f"{label} inventory")
        if "A800" not in name.upper():
            raise Refused(f"DINO-WM {label} GPU identity is not an A800")
        try:
            total_int = int(total)
            used_int = int(used)
            free_int = int(free)
            utilization_int = int(utilization)
        except ValueError as exc:
            raise Refused(f"DINO-WM {label} GPU inventory is malformed") from exc
        if (
            total_int < 75_000
            or used_int < 0
            or free_int < 0
            or not 0 <= utilization_int <= 100
        ):
            raise Refused(f"DINO-WM {label} GPU capacity field is invalid")
        inventory[index] = {
            "uuid": uuid,
            "name": name,
            "memory_total_mib": str(total_int),
        }
    if len({row["uuid"] for row in inventory.values()}) != 2:
        raise Refused(f"DINO-WM {label} GPU inventory UUIDs are not unique")
    return inventory


def parse_dinowm_metric_log(body: bytes, label: str) -> Tuple[float, float]:
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"DINO-WM {label} metric log is not UTF-8") from exc
    metric_rows: List[Dict[str, Any]] = []
    for line_number, line in enumerate(text.splitlines(), start=1):
        if not line.strip():
            continue
        if len(line) > DINO_WM_MAX_LOG_LINE_CHARS:
            raise Refused(
                f"DINO-WM {label} metric log line {line_number} is too large"
            )
        try:
            row = json.loads(line)
        except json.JSONDecodeError as exc:
            raise Refused(
                f"DINO-WM {label} metric log line {line_number} is malformed"
            ) from exc
        if not isinstance(row, dict):
            raise Refused(f"DINO-WM {label} metric log row is not an object")
        metric_rows.append(row)
    if len(metric_rows) != 2:
        raise Refused(
            f"DINO-WM {label} metric log must have one outer and one final row"
        )
    outer_rows = [row for row in metric_rows if "mpc/success_rate" in row]
    final_rows = [row for row in metric_rows if "final_eval/success_rate" in row]
    if (
        len(outer_rows) != 1
        or type(outer_rows[0].get("step")) is not int
        or outer_rows[0].get("step") != 1
    ):
        raise Refused(
            f"DINO-WM {label} metric log must have one paper-budget outer iteration"
        )
    if len(final_rows) != 1 or outer_rows[0] is final_rows[0]:
        raise Refused(f"DINO-WM {label} metric log must have one final metric")
    metric = final_rows[0]["final_eval/success_rate"]
    outer_metric = outer_rows[0]["mpc/success_rate"]
    if (
        type(metric) not in (int, float)
        or type(outer_metric) not in (int, float)
        or not 0.0 <= metric <= 1.0
        or not 0.0 <= outer_metric <= 1.0
    ):
        raise Refused(f"DINO-WM {label} metric is not numeric in [0,1]")
    return float(outer_metric), float(metric)


def parse_dinowm_json_body(body: bytes, label: str) -> Dict[str, Any]:
    try:
        value = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused(f"DINO-WM {label} is not valid JSON") from exc
    if not isinstance(value, dict):
        raise Refused(f"DINO-WM {label} must be a JSON object")
    return value


def require_dinowm_gpu_uuid(value: Any, label: str) -> str:
    if not isinstance(value, str) or DINO_WM_GPU_UUID_RE.fullmatch(value) is None:
        raise Refused(f"DINO-WM {label} GPU UUID is not canonical")
    return value


def validate_dinowm_runtime_library_witness(value: Any, label: str) -> None:
    if not isinstance(value, dict) or set(value) != {
        "schema",
        "ld_preload",
        "ld_library_path_first",
        "libraries",
    }:
        raise Refused(f"DINO-WM {label} runtime library witness schema drifted")
    if (
        value.get("schema") != "dinowm.runtime_loader_witness.v1"
        or value.get("ld_preload") != DINO_WM_RUNTIME_LIBRARY_PRELOAD
        or value.get("ld_library_path_first")
        != str(DINO_WM_RUNTIME_LIBRARY_ROOT)
    ):
        raise Refused(f"DINO-WM {label} runtime loader environment drifted")
    libraries = value.get("libraries")
    if not isinstance(libraries, dict) or set(libraries) != set(
        DINO_WM_RUNTIME_LIBRARY_SPECS
    ):
        raise Refused(f"DINO-WM {label} runtime library set drifted")
    for soname, specification in DINO_WM_RUNTIME_LIBRARY_SPECS.items():
        path = Path(str(specification["path"]))
        try:
            metadata = path.lstat()
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(
                f"DINO-WM {label} runtime library is unavailable: {path}: {exc}"
            ) from exc
        if (
            not stat.S_ISREG(metadata.st_mode)
            or path.is_symlink()
            or canonical != path
            or metadata.st_uid != 2254
            or metadata.st_gid != 2254
            or stat.S_IMODE(metadata.st_mode) != 0o555
            or sha256(path) != specification["sha256"]
        ):
            raise Refused(f"DINO-WM {label} runtime library metadata drifted")
        observed = libraries.get(soname)
        expected_stable = {
            "requested_soname": soname,
            "symbol": specification["symbol"],
            "path": str(path),
            "dladdr_realpath": str(path),
            "mapped_paths": [str(path)],
            "sha256": specification["sha256"],
            "uid": 2254,
            "gid": 2254,
            "mode": "0555",
        }
        if (
            not isinstance(observed, dict)
            or set(observed) != {*expected_stable, "device", "inode"}
            or any(observed.get(key) != value for key, value in expected_stable.items())
            or re.fullmatch(
                r"[0-9a-f]{2,}:[0-9a-f]{2,}", str(observed.get("device", ""))
            )
            is None
            or type(observed.get("inode")) is not int
            or observed.get("inode", 0) <= 0
        ):
            raise Refused(f"DINO-WM {label} runtime library mapping drifted")


def dinowm_opencv_assets_witness(label: str) -> Dict[str, Any]:
    assets: Dict[str, Any] = {}
    for name, specification in DINO_WM_OPENCV_ASSET_SPECS.items():
        path = Path(str(specification["path"]))
        try:
            metadata = path.lstat()
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(
                f"DINO-WM {label} pinned OpenCV asset is unavailable: {path}"
            ) from exc
        expected_size = specification["size"]
        expected_mode = int(specification["mode"])
        if (
            not stat.S_ISREG(metadata.st_mode)
            or path.is_symlink()
            or canonical != path
            or metadata.st_uid != 2254
            or metadata.st_gid != 2254
            or stat.S_IMODE(metadata.st_mode) != expected_mode
            or (expected_size is not None and metadata.st_size != expected_size)
            or sha256(path) != specification["sha256"]
        ):
            raise Refused(f"DINO-WM {label} pinned OpenCV asset drifted: {path}")
        assets[name] = {
            "path": str(path),
            "sha256": specification["sha256"],
            "uid": 2254,
            "gid": 2254,
            "mode": f"{expected_mode:04o}",
            "size_bytes": metadata.st_size,
            "regular_file": True,
            "symlink": False,
        }
    return assets


def validate_dinowm_runtime_environment_mutation(value: Any, label: str) -> None:
    prepend = Path(DINO_WM_OPENCV_LD_LIBRARY_PATH_PREPEND)
    normalized = Path(DINO_WM_OPENCV_LD_LIBRARY_PATH_PREPEND_NORMALIZED)
    if (
        prepend.exists()
        or prepend.is_symlink()
        or normalized.exists()
        or normalized.is_symlink()
    ):
        raise Refused(f"DINO-WM {label} pinned OpenCV prepend path exists")
    assets = dinowm_opencv_assets_witness(label)
    expected_mutated = (
        f"{DINO_WM_OPENCV_LD_LIBRARY_PATH_PREPEND}:"
        f"{DINO_WM_EXPECTED_LD_LIBRARY_PATH}"
    )
    expected = {
        "schema": "dinowm.opencv_runtime_environment_adapter.v1",
        "adapter": "import_pinned_cv2_before_official_entry_then_restore",
        "environment_variable": "LD_LIBRARY_PATH",
        "mutation_contract": "exact_single_prepend_then_restore",
        "expected_original_value": DINO_WM_EXPECTED_LD_LIBRARY_PATH,
        "python_original_value": DINO_WM_EXPECTED_LD_LIBRARY_PATH,
        "libc_original_value": DINO_WM_EXPECTED_LD_LIBRARY_PATH,
        "expected_prepend": DINO_WM_OPENCV_LD_LIBRARY_PATH_PREPEND,
        "normalized_prepend_path": (
            DINO_WM_OPENCV_LD_LIBRARY_PATH_PREPEND_NORMALIZED
        ),
        "prepend_path_absent": True,
        "normalized_prepend_path_absent": True,
        "expected_mutated_value": expected_mutated,
        "python_observed_raw_mutated_value": expected_mutated,
        "libc_observed_raw_mutated_value": expected_mutated,
        "prepend_occurrences": 1,
        "expected_ld_preload": DINO_WM_RUNTIME_LIBRARY_PRELOAD,
        "python_ld_preload_before": DINO_WM_RUNTIME_LIBRARY_PRELOAD,
        "libc_ld_preload_before": DINO_WM_RUNTIME_LIBRARY_PRELOAD,
        "python_ld_preload_after_import": DINO_WM_RUNTIME_LIBRARY_PRELOAD,
        "libc_ld_preload_after_import": DINO_WM_RUNTIME_LIBRARY_PRELOAD,
        "cv2_preexisting_before_adapter": False,
        "cv2_imported_before_official_entry": True,
        "cv2_imported_by_adapter": True,
        "cv2_module_file": str(DINO_WM_OPENCV_ASSET_SPECS["cv2_init"]["path"]),
        "opencv_assets_before_adapter_import": assets,
        "opencv_assets_after_adapter_import": assets,
        "opencv_assets_after_official_entry": assets,
        "opencv_assets_stable": True,
        "python_restored_value": DINO_WM_EXPECTED_LD_LIBRARY_PATH,
        "libc_restored_value": DINO_WM_EXPECTED_LD_LIBRARY_PATH,
        "restoration_verified": True,
    }
    if value != expected:
        raise Refused(f"DINO-WM {label} OpenCV adapter witness drifted")


def parse_dinowm_dinov2_manifest(body: bytes) -> Dict[Path, str]:
    if sha256_bytes(body) != DINO_WM_DINOV2_SOURCE_MANIFEST_SHA256:
        raise Refused("DINO-WM pinned DINOv2 source manifest hash drifted")
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM DINOv2 source manifest is not UTF-8") from exc
    expected: Dict[Path, str] = {}
    for line_number, line in enumerate(text.splitlines(), start=1):
        match = re.fullmatch(r"([a-f0-9]{64})  (\./[^\\\r\n]+)", line)
        if match is None:
            raise Refused(
                f"DINO-WM DINOv2 manifest line {line_number} is malformed"
            )
        relative = Path(match.group(2)[2:])
        if relative.is_absolute() or ".." in relative.parts or relative in expected:
            raise Refused("DINO-WM DINOv2 manifest path is unsafe or duplicate")
        expected[relative] = match.group(1)
    if len(expected) != DINO_WM_DINOV2_SOURCE_FILE_COUNT:
        raise Refused("DINO-WM DINOv2 manifest file count drifted")
    return expected


def verify_dinowm_dinov2_cache(
    replica_root: Path, label: str
) -> Dict[str, Any]:
    torch_home = replica_root / "cache" / "torch"
    hub_root = torch_home / "hub"
    source_root = hub_root / DINO_WM_DINOV2_CACHE_REPO_NAME
    checkpoint = hub_root / "checkpoints" / DINO_WM_DINOV2_WEIGHT_NAME
    cache_manifest = hub_root / DINO_WM_DINOV2_SOURCE_MANIFEST.name
    trusted_list = hub_root / "trusted_list"
    expected_root_entries = {
        DINO_WM_DINOV2_CACHE_REPO_NAME,
        "checkpoints",
        DINO_WM_DINOV2_SOURCE_MANIFEST.name,
        "trusted_list",
    }
    try:
        observed_root_entries = {path.name for path in hub_root.iterdir()}
    except OSError as exc:
        raise Refused(f"DINO-WM {label} cannot inspect DINOv2 cache") from exc
    if observed_root_entries != expected_root_entries:
        raise Refused(f"DINO-WM {label} DINOv2 cache root file set drifted")
    for directory in (torch_home, hub_root, source_root, hub_root / "checkpoints"):
        require_dinowm_private_directory(directory, exact_mode=0o500)
    manifest_body, manifest_sha, _, manifest_metadata = inspect_dinowm_regular_path(
        cache_manifest,
        capture_body=True,
        max_size_bytes=DINO_WM_MAX_MANIFEST_BYTES,
    )
    if (
        manifest_body is None
        or manifest_sha != DINO_WM_DINOV2_SOURCE_MANIFEST_SHA256
        or stat.S_IMODE(manifest_metadata.st_mode) != 0o400
    ):
        raise Refused(f"DINO-WM {label} DINOv2 cache manifest drifted")
    expected_files = parse_dinowm_dinov2_manifest(manifest_body)
    observed_files: set[Path] = set()
    for path in source_root.rglob("*"):
        if path.is_symlink():
            raise Refused(f"DINO-WM {label} DINOv2 source contains a symlink")
        if path.is_dir():
            require_dinowm_private_directory(path, exact_mode=0o500)
            continue
        _, observed_sha, _, metadata = inspect_dinowm_regular_path(
            path, capture_body=False
        )
        if stat.S_IMODE(metadata.st_mode) != 0o400:
            raise Refused(f"DINO-WM {label} DINOv2 source file mode drifted")
        relative = path.relative_to(source_root)
        observed_files.add(relative)
        if expected_files.get(relative) != observed_sha:
            raise Refused(f"DINO-WM {label} DINOv2 source hash drifted: {relative}")
    if observed_files != set(expected_files):
        raise Refused(f"DINO-WM {label} DINOv2 source file set drifted")
    trusted_body, _, _, trusted_metadata = inspect_dinowm_regular_path(
        trusted_list, capture_body=True, max_size_bytes=1
    )
    if trusted_body != b"" or stat.S_IMODE(trusted_metadata.st_mode) != 0o400:
        raise Refused(f"DINO-WM {label} DINOv2 trusted-list drifted")
    _, checkpoint_sha, checkpoint_size, checkpoint_metadata = (
        inspect_dinowm_regular_path(checkpoint, capture_body=False)
    )
    if (
        stat.S_IMODE(checkpoint_metadata.st_mode) != 0o400
        or checkpoint_size != DINO_WM_DINOV2_WEIGHT_SIZE
        or checkpoint_sha != DINO_WM_DINOV2_WEIGHT_SHA256
    ):
        raise Refused(f"DINO-WM {label} DINOv2 checkpoint drifted")
    return {
        "torch_home": str(torch_home),
        "hub_root": str(hub_root),
        "source_cache": str(source_root),
        "checkpoint_cache": str(checkpoint),
        "source_manifest_sha256": DINO_WM_DINOV2_SOURCE_MANIFEST_SHA256,
        "source_file_count": len(observed_files),
        "weight_sha256": DINO_WM_DINOV2_WEIGHT_SHA256,
        "weight_size_bytes": checkpoint_size,
        "trusted_list_empty": True,
    }


def verify_dinowm_cuda_runtime_witness(
    witness: Dict[str, Any],
    replica_root: Path,
    artifact_dir: Path,
    label: str,
) -> None:
    expected_keys = {
        "schema",
        "pid",
        "uid",
        "gid",
        "cuda_available",
        "visible_cuda_device_count",
        "cuda_device_name",
        "cuda_visible_devices",
        "expected_gpu_uuid",
        "cuda_device_uuid_pre",
        "cuda_device_uuid_post",
        "cuda_max_memory_allocated_bytes",
        "cuda_context_ready_monotonic_ns",
        "entry_finished_monotonic_ns",
        "checkpoint_path",
        "checkpoint_sha256",
        "official_repo",
        "pinned_source_repo",
        "process_identity_pre",
        "process_identity_post",
        "runtime_library_witness_boot",
        "runtime_library_witness_pre",
        "runtime_library_witness_post",
        "runtime_environment_mutation",
        "wandb_disabled_adapter",
        "dinov2_offline_hub_adapter",
    }
    if set(witness) != expected_keys:
        raise Refused(f"DINO-WM {label} CUDA runtime witness schema drifted")
    if witness.get("schema") != "dinowm.pusht.cuda_witness.v5":
        raise Refused(f"DINO-WM {label} CUDA witness schema drifted")
    if witness.get("uid") != 2254 or witness.get("gid") != 2254:
        raise Refused(f"DINO-WM {label} CUDA witness owner identity drifted")
    if (
        witness.get("checkpoint_sha256")
        != "e909f0cec958fc0b49a79f2e85730ae6b5f83dee61a224705f91883eb3bb74c5"
        or witness.get("checkpoint_path") != DINO_WM_PUSHT_CHECKPOINT_PATH
        or witness.get("official_repo") != str(artifact_dir / "frozen_source")
        or witness.get("pinned_source_repo") != DINO_WM_PUSHT_OFFICIAL_REPO
    ):
        raise Refused(f"DINO-WM {label} frozen runtime/checkpoint witness drifted")
    runtime_boot = witness.get("runtime_library_witness_boot")
    runtime_pre = witness.get("runtime_library_witness_pre")
    if (
        runtime_boot != runtime_pre
        or runtime_pre != witness.get("runtime_library_witness_post")
    ):
        raise Refused(f"DINO-WM {label} runtime library witness changed")
    validate_dinowm_runtime_library_witness(runtime_pre, label)
    validate_dinowm_runtime_environment_mutation(
        witness.get("runtime_environment_mutation"), label
    )
    if witness.get("wandb_disabled_adapter") != DINO_WM_WANDB_DISABLED_ADAPTER:
        raise Refused(f"DINO-WM {label} W&B-disabled witness drifted")
    cache = verify_dinowm_dinov2_cache(replica_root, label)
    expected_adapter = {
        **DINO_WM_DINOV2_HUB_ADAPTER_BASE,
        "cache_pre": cache,
        "cache_post": cache,
    }
    if witness.get("dinov2_offline_hub_adapter") != expected_adapter:
        raise Refused(f"DINO-WM {label} DINOv2 offline-hub witness drifted")


def parse_dinowm_hydra_config(
    body: bytes, label: str, seed: int
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"DINO-WM {label} Hydra config is not UTF-8") from exc
    try:
        import yaml
    except ImportError as exc:
        raise Refused("DINO-WM controller requires the pinned PyYAML parser") from exc

    class UniqueKeySafeLoader(yaml.SafeLoader):
        pass

    def construct_unique_mapping(loader: Any, node: Any, deep: bool = False) -> Any:
        if any(getattr(key_node, "value", None) == "<<" for key_node, _ in node.value):
            raise Refused(f"DINO-WM {label} Hydra config forbids merge keys")
        mapping: Dict[Any, Any] = {}
        for key_node, value_node in node.value:
            key = loader.construct_object(key_node, deep=deep)
            if key in mapping:
                raise Refused(f"DINO-WM {label} Hydra config has a duplicate key")
            mapping[key] = loader.construct_object(value_node, deep=deep)
        return mapping

    UniqueKeySafeLoader.add_constructor(
        yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
        construct_unique_mapping,
    )
    try:
        effective = yaml.load(text, Loader=UniqueKeySafeLoader)
    except Refused:
        raise
    except yaml.YAMLError as exc:
        raise Refused(f"DINO-WM {label} Hydra config is malformed") from exc
    expected_effective = {
        **DINO_WM_PUSHT_EXPECTED_EFFECTIVE_CONFIG_BASE,
        "seed": seed,
    }
    if effective != expected_effective:
        raise Refused(f"DINO-WM {label} raw Hydra config drifted")
    compact = {
        "config_name": "plan_pusht.yaml",
        "model_name": effective["model_name"],
        "model_epoch": effective["model_epoch"],
        "ckpt_base_path": str(effective["ckpt_base_path"]),
        "seed": int(effective["seed"]),
        "n_evals": int(effective["n_evals"]),
        "goal_source": effective["goal_source"],
        "goal_H": int(effective["goal_H"]),
        "planner": effective["planner"]["name"],
        "cem_num_samples": int(effective["planner"]["sub_planner"]["num_samples"]),
        "cem_topk": int(effective["planner"]["sub_planner"]["topk"]),
        "cem_opt_steps": int(effective["planner"]["sub_planner"]["opt_steps"]),
        "cem_horizon": int(effective["planner"]["sub_planner"]["horizon"]),
        "cem_var_scale": int(effective["planner"]["sub_planner"]["var_scale"]),
        "cem_eval_every": int(effective["planner"]["sub_planner"]["eval_every"]),
        "planner_target": effective["planner"]["_target_"],
        "cem_target": effective["planner"]["sub_planner"]["target"],
        "planner_max_iter": effective["planner"]["max_iter"],
        "planner_n_taken_actions": int(effective["planner"]["n_taken_actions"]),
        "objective_target": effective["objective"]["_target_"],
        "objective_alpha": int(effective["objective"]["alpha"]),
        "objective_base": int(effective["objective"]["base"]),
        "objective_mode": effective["objective"]["mode"],
        "n_plot_samples": int(effective["n_plot_samples"]),
        "debug_dset_init": bool(effective["debug_dset_init"]),
    }
    return effective, compact


def parse_dinowm_replica_status(body: bytes, label: str) -> Dict[str, str]:
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"DINO-WM {label} status is not UTF-8") from exc
    fields: Dict[str, str] = {}
    for line_number, line in enumerate(text.splitlines(), start=1):
        if not line or line.count("=") != 1:
            raise Refused(
                f"DINO-WM {label} status line {line_number} is malformed"
            )
        key, value = line.split("=", 1)
        if not key or key in fields:
            raise Refused(f"DINO-WM {label} status key is empty or duplicate")
        fields[key] = value
    expected_keys = {
        "schema",
        "final_status",
        "exit_code",
        "label",
        "seed",
        "gpu_index",
        "gpu_uuid",
        "gpu_execution_binding_verified",
        "gpu_execution_binding_mode",
        "process_group_leaked",
        "source_clean",
        "checkpoint_unchanged",
        "runtime_tools_unchanged",
        "runtime_inputs_unchanged",
        "dinov2_cache_unchanged",
        "process_identity_stable",
        "compute_queries_succeeded",
        "pre_compute_inventory_empty",
        "post_compute_inventory_empty",
        "finished_at",
        "external_processes_modified",
    }
    if set(fields) != expected_keys:
        raise Refused(f"DINO-WM {label} status schema drifted")
    try:
        finished_at = datetime.fromisoformat(fields["finished_at"])
    except ValueError as exc:
        raise Refused(f"DINO-WM {label} status timestamp is malformed") from exc
    if finished_at.tzinfo is None:
        raise Refused(f"DINO-WM {label} status timestamp lacks timezone")
    return fields


def validate_dinowm_linux_process_identity(
    value: Any, label: str
) -> Dict[str, Any]:
    expected_keys = {
        "schema",
        "pid",
        "nspid_visible",
        "nspid_scope",
        "pgrp",
        "session",
        "starttime_ticks",
    }
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise Refused(f"DINO-WM {label} process identity schema drifted")
    nspid = value.get("nspid_visible")
    pid = value.get("pid")
    if (
        value.get("schema") != "dinowm.linux_process_identity.v2"
        or not isinstance(nspid, list)
        or not nspid
        or any(type(pid) is not int or pid <= 1 for pid in nspid)
        or type(pid) is not int
        or nspid[-1] != pid
        or value.get("nspid_scope") != "current_procfs_mount_only"
        or value.get("pgrp") != pid
        or value.get("session") != pid
        or type(value.get("starttime_ticks")) is not int
        or value.get("starttime_ticks", 0) <= 0
    ):
        raise Refused(f"DINO-WM {label} process identity is invalid")
    return value


def verify_dinowm_replica_gpu_execution_binding(
    replica: Dict[str, Any],
    bodies: Dict[str, bytes],
    label: str,
    seed: int,
    gpu_index: int,
    gpu_uuid: str,
) -> None:
    status = parse_dinowm_replica_status(bodies["completed_status"], label)
    expected_status = {
        "schema": "dinowm.pusht.replica_status.v2",
        "final_status": "COMPLETED",
        "exit_code": "0",
        "label": label,
        "seed": str(seed),
        "gpu_index": str(gpu_index),
        "gpu_uuid": gpu_uuid,
        "gpu_execution_binding_verified": "true",
        "gpu_execution_binding_mode": DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT[
            "mode"
        ],
        "process_group_leaked": "false",
        "source_clean": "true",
        "checkpoint_unchanged": "true",
        "runtime_tools_unchanged": "true",
        "runtime_inputs_unchanged": "true",
        "dinov2_cache_unchanged": "true",
        "process_identity_stable": "true",
        "compute_queries_succeeded": "true",
        "pre_compute_inventory_empty": "true",
        "post_compute_inventory_empty": "true",
        "external_processes_modified": "false",
    }
    for key, expected_value in expected_status.items():
        if status.get(key) != expected_value:
            raise Refused(f"DINO-WM {label} status field drifted: {key}")

    try:
        launcher_pid = int(bodies["launcher_pid"].decode("utf-8").strip())
    except (UnicodeDecodeError, ValueError) as exc:
        raise Refused(f"DINO-WM {label} launcher PID is malformed") from exc
    identity = validate_dinowm_linux_process_identity(
        parse_dinowm_json_body(bodies["process_identity_start"], f"{label} identity"),
        label,
    )
    if launcher_pid <= 1 or identity["pid"] != launcher_pid:
        raise Refused(f"DINO-WM {label} launcher/process identity mismatch")

    if bodies["compute_apps_pre"] or bodies["compute_apps_post"]:
        raise Refused(f"DINO-WM {label} pre/post compute inventory is not empty")
    try:
        during_text = bodies["compute_apps_during"].decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"DINO-WM {label} compute inventory is not UTF-8") from exc
    rows = list(csv.reader(io.StringIO(during_text), skipinitialspace=True))
    if len(rows) != 1 or len(rows[0]) != 4:
        raise Refused(
            f"DINO-WM {label} compute inventory must contain exactly one row"
        )
    observed_uuid, driver_pid_text, process_name, memory_text = (
        field.strip() for field in rows[0]
    )
    require_dinowm_gpu_uuid(observed_uuid, f"{label} compute inventory")
    try:
        driver_pid = int(driver_pid_text)
        used_memory_mib = int(memory_text)
    except ValueError as exc:
        raise Refused(f"DINO-WM {label} compute inventory is malformed") from exc
    if (
        observed_uuid != gpu_uuid
        or driver_pid <= 1
        or not process_name
        or used_memory_mib
        < DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT[
            "minimum_during_used_memory_mib"
        ]
    ):
        raise Refused(f"DINO-WM {label} exclusive compute witness drifted")

    binding = parse_dinowm_json_body(
        bodies["gpu_execution_binding"], f"{label} GPU execution binding"
    )
    expected_binding_keys = {
        "schema",
        "contract",
        "query_started_monotonic_ns",
        "query_finished_monotonic_ns",
        "gpu_uuid",
        "driver_reported_pid",
        "process_name",
        "used_memory_mib",
        "container_process_identity",
        "launcher_pid",
        "entry_process_identity_verified_before_and_after_observation",
        "pre_compute_inventory_sha256",
        "during_compute_inventory_sha256",
        "post_compute_inventory_sha256",
    }
    if set(binding) != expected_binding_keys:
        raise Refused(f"DINO-WM {label} GPU execution binding schema drifted")
    query_started = binding.get("query_started_monotonic_ns")
    query_finished = binding.get("query_finished_monotonic_ns")
    if (
        type(query_started) is not int
        or type(query_finished) is not int
        or query_started <= 0
        or query_finished < query_started
    ):
        raise Refused(f"DINO-WM {label} GPU query monotonic bracket is invalid")
    expected_binding = {
        "schema": "dinowm.pusht.gpu_execution_binding_evidence.v1",
        "contract": DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT,
        "query_started_monotonic_ns": query_started,
        "query_finished_monotonic_ns": query_finished,
        "gpu_uuid": gpu_uuid,
        "driver_reported_pid": driver_pid,
        "process_name": process_name,
        "used_memory_mib": used_memory_mib,
        "container_process_identity": identity,
        "launcher_pid": launcher_pid,
        "entry_process_identity_verified_before_and_after_observation": True,
        "pre_compute_inventory_sha256": sha256_bytes(bodies["compute_apps_pre"]),
        "during_compute_inventory_sha256": sha256_bytes(
            bodies["compute_apps_during"]
        ),
        "post_compute_inventory_sha256": sha256_bytes(
            bodies["compute_apps_post"]
        ),
    }
    for key, expected_value in expected_binding.items():
        if binding.get(key) != expected_value:
            raise Refused(f"DINO-WM {label} GPU execution binding field drifted: {key}")
    if replica.get("gpu_execution_binding") != binding:
        raise Refused(f"DINO-WM {label} GPU execution binding/result mismatch")

    cuda_witness = parse_dinowm_json_body(
        bodies["cuda_witness"], f"{label} CUDA witness"
    )
    cuda_ready_witness = parse_dinowm_json_body(
        bodies["cuda_ready_witness"], f"{label} CUDA-ready witness"
    )
    if (
        cuda_witness.get("schema") != "dinowm.pusht.cuda_witness.v5"
        or cuda_witness.get("pid") != launcher_pid
        or cuda_witness.get("visible_cuda_device_count") != 1
        or cuda_witness.get("cuda_visible_devices") != gpu_uuid
        or cuda_witness.get("expected_gpu_uuid") != gpu_uuid
        or cuda_witness.get("cuda_device_uuid_pre") != gpu_uuid
        or cuda_witness.get("cuda_device_uuid_post") != gpu_uuid
        or cuda_witness.get("cuda_available") is not True
        or "A800" not in str(cuda_witness.get("cuda_device_name", "")).upper()
        or type(cuda_witness.get("cuda_max_memory_allocated_bytes")) is not int
        or cuda_witness.get("cuda_max_memory_allocated_bytes", 0)
        < DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT[
            "minimum_cuda_peak_allocated_bytes"
        ]
        or cuda_witness.get("process_identity_pre") != identity
        or cuda_witness.get("process_identity_post") != identity
    ):
        raise Refused(f"DINO-WM {label} CUDA/process binding cross-check drifted")
    cuda_ready = cuda_witness.get("cuda_context_ready_monotonic_ns")
    entry_finished = cuda_witness.get("entry_finished_monotonic_ns")
    expected_ready_witness = {
        "schema": "dinowm.pusht.cuda_ready_witness.v1",
        "pid": launcher_pid,
        "expected_gpu_uuid": gpu_uuid,
        "cuda_device_uuid": gpu_uuid,
        "cuda_context_ready_monotonic_ns": cuda_ready,
        "process_identity": identity,
    }
    if cuda_ready_witness != expected_ready_witness:
        raise Refused(f"DINO-WM {label} CUDA-ready witness drifted")
    if (
        type(cuda_ready) is not int
        or type(entry_finished) is not int
        or cuda_ready <= 0
        or not cuda_ready <= query_started <= query_finished <= entry_finished
    ):
        raise Refused(f"DINO-WM {label} GPU/process temporal overlap is invalid")


def verify_dinowm_completed_artifact(resolved: Dict[str, Any]) -> Dict[str, Any]:
    evidence = resolved.get("evidence", {})
    artifact_dir = Path(str(resolved.get("artifact_dir", "")))
    expected_path = artifact_dir / "EVALUATION_COMPLETE.json"
    declared_path = Path(str(evidence.get("completed_evidence_path", "")))
    if declared_path != expected_path:
        raise Refused("DINO-WM completed evidence path drifted from artifact_dir")
    if not expected_path.exists() and not expected_path.is_symlink():
        return {
            "path": str(expected_path),
            "exists": False,
            "complete": False,
        }
    try:
        if artifact_dir.resolve(strict=True) != artifact_dir:
            raise Refused("DINO-WM artifact directory is not canonical")
    except OSError as exc:
        raise Refused(f"DINO-WM artifact directory is unavailable: {exc}") from exc
    require_dinowm_private_directory(artifact_dir)
    reject_dinowm_undeclared_artifacts(artifact_dir)
    body, metadata = read_regular_path(
        expected_path, max_size_bytes=DINO_WM_MAX_JSON_BYTES
    )
    if metadata.st_uid != 2254 or metadata.st_gid != 2254:
        raise Refused("DINO-WM completed evidence is not owned by 2254:2254")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise Refused("DINO-WM completed evidence must be mode 0600")
    try:
        payload = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("DINO-WM completed evidence is not valid JSON") from exc
    if not isinstance(payload, dict):
        raise Refused("DINO-WM completed evidence must be a JSON object")
    expected_top_level_keys = {
        "schema",
        "status",
        "run_id",
        "nonce",
        "source_commit",
        "source_tree",
        "checkpoint_sha256",
        "checkpoint_hydra_sha256",
        "launcher_sha256",
        "cuda_entry_wrapper_sha256",
        "artifact_validator_sha256",
        "runtime_inputs",
        "paper_budget_contract",
        "gpu_execution_binding_contract",
        "frozen_runtime",
        "official_seed99_execution_completed",
        "paper_reported_success_rate",
        "paper_metric_comparison",
        "gpu_inventory",
        "hardware_artifacts",
        "replicas",
        "aggregate",
        "experiment_role",
        "accepted",
        "evidence_boundary",
    }
    if set(payload) != expected_top_level_keys:
        raise Refused("DINO-WM completed evidence top-level schema drifted")
    expected = {
        "schema": "dinowm.pusht.official_source_dual_seed_pai_evaluation.v3",
        "status": "COMPLETED_VERIFIED",
        "run_id": resolved["run_id"],
        "nonce": resolved["runtime"]["canary_nonce"],
        "source_commit": evidence["source_commit"],
        "source_tree": evidence["source_tree"],
        "checkpoint_sha256": evidence["checkpoint_sha256"],
        "checkpoint_hydra_sha256": evidence["checkpoint_hydra_sha256"],
        "launcher_sha256": evidence["launcher_sha256"],
        "cuda_entry_wrapper_sha256": evidence["cuda_entry_wrapper_sha256"],
        "artifact_validator_sha256": evidence["artifact_validator_sha256"],
        "runtime_inputs": DINO_WM_PUSHT_RUNTIME_INPUTS,
        "paper_budget_contract": DINO_WM_PUSHT_PAPER_BUDGET_CONTRACT,
        "gpu_execution_binding_contract": (
            DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT
        ),
        "official_seed99_execution_completed": True,
        "paper_reported_success_rate": evidence["reported_reference_success_rate"],
        "experiment_role": evidence["experiment_role"],
        "accepted": False,
        "evidence_boundary": evidence["evidence_boundary"],
    }
    for key, value in expected.items():
        if payload.get(key) != value:
            raise Refused(f"DINO-WM completed evidence field drifted: {key}")
    if (
        evidence["experiment_role"] != DINO_WM_PUSHT_EXPERIMENT_ROLE
        or evidence["evidence_boundary"] != DINO_WM_PUSHT_EVIDENCE_BOUNDARY
    ):
        raise Refused("DINO-WM completed baseline evidence boundary drifted")
    expected_frozen_runtime = {
        "source_execution": "run_local_git_archive_exact_commit",
        "frozen_source_tar_sha256": evidence["frozen_source_tar_sha256"],
        "frozen_source_manifest_sha256": evidence[
            "frozen_source_manifest_sha256"
        ],
        "frozen_source_file_count": evidence["frozen_source_file_count"],
        "frozen_entry_sha256": evidence["cuda_entry_wrapper_sha256"],
        "frozen_validator_sha256": evidence["artifact_validator_sha256"],
    }
    if payload.get("frozen_runtime") != expected_frozen_runtime:
        raise Refused("DINO-WM completed frozen-runtime witness drifted")
    verify_dinowm_frozen_runtime_artifacts(
        resolved, artifact_dir, expected_frozen_runtime
    )

    hardware_paths = {
        "hardware_preflight": artifact_dir / "HARDWARE_PREFLIGHT.json",
        "nvidia_smi_before": artifact_dir / "nvidia_smi_before.csv",
        "compute_apps_before": artifact_dir / "compute_apps_before.csv",
        "nvidia_smi_after": artifact_dir / "nvidia_smi_after.csv",
        "compute_apps_after": artifact_dir / "compute_apps_after.csv",
    }
    hardware_records = payload.get("hardware_artifacts")
    if not isinstance(hardware_records, dict) or set(hardware_records) != set(
        hardware_paths
    ):
        raise Refused("DINO-WM completed hardware artifact set drifted")
    hardware_bodies: Dict[str, bytes] = {}
    for role, path in hardware_paths.items():
        observed_body, _ = verify_dinowm_artifact_record(
            hardware_records[role],
            path,
            artifact_dir,
            f"hardware/{role}",
            allow_empty=role.startswith("compute_apps"),
            capture_body=True,
            max_size_bytes=DINO_WM_MAX_SMALL_ARTIFACT_BYTES,
        )
        if observed_body is None:
            raise Refused(f"DINO-WM hardware/{role} artifact was not captured")
        hardware_bodies[role] = observed_body
    if hardware_bodies["compute_apps_before"] or hardware_bodies["compute_apps_after"]:
        raise Refused("DINO-WM completed compute-app inventories are not empty")
    before_inventory = parse_dinowm_gpu_inventory(
        hardware_bodies["nvidia_smi_before"], "pre-evaluation"
    )
    after_inventory = parse_dinowm_gpu_inventory(
        hardware_bodies["nvidia_smi_after"], "post-evaluation"
    )
    if before_inventory != after_inventory:
        raise Refused("DINO-WM GPU identity changed across evaluation")
    if payload.get("gpu_inventory") != before_inventory:
        raise Refused("DINO-WM completed GPU inventory payload drifted")
    try:
        preflight_payload = json.loads(hardware_bodies["hardware_preflight"])
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused("DINO-WM pre-seed hardware evidence is not valid JSON") from exc
    expected_preflight = {
        "schema": "dinowm.pusht.preseed_hardware.v1",
        "status": "PRESEED_HARDWARE_VERIFIED",
        "run_id": resolved["run_id"],
        "nonce": resolved["runtime"]["canary_nonce"],
        "gpu_inventory": before_inventory,
        "experiment_role": DINO_WM_PUSHT_EXPERIMENT_ROLE,
        "accepted": False,
    }
    if preflight_payload != expected_preflight:
        raise Refused("DINO-WM pre-seed hardware evidence drifted")

    replicas = payload.get("replicas")
    uuids = [before_inventory[index]["uuid"] for index in ("0", "1")]
    assignments = {"seed99": (99, 0, uuids[0]), "seed100": (100, 1, uuids[1])}
    if not isinstance(replicas, dict) or set(replicas) != set(assignments):
        raise Refused("DINO-WM completed replica set drifted")
    metric_values: List[float] = []
    expected_replica_keys = {
        "schema",
        "status",
        "label",
        "seed",
        "gpu_index",
        "gpu_uuid",
        "n_evals",
        "source_commit",
        "source_tree",
        "checkpoint_sha256",
        "checkpoint_hydra_sha256",
        "launcher_sha256",
        "cuda_entry_wrapper_sha256",
        "runtime_inputs",
        "paper_budget_contract",
        "gpu_execution_binding_contract",
        "gpu_execution_binding",
        "outer_metric",
        "metric",
        "config",
        "effective_config",
        "artifacts",
        "accepted",
        "evidence_boundary",
    }
    for label, (seed, index, uuid) in assignments.items():
        replica = replicas[label]
        if not isinstance(replica, dict) or set(replica) != expected_replica_keys:
            raise Refused(f"DINO-WM completed replica schema drifted: {label}")
        expected_replica = {
            "schema": "dinowm.pusht.replica_result.v3",
            "status": "COMPLETED_VERIFIED",
            "label": label,
            "seed": seed,
            "gpu_index": index,
            "gpu_uuid": uuid,
            "n_evals": 50,
            "source_commit": evidence["source_commit"],
            "source_tree": evidence["source_tree"],
            "checkpoint_sha256": evidence["checkpoint_sha256"],
            "checkpoint_hydra_sha256": evidence["checkpoint_hydra_sha256"],
            "launcher_sha256": evidence["launcher_sha256"],
            "cuda_entry_wrapper_sha256": evidence["cuda_entry_wrapper_sha256"],
            "runtime_inputs": DINO_WM_PUSHT_RUNTIME_INPUTS,
            "paper_budget_contract": DINO_WM_PUSHT_PAPER_BUDGET_CONTRACT,
            "gpu_execution_binding_contract": (
                DINO_WM_PUSHT_GPU_EXECUTION_BINDING_CONTRACT
            ),
            "accepted": False,
            "evidence_boundary": DINO_WM_PUSHT_REPLICA_EVIDENCE_BOUNDARY,
        }
        for key, value in expected_replica.items():
            if replica.get(key) != value:
                raise Refused(f"DINO-WM completed replica field drifted: {label}.{key}")
        metric = replica.get("metric")
        outer_metric = replica.get("outer_metric")
        if not isinstance(metric, dict) or set(metric) != {"name", "value"}:
            raise Refused(f"DINO-WM completed replica metric schema drifted: {label}")
        if (
            not isinstance(outer_metric, dict)
            or set(outer_metric) != {"name", "value"}
            or outer_metric.get("name") != "mpc/success_rate"
        ):
            raise Refused(
                f"DINO-WM completed replica outer metric schema drifted: {label}"
            )
        metric_value = metric.get("value")
        outer_metric_value = outer_metric.get("value")
        if (
            metric.get("name") != "final_eval/success_rate"
            or type(metric_value) not in (int, float)
            or not 0.0 <= metric_value <= 1.0
        ):
            raise Refused(f"DINO-WM completed replica metric drifted: {label}")
        if (
            type(outer_metric_value) not in (int, float)
            or not 0.0 <= outer_metric_value <= 1.0
        ):
            raise Refused(
                f"DINO-WM completed replica outer metric drifted: {label}"
            )
        if replica.get("config") != {**DINO_WM_PUSHT_EXPECTED_CONFIG, "seed": seed}:
            raise Refused(f"DINO-WM completed replica config drifted: {label}")
        if replica.get("effective_config") != {
            **DINO_WM_PUSHT_EXPECTED_EFFECTIVE_CONFIG_BASE,
            "seed": seed,
        }:
            raise Refused(
                f"DINO-WM completed full effective config drifted: {label}"
            )
        replica_root = artifact_dir / "replicas" / label
        artifact_records = replica.get("artifacts")
        if not isinstance(artifact_records, dict) or set(artifact_records) != set(
            DINO_WM_PUSHT_REPLICA_ARTIFACT_PATHS
        ):
            raise Refused(f"DINO-WM completed replica artifact set drifted: {label}")
        captured_roles = {
            "completed_status",
            "logs_json",
            "hydra_config",
            "cuda_witness",
            "cuda_ready_witness",
            "launcher_pid",
            "compute_apps_pre",
            "compute_apps_during",
            "compute_apps_post",
            "gpu_execution_binding",
            "process_identity_start",
        }
        artifact_bodies: Dict[str, bytes] = {}
        for role, relative in DINO_WM_PUSHT_REPLICA_ARTIFACT_PATHS.items():
            observed_body, _ = verify_dinowm_artifact_record(
                artifact_records[role],
                replica_root / relative,
                artifact_dir,
                f"{label}/{role}",
                allow_empty=role in {"compute_apps_pre", "compute_apps_post"},
                capture_body=role in captured_roles,
                max_size_bytes=(
                    DINO_WM_MAX_LOG_BYTES
                    if role == "logs_json"
                    else (
                        DINO_WM_MAX_SMALL_ARTIFACT_BYTES
                        if role in captured_roles
                        else None
                    )
                ),
            )
            if role in captured_roles:
                if observed_body is None:
                    raise Refused(f"DINO-WM {label}/{role} was not captured")
                artifact_bodies[role] = observed_body
        raw_effective_config, raw_compact_config = parse_dinowm_hydra_config(
            artifact_bodies["hydra_config"], label, seed
        )
        if replica.get("effective_config") != raw_effective_config:
            raise Refused(
                f"DINO-WM completed raw/effective config binding drifted: {label}"
            )
        if replica.get("config") != raw_compact_config:
            raise Refused(
                f"DINO-WM completed raw/compact config binding drifted: {label}"
            )
        verify_dinowm_replica_gpu_execution_binding(
            replica,
            artifact_bodies,
            label,
            seed,
            index,
            uuid,
        )
        verify_dinowm_cuda_runtime_witness(
            parse_dinowm_json_body(
                artifact_bodies["cuda_witness"], f"{label} CUDA witness"
            ),
            replica_root,
            artifact_dir,
            label,
        )
        observed_outer_metric, observed_metric = parse_dinowm_metric_log(
            artifact_bodies["logs_json"], label
        )
        if observed_outer_metric != float(outer_metric_value):
            raise Refused(
                f"DINO-WM completed outer metric/log binding drifted: {label}"
            )
        if observed_metric != float(metric_value):
            raise Refused(f"DINO-WM completed metric/log binding drifted: {label}")
        result_path = replica_root / "result.json"
        result_body, result_metadata = read_regular_path(
            result_path, max_size_bytes=DINO_WM_MAX_JSON_BYTES
        )
        if stat.S_IMODE(result_metadata.st_mode) != 0o600:
            raise Refused(f"DINO-WM {label} result evidence must be mode 0600")
        try:
            persisted_replica = json.loads(result_body)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise Refused(f"DINO-WM {label} result evidence is invalid JSON") from exc
        if persisted_replica != replica:
            raise Refused(f"DINO-WM {label} result evidence differs from aggregate")
        metric_values.append(float(metric_value))

    aggregate = payload.get("aggregate")
    expected_aggregate = {
        "replica_count": 2,
        "total_evaluation_instances": 100,
        "mean_success_rate": sum(metric_values) / len(metric_values),
        "min_success_rate": min(metric_values),
        "max_success_rate": max(metric_values),
    }
    if aggregate != expected_aggregate:
        raise Refused("DINO-WM completed aggregate contract drifted")
    expected_comparison = {
        "status": "OBSERVED_DELTA_ONLY_NO_PREREGISTERED_EQUIVALENCE_MARGIN",
        "seed99_minus_paper_reported": (
            metric_values[0] - evidence["reported_reference_success_rate"]
        ),
        "reproduction_claim": None,
    }
    if payload.get("paper_metric_comparison") != expected_comparison:
        raise Refused("DINO-WM completed paper comparison drifted")
    return {
        "path": str(expected_path),
        "exists": True,
        "sha256": sha256_bytes(body),
        "size_bytes": len(body),
        "owner_uid": metadata.st_uid,
        "owner_gid": metadata.st_gid,
        "mode": f"{stat.S_IMODE(metadata.st_mode):04o}",
        "run_id": payload["run_id"],
        "nonce": payload["nonce"],
        "status": payload["status"],
        "metrics": {
            "seed99": metric_values[0],
            "seed100": metric_values[1],
        },
        "experiment_role": DINO_WM_PUSHT_EXPERIMENT_ROLE,
        "accepted": False,
        "evidence_boundary": DINO_WM_PUSHT_EVIDENCE_BOUNDARY,
        "complete": True,
    }


def watch_dinowm_evaluation(
    args: argparse.Namespace,
    config_path: Path,
    target_dir: Path,
    resolved: Dict[str, Any],
) -> int:
    deadline = time.monotonic() + args.timeout_seconds
    terminal_grace_deadline: Optional[float] = None
    last_status: Optional[str] = None
    get_failures = 0
    while True:
        try:
            data, stdout, stderr = get_job(args.job_id, config_path)
            get_failures = 0
        except Refused as exc:
            get_failures += 1
            print(f"{utc_now()} getjob_error={exc}", file=sys.stderr, flush=True)
            if get_failures >= 5:
                raise
        else:
            job = find_job_object(data, args.job_id)
            status_value = (
                str(job.get("Status") or "Unknown")
                if isinstance(job, dict)
                else "Unknown"
            )
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            atomic_json(target_dir / "monitor" / f"{stamp}.json", data)
            atomic_json(target_dir / "getjob-latest.json", data)
            atomic_text(target_dir / "getjob-latest.stdout.txt", stdout)
            atomic_text(target_dir / "getjob-latest.stderr.txt", stderr)
            contract = verify_getjob_contract(data, args.job_id, resolved)
            artifacts = verify_dinowm_completed_artifact(resolved)
            atomic_json(target_dir / "contract-readback.json", contract)
            atomic_json(target_dir / "artifact-evidence.json", artifacts)
            if status_value != last_status or artifacts["complete"]:
                print(
                    f"{utc_now()} status={status_value} "
                    f"contract={contract['complete']} "
                    f"artifacts={artifacts['complete']}",
                    flush=True,
                )
                last_status = status_value
            if status_value in TERMINAL_STATES:
                capture_terminal_diagnostics(
                    args.job_id, config_path, data, target_dir
                )
                if status_value == "Succeeded" and not artifacts["complete"]:
                    if terminal_grace_deadline is None:
                        terminal_grace_deadline = time.monotonic() + 60
                    if time.monotonic() < min(deadline, terminal_grace_deadline):
                        time.sleep(args.interval_seconds)
                        continue
                final_complete = (
                    status_value == "Succeeded"
                    and contract["complete"]
                    and artifacts["complete"]
                )
                final = {
                    "schema_version": 1,
                    "finished_at_utc": utc_now(),
                    "job_id": args.job_id,
                    "run_id": args.run_id,
                    "status": status_value,
                    "contract": contract,
                    "artifacts": artifacts,
                    "accepted": False,
                    "evidence_boundary": DINO_WM_PUSHT_EVIDENCE_BOUNDARY,
                    "complete": final_complete,
                }
                atomic_json(target_dir / "monitor-result.json", final)
                if final_complete:
                    print("DINOWM_EVALUATION_MONITOR_SUCCEEDED", flush=True)
                    return 0
                raise Refused(
                    "terminal DINO-WM job did not satisfy exact JobId, request, "
                    "and persisted evaluation gates; see monitor-result.json"
                )
        if time.monotonic() >= deadline:
            raise Refused(
                f"watch timeout after {args.timeout_seconds}s; job remains non-terminal"
            )
        time.sleep(args.interval_seconds)


def _read_r16p18_json(path: Path) -> Tuple[Dict[str, Any], os.stat_result]:
    body, metadata = read_regular_path(path, max_size_bytes=2 * 1024 * 1024)
    if metadata.st_uid != 2254 or metadata.st_gid != 2254:
        raise Refused(f"R16-P18 artifact is not owned by 2254:2254: {path}")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise Refused(f"R16-P18 artifact mode is not 0600: {path}")
    try:
        value = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refused(f"R16-P18 artifact is not valid JSON: {path}") from exc
    if not isinstance(value, dict):
        raise Refused(f"R16-P18 artifact is not a JSON object: {path}")
    return value, metadata


def verify_r16p18_artifacts(resolved: Dict[str, Any]) -> Dict[str, Any]:
    evidence = resolved["evidence"]
    run_id = str(resolved["run_id"])
    config_sha = str(evidence["config_sha256"])
    checkpoint_run = R16P18_LIBERO_STAGE1_CHECKPOINT_BASE / run_id
    artifact_dir = Path(str(resolved["artifact_dir"]))
    first_path = Path(str(evidence["first_work_evidence_path"]))
    eval_first_path = Path(str(evidence["evaluation_first_work_evidence_path"]))
    complete_path = Path(str(evidence["completed_evidence_path"]))
    result: Dict[str, Any] = {
        "first_training_step": {"path": str(first_path), "complete": False},
        "first_completed_rollout": {
            "path": str(eval_first_path),
            "complete": False,
        },
        "baseline_gate": {"path": str(complete_path), "complete": False},
        "model_final_count": 0,
        "evaluation_summary_count": 0,
        "complete": False,
    }
    if first_path.exists() or first_path.is_symlink():
        first, metadata = _read_r16p18_json(first_path)
        loss = first.get("loss")
        expected = {
            "schema_version": 1,
            "event": "PERSISTED_OPTIMIZER_STEP_AND_LOSS",
            "run_id": run_id,
            "config_sha256": config_sha,
            "task_key": "push_plate",
            "model_seed": 16018,
            "global_step": 1,
            "uid": 2254,
            "gid": 2254,
        }
        for key, value in expected.items():
            if first.get(key) != value:
                raise Refused(f"R16-P18 first-work field drifted: {key}")
        if type(loss) not in (int, float) or loss != loss or abs(loss) > 1e6:
            raise Refused("R16-P18 first-work loss is invalid")
        result["first_training_step"] = {
            "path": str(first_path),
            "sha256": sha256(first_path),
            "size_bytes": metadata.st_size,
            "global_step": 1,
            "loss": float(loss),
            "complete": True,
        }

    if eval_first_path.exists() or eval_first_path.is_symlink():
        rollout, metadata = _read_r16p18_json(eval_first_path)
        expected = {
            "schema_version": 1,
            "event": "PERSISTED_FIRST_COMPLETED_ROLLOUT",
            "run_id": run_id,
            "config_sha256": config_sha,
            "task_key": "push_plate",
            "model_seed": 16018,
            "episode_id": 0,
            "uid": 2254,
            "gid": 2254,
        }
        for key, value in expected.items():
            if rollout.get(key) != value:
                raise Refused(f"R16-P18 first rollout field drifted: {key}")
        if type(rollout.get("success")) is not bool:
            raise Refused("R16-P18 first rollout success is not Boolean")
        result["first_completed_rollout"] = {
            "path": str(eval_first_path),
            "sha256": sha256(eval_first_path),
            "size_bytes": metadata.st_size,
            "success": rollout["success"],
            "complete": True,
        }

    task_keys = ("push_plate", "bottle_rack", "bowl_plate")
    seeds = (16018, 16019, 16020)
    model_final_count = 0
    evaluation_summary_count = 0
    for task_key in task_keys:
        for seed in seeds:
            model_dir = checkpoint_run / "models" / task_key / f"seed_{seed}"
            final_path = model_dir / "final.pt"
            marker_path = model_dir / "final.pt.complete.json"
            if final_path.is_file() and marker_path.is_file():
                marker, _ = _read_r16p18_json(marker_path)
                if (
                    marker.get("run_id") != run_id
                    or marker.get("task_key") != task_key
                    or marker.get("model_seed") != seed
                    or marker.get("global_step") != 3000
                    or marker.get("bytes") != final_path.stat().st_size
                    or marker.get("sha256") != sha256(final_path)
                    or final_path.stat().st_uid != 2254
                    or final_path.stat().st_gid != 2254
                ):
                    raise Refused(
                        f"R16-P18 final model completeness drifted: {task_key}/{seed}"
                    )
                model_final_count += 1
            summary_path = (
                artifact_dir
                / "evaluation"
                / task_key
                / f"seed_{seed}.summary.json"
            )
            if summary_path.is_file():
                summary, _ = _read_r16p18_json(summary_path)
                if (
                    summary.get("event") != "PERSISTED_COMPLETED_EVALUATION_RESULT"
                    or summary.get("run_id") != run_id
                    or summary.get("config_sha256") != config_sha
                    or summary.get("task_key") != task_key
                    or summary.get("model_seed") != seed
                    or summary.get("episodes") != 50
                    or type(summary.get("successes")) is not int
                    or not 0 <= summary["successes"] <= 50
                ):
                    raise Refused(
                        f"R16-P18 evaluation summary drifted: {task_key}/{seed}"
                    )
                evaluation_summary_count += 1
    result["model_final_count"] = model_final_count
    result["evaluation_summary_count"] = evaluation_summary_count

    if complete_path.exists() or complete_path.is_symlink():
        gate, metadata = _read_r16p18_json(complete_path)
        if (
            gate.get("schema_version") != 1
            or gate.get("protocol_id") != "R16-P18-LIBERO-STAGE1-PILOT-V1"
            or gate.get("config_sha256") != config_sha
            or gate.get("run_id") != run_id
            or gate.get("decision")
            not in {"BASELINE_GATE_PASS_CONTINUE_STAGE1", "NO_GO_BASELINE_GATE"}
            or type(gate.get("baseline_gate_passed")) is not bool
            or gate.get("data_protocol_deviation") is not True
            or gate.get("stage1_go_permitted_from_this_pilot") is not False
            or set(gate.get("task_results", {})) != set(task_keys)
        ):
            raise Refused("R16-P18 persisted baseline-gate contract drifted")
        for task_key, task in gate["task_results"].items():
            rate = task.get("success_rate")
            interval = task.get("confidence_interval_95")
            if (
                type(rate) not in (int, float)
                or not 0.0 <= rate <= 1.0
                or not isinstance(interval, list)
                or len(interval) != 2
                or not 0.0 <= interval[0] <= interval[1] <= 1.0
            ):
                raise Refused(f"R16-P18 baseline metric drifted: {task_key}")
        result["baseline_gate"] = {
            "path": str(complete_path),
            "sha256": sha256(complete_path),
            "size_bytes": metadata.st_size,
            "decision": gate["decision"],
            "baseline_gate_passed": gate["baseline_gate_passed"],
            "task_results": gate["task_results"],
            "complete": True,
        }

    result["complete"] = (
        result["first_training_step"]["complete"]
        and result["first_completed_rollout"]["complete"]
        and result["baseline_gate"]["complete"]
        and model_final_count == 9
        and evaluation_summary_count == 9
    )
    return result


def verify_r16p18_superseded_cleanup(
    resolved: Dict[str, Any],
) -> Dict[str, Any]:
    targets = resolved["evidence"]["superseded_terminal_jobs"]
    result: Dict[str, Any] = {
        "schema_version": 1,
        "run_id": resolved["run_id"],
        "targets": [],
        "complete": False,
    }
    if not targets:
        result.update(
            {
                "complete": True,
                "reason": (
                    "initial formal run has no superseded failed or stopped "
                    "predecessor"
                ),
            }
        )
        return result

    complete = True
    for target in targets:
        predecessor_dir = run_dir(str(target["run_id"]))
        require_private_directory(predecessor_dir)
        evidence_path = predecessor_dir / "pai-task-delete-evidence.json"
        item: Dict[str, Any] = {
            **target,
            "evidence_path": str(evidence_path),
            "complete": False,
        }
        if evidence_path.is_file() and not evidence_path.is_symlink():
            evidence, metadata = _read_r16p18_json(evidence_path)
            expected_fields = {
                "schema_version": 1,
                "run_id": target["run_id"],
                "job_id": target["job_id"],
                "workspace_id": "179169",
                "pre_delete_status": target["expected_status"],
                "expected_purpose": target["expected_purpose"],
                "performed_by_uid": 2254,
                "performed_by_gid": 2254,
                "cpfs_and_registry_evidence_preserved": True,
                "complete": True,
            }
            fields_match = all(
                evidence.get(key) == value
                for key, value in expected_fields.items()
            )
            absence = evidence.get("absence")
            item.update(
                {
                    "sha256": sha256(evidence_path),
                    "size_bytes": metadata.st_size,
                    "verified_absent": (
                        isinstance(absence, dict)
                        and absence.get("complete") is True
                    ),
                    "complete": (
                        fields_match
                        and isinstance(absence, dict)
                        and absence.get("complete") is True
                    ),
                }
            )
        complete = complete and item["complete"]
        result["targets"].append(item)
    result["complete"] = complete
    return result


def watch_r16p18_stage1(
    args: argparse.Namespace,
    config_path: Path,
    target_dir: Path,
    resolved: Dict[str, Any],
) -> int:
    deadline = time.monotonic() + args.timeout_seconds
    last_state: Optional[Tuple[str, bool, bool, bool, bool]] = None
    get_failures = 0
    while True:
        try:
            data, stdout, stderr = get_job(args.job_id, config_path)
            get_failures = 0
        except Refused as exc:
            get_failures += 1
            print(f"{utc_now()} getjob_error={exc}", file=sys.stderr, flush=True)
            if get_failures >= 5:
                raise
        else:
            job = find_job_object(data, args.job_id)
            status_value = (
                str(job.get("Status") or "Unknown")
                if isinstance(job, dict)
                else "Unknown"
            )
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            atomic_json(target_dir / "monitor" / f"{stamp}.json", data)
            atomic_json(target_dir / "getjob-latest.json", data)
            atomic_text(target_dir / "getjob-latest.stdout.txt", stdout)
            atomic_text(target_dir / "getjob-latest.stderr.txt", stderr)
            contract = verify_getjob_contract(data, args.job_id, resolved)
            artifacts = verify_r16p18_artifacts(resolved)
            cleanup = (
                verify_r16p18_superseded_cleanup(resolved)
                if artifacts["first_training_step"]["complete"]
                else {"complete": False}
            )
            atomic_json(target_dir / "contract-readback.json", contract)
            atomic_json(target_dir / "artifact-evidence.json", artifacts)
            state = (
                status_value,
                artifacts["first_training_step"]["complete"],
                artifacts["first_completed_rollout"]["complete"],
                cleanup["complete"],
                artifacts["complete"],
            )
            if state != last_state:
                print(
                    f"{utc_now()} status={status_value} "
                    f"contract={contract['complete']} "
                    f"train_first_work={state[1]} "
                    f"evaluation_first_work={state[2]} "
                    f"superseded_cleanup={state[3]} "
                    f"artifacts_complete={state[4]}",
                    flush=True,
                )
                last_state = state
            if artifacts["first_training_step"]["complete"]:
                cleanup["sealed_at_utc"] = utc_now()
                cleanup["job_id"] = args.job_id
                atomic_json(target_dir / "superseded-delete-set.json", cleanup)
            if status_value in TERMINAL_STATES:
                capture_terminal_diagnostics(
                    args.job_id, config_path, data, target_dir
                )
                final_complete = (
                    status_value == "Succeeded"
                    and contract["complete"]
                    and artifacts["complete"]
                    and cleanup["complete"]
                )
                final = {
                    "schema_version": 1,
                    "finished_at_utc": utc_now(),
                    "job_id": args.job_id,
                    "run_id": args.run_id,
                    "status": status_value,
                    "contract": contract,
                    "artifacts": artifacts,
                    "superseded_cleanup_complete": cleanup["complete"],
                    "complete": final_complete,
                }
                atomic_json(target_dir / "monitor-result.json", final)
                if final_complete:
                    print("R16P18_STAGE1_BASELINE_MONITOR_SUCCEEDED", flush=True)
                    return 0
                raise Refused(
                    "terminal R16-P18 job did not satisfy exact JobId, first-step, "
                    "completed-rollout, baseline-gate, and ownership contracts"
                )
        if time.monotonic() >= deadline:
            raise Refused(
                f"watch timeout after {args.timeout_seconds}s; job remains non-terminal"
            )
        time.sleep(args.interval_seconds)


def command_watch(args: argparse.Namespace) -> int:
    require_leon_controller()
    config_path = checked_config(args.config)
    target_dir = private_run_dir(args.run_id)
    resolved = load_json(target_dir / "resolved.json")
    result = load_json(target_dir / "result.json")
    if resolved.get("run_id") != args.run_id:
        raise Refused("resolved manifest run_id does not match watch --run-id")
    if result.get("run_id") != args.run_id or result.get("job_id") != args.job_id:
        raise Refused("watch JobId/run_id binding does not match result.json")
    validate_resolved(resolved)
    evidence_kind = resolved.get("evidence", {}).get("kind")
    if evidence_kind == R16P18_LIBERO_STAGE1_EVIDENCE_KIND:
        return watch_r16p18_stage1(
            args, config_path, target_dir, resolved
        )
    if evidence_kind == DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND:
        return watch_dinowm_evaluation(
            args, config_path, target_dir, resolved
        )
    if evidence_kind != "autofault_owner_canary":
        raise Refused(
            "watch currently supports only autofault_owner_canary; "
            "use bounded GetJob plus the workload-specific persisted-evidence "
            f"validator for evidence.kind={evidence_kind!r}"
        )

    deadline = time.monotonic() + args.timeout_seconds
    last_status: Optional[str] = None
    get_failures = 0
    restart_state_path = target_dir / "restart-evidence.json"
    previous_restart: Dict[str, Any] = (
        load_json(restart_state_path)
        if restart_state_path.is_file()
        else {}
    )
    initial_getjob_path = target_dir / "getjob-initial.json"
    if initial_getjob_path.is_file() and not previous_restart:
        previous_restart = restart_evidence(
            load_json(initial_getjob_path),
            args.job_id,
            int(resolved["evidence"].get("require_platform_restart_count", 0)),
            int(resolved["evidence"].get("require_distinct_pod_uids", 0)),
        )
    while True:
        try:
            data, stdout, stderr = get_job(args.job_id, config_path)
            get_failures = 0
        except Refused as exc:
            get_failures += 1
            print(f"{utc_now()} getjob_error={exc}", file=sys.stderr, flush=True)
            if get_failures >= 5:
                raise
        else:
            list_data: Optional[Dict[str, Any]] = None
            list_error = (
                "pinned DLC ListJobs is an ASCII table and does not expose "
                "UseOversoldResource"
            )
            job = find_job_object(data, args.job_id)
            status_value = (
                str(job.get("Status") or "Unknown")
                if isinstance(job, dict)
                else "Unknown"
            )
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            atomic_json(target_dir / "monitor" / f"{stamp}.json", data)
            atomic_json(target_dir / "getjob-latest.json", data)
            atomic_text(target_dir / "getjob-latest.stdout.txt", stdout)
            atomic_text(target_dir / "getjob-latest.stderr.txt", stderr)
            atomic_text(target_dir / "listjob-latest.error.txt", list_error)

            contract = verify_getjob_contract(data, args.job_id, resolved)
            restart = restart_evidence(
                data,
                args.job_id,
                int(resolved["evidence"].get("require_platform_restart_count", 0)),
                int(resolved["evidence"].get("require_distinct_pod_uids", 0)),
                previous_restart,
            )
            previous_restart = restart
            artifacts = verify_canary_artifacts(resolved)
            cli_actual_idle = actual_idle_value(args.job_id, data, list_data)
            external_placement = external_idle_evidence(resolved, args.job_id)
            external_actual_idle = (
                bool(external_placement["use_oversold_resource"])
                if external_placement is not None
                else None
            )
            if (
                cli_actual_idle is not None
                and external_actual_idle is not None
                and cli_actual_idle != external_actual_idle
            ):
                raise Refused(
                    "CLI and external placement evidence disagree for exact JobId"
                )
            actual_idle = (
                cli_actual_idle
                if cli_actual_idle is not None
                else external_actual_idle
            )
            placement = {
                "use_oversold_resource": actual_idle,
                "proven_actual_idle": actual_idle is True,
                "cli_getjob_value": cli_actual_idle,
                "external_evidence": external_placement,
                "listjobs_error": list_error,
                "note": (
                    "UseOversoldResource=true proves actual idle placement; "
                    "OversoldType alone only proves requested policy."
                ),
            }
            atomic_json(target_dir / "contract-readback.json", contract)
            atomic_json(target_dir / "restart-evidence.json", restart)
            atomic_json(target_dir / "artifact-evidence.json", artifacts)
            atomic_json(target_dir / "placement-evidence.json", placement)

            if status_value != last_status or artifacts["complete"]:
                print(
                    f"{utc_now()} status={status_value} "
                    f"contract={contract['complete']} "
                    f"restart={restart['complete']} "
                    f"actual_idle={actual_idle} "
                    f"artifacts={artifacts['complete']}",
                    flush=True,
                )
                last_status = status_value

            if status_value in TERMINAL_STATES:
                capture_terminal_diagnostics(
                    args.job_id, config_path, data, target_dir
                )
                delete_evidence: Dict[str, Any] = {"complete": False}
                if resolved["evidence"].get("require_dev14_unlink"):
                    existing_delete_evidence = validated_delete_evidence(resolved)
                    if existing_delete_evidence is not None:
                        delete_evidence = existing_delete_evidence
                    elif (target_dir / "dev14-delete-intent.json").is_file():
                        delete_evidence = perform_dev14_unlink(resolved)
                        artifacts = verify_canary_artifacts(resolved)
                        atomic_json(target_dir / "artifact-evidence.json", artifacts)
                pre_delete_complete = (
                    status_value == "Succeeded"
                    and contract["complete"]
                    and restart["complete"]
                    and actual_idle is True
                    and artifacts["complete"]
                )
                if pre_delete_complete and resolved["evidence"].get(
                    "require_dev14_unlink"
                ) and delete_evidence.get("complete") is not True:
                    delete_evidence = perform_dev14_unlink(resolved)
                    artifacts = verify_canary_artifacts(resolved)
                    atomic_json(target_dir / "artifact-evidence.json", artifacts)
                final_complete = (
                    pre_delete_complete
                    and artifacts["complete"]
                    and (
                        not resolved["evidence"].get("require_dev14_unlink")
                        or delete_evidence.get("complete") is True
                    )
                )
                final = {
                    "finished_at_utc": utc_now(),
                    "job_id": args.job_id,
                    "run_id": args.run_id,
                    "status": status_value,
                    "contract": contract,
                    "restart": restart,
                    "placement": placement,
                    "artifacts": artifacts,
                    "dev14_unlink": delete_evidence,
                    "complete": final_complete,
                }
                atomic_json(target_dir / "monitor-result.json", final)
                if final_complete:
                    print("CANARY_MONITOR_SUCCEEDED", flush=True)
                    return 0
                raise Refused(
                    "terminal job did not satisfy every canary gate; "
                    f"see {target_dir / 'monitor-result.json'}"
                )

        if time.monotonic() >= deadline:
            raise Refused(
                f"watch timeout after {args.timeout_seconds}s; job remains non-terminal"
            )
        time.sleep(args.interval_seconds)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    resources_parser = sub.add_parser("resources", help="show recorded resource IDs")
    resources_parser.set_defaults(func=command_resources)

    validate_parser = sub.add_parser("validate", help="resolve and validate a template")
    validate_parser.add_argument("template")
    validate_parser.add_argument("--run-id", required=True)
    validate_wandb_group = validate_parser.add_mutually_exclusive_group()
    validate_wandb_group.add_argument(
        "--with-wandb",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    validate_wandb_group.add_argument("--no-wandb", action="store_true")
    validate_parser.set_defaults(func=command_validate)

    submit_parser = sub.add_parser("submit", help="submit a template exactly once")
    submit_parser.add_argument("template")
    submit_parser.add_argument("--run-id", required=True)
    submit_parser.add_argument("--config")
    submit_wandb_group = submit_parser.add_mutually_exclusive_group()
    submit_wandb_group.add_argument(
        "--with-wandb",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    submit_wandb_group.add_argument("--no-wandb", action="store_true")
    submit_parser.set_defaults(func=command_submit)

    submit_resolved_parser = sub.add_parser(
        "submit-resolved", help="submit a structurally cloned frozen manifest"
    )
    submit_resolved_parser.add_argument("--run-id", required=True)
    submit_resolved_parser.add_argument("--config")
    resolved_wandb_group = submit_resolved_parser.add_mutually_exclusive_group()
    resolved_wandb_group.add_argument(
        "--with-wandb",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    resolved_wandb_group.add_argument("--no-wandb", action="store_true")
    submit_resolved_parser.set_defaults(func=command_submit_resolved)

    reconcile_parser = sub.add_parser(
        "reconcile-created",
        help="reconcile one sealed run after a confirmed CreateJob response",
    )
    reconcile_parser.add_argument("--run-id", required=True)
    reconcile_parser.add_argument("--job-id", required=True)
    reconcile_parser.add_argument("--config")
    reconcile_parser.set_defaults(func=command_reconcile_created)

    clone_parser = sub.add_parser(
        "clone", help="structurally clone requested parameters with a fresh nonce"
    )
    clone_parser.add_argument("--from-run", required=True)
    clone_parser.add_argument("--run-id", required=True)
    clone_parser.set_defaults(func=command_clone)

    idle_evidence_parser = sub.add_parser(
        "record-idle-evidence",
        help="seal exact-JobId PAI ListJobs UseOversoldResource=true evidence",
    )
    idle_evidence_parser.add_argument("--run-id", required=True)
    idle_evidence_parser.add_argument("--job-id", required=True)
    idle_evidence_parser.add_argument(
        "--source",
        choices=sorted(EXTERNAL_IDLE_SOURCE_SPECS),
        default="web",
        help="provenance of the staged ListJobs response (default: web)",
    )
    idle_evidence_parser.add_argument("--response-file", required=True)
    idle_evidence_parser.set_defaults(func=command_record_idle_evidence)

    get_parser = sub.add_parser("get", help="machine-readable GetJob readback")
    get_parser.add_argument("job_id")
    get_parser.add_argument("--run-id")
    get_parser.add_argument("--config")
    get_parser.set_defaults(func=command_get)

    watch_parser = sub.add_parser(
        "watch", help="poll GetJob, restart, placement and persistent evidence"
    )
    watch_parser.add_argument("job_id")
    watch_parser.add_argument("--run-id", required=True)
    watch_parser.add_argument("--config")
    watch_parser.add_argument("--interval-seconds", type=int, default=5)
    watch_parser.add_argument("--timeout-seconds", type=int, default=3600)
    watch_parser.set_defaults(func=command_watch)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        return int(args.func(args))
    except Refused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
