        ),
        "cem_num_samples": 300,
        "cem_topk": 30,
        "cem_opt_steps": 10,
        "execution_mode": (
            "sequential_to_preserve_the_official_50_env_memory_contract"
        ),
        "gpu_assignments": {"seed99": 0, "seed100": 1},
        "wandb_mode": "disabled_no_service_run_disabled_adapter_v1",
