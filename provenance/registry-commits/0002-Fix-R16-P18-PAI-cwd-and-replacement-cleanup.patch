+def verify_r16p18_superseded_cleanup(
+    resolved: Dict[str, Any],
+) -> Dict[str, Any]:
+    targets = resolved["evidence"]["superseded_terminal_jobs"]
+    result: Dict[str, Any] = {
+        "schema_version": 1,
+        "run_id": resolved["run_id"],
+        "targets": [],
+        "complete": False,
+    }
+    if not targets:
+        result.update(
+            {
+                "complete": True,
+                "reason": (
+                    "initial formal run has no superseded failed or stopped "
+                    "predecessor"
+                ),
+            }
+        )
+        return result
+
+    complete = True
+    for target in targets:
+        predecessor_dir = run_dir(str(target["run_id"]))
+        require_private_directory(predecessor_dir)
+        evidence_path = predecessor_dir / "pai-task-delete-evidence.json"
+        item: Dict[str, Any] = {
+            **target,
+            "evidence_path": str(evidence_path),
+            "complete": False,
+        }
+        if evidence_path.is_file() and not evidence_path.is_symlink():
+            evidence, metadata = _read_r16p18_json(evidence_path)
+            expected_fields = {
+                "schema_version": 1,
+                "run_id": target["run_id"],
+                "job_id": target["job_id"],
+                "workspace_id": "179169",
+                "pre_delete_status": target["expected_status"],
+                "expected_purpose": target["expected_purpose"],
+                "performed_by_uid": 2254,
+                "performed_by_gid": 2254,
+                "cpfs_and_registry_evidence_preserved": True,
+                "complete": True,
+            }
+            fields_match = all(
+                evidence.get(key) == value
+                for key, value in expected_fields.items()
+            )
+            absence = evidence.get("absence")
+            item.update(
+                {
+                    "sha256": sha256(evidence_path),
+                    "size_bytes": metadata.st_size,
+                    "verified_absent": (
+                        isinstance(absence, dict)
+                        and absence.get("complete") is True
+                    ),
+                    "complete": (
+                        fields_match
+                        and isinstance(absence, dict)
+                        and absence.get("complete") is True
+                    ),
+                }
+            )
+        complete = complete and item["complete"]
+        result["targets"].append(item)
+    result["complete"] = complete
+    return result
+
+
