                 last_state = state
             if artifacts["first_training_step"]["complete"]:
-                zero_cleanup = {
-                    "schema_version": 1,
-                    "sealed_at_utc": utc_now(),
-                    "run_id": args.run_id,
-                    "job_id": args.job_id,
-                    "targets": [],
-                    "complete": True,
-                    "reason": "initial formal run has no superseded failed or stopped predecessor",
-                }
-                atomic_json(target_dir / "superseded-delete-set.json", zero_cleanup)
+                cleanup["sealed_at_utc"] = utc_now()
+                cleanup["job_id"] = args.job_id
+                atomic_json(target_dir / "superseded-delete-set.json", cleanup)
             if status_value in TERMINAL_STATES:
                 capture_terminal_diagnostics(
                     args.job_id, config_path, data, target_dir
@@ -11715,6 +11796,7 @@ def watch_r16p18_stage1(
                     status_value == "Succeeded"
                     and contract["complete"]
                     and artifacts["complete"]
+                    and cleanup["complete"]
                 )
                 final = {
                     "schema_version": 1,
@@ -11724,9 +11806,7 @@ def watch_r16p18_stage1(
                     "status": status_value,
                     "contract": contract,
