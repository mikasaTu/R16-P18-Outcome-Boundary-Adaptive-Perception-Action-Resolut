+def _read_r16p18_json(path: Path) -> Tuple[Dict[str, Any], os.stat_result]:
+    body, metadata = read_regular_path(path, max_size_bytes=2 * 1024 * 1024)
+    if metadata.st_uid != 2254 or metadata.st_gid != 2254:
+        raise Refused(f"R16-P18 artifact is not owned by 2254:2254: {path}")
+    if stat.S_IMODE(metadata.st_mode) != 0o600:
+        raise Refused(f"R16-P18 artifact mode is not 0600: {path}")
+    try:
+        value = json.loads(body)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise Refused(f"R16-P18 artifact is not valid JSON: {path}") from exc
+    if not isinstance(value, dict):
+        raise Refused(f"R16-P18 artifact is not a JSON object: {path}")
+    return value, metadata
+
+
+def verify_r16p18_artifacts(resolved: Dict[str, Any]) -> Dict[str, Any]:
+    evidence = resolved["evidence"]
+    run_id = str(resolved["run_id"])
+    config_sha = str(evidence["config_sha256"])
+    checkpoint_run = R16P18_LIBERO_STAGE1_CHECKPOINT_BASE / run_id
+    artifact_dir = Path(str(resolved["artifact_dir"]))
+    first_path = Path(str(evidence["first_work_evidence_path"]))
+    eval_first_path = Path(str(evidence["evaluation_first_work_evidence_path"]))
+    complete_path = Path(str(evidence["completed_evidence_path"]))
+    result: Dict[str, Any] = {
+        "first_training_step": {"path": str(first_path), "complete": False},
+        "first_completed_rollout": {
+            "path": str(eval_first_path),
+            "complete": False,
+        },
+        "baseline_gate": {"path": str(complete_path), "complete": False},
+        "model_final_count": 0,
+        "evaluation_summary_count": 0,
+        "complete": False,
+    }
+    if first_path.exists() or first_path.is_symlink():
+        first, metadata = _read_r16p18_json(first_path)
+        loss = first.get("loss")
+        expected = {
+            "schema_version": 1,
+            "event": "PERSISTED_OPTIMIZER_STEP_AND_LOSS",
+            "run_id": run_id,
+            "config_sha256": config_sha,
+            "task_key": "push_plate",
+            "model_seed": 16018,
+            "global_step": 1,
+            "uid": 2254,
+            "gid": 2254,
+        }
+        for key, value in expected.items():
+            if first.get(key) != value:
+                raise Refused(f"R16-P18 first-work field drifted: {key}")
+        if type(loss) not in (int, float) or loss != loss or abs(loss) > 1e6:
+            raise Refused("R16-P18 first-work loss is invalid")
+        result["first_training_step"] = {
+            "path": str(first_path),
+            "sha256": sha256(first_path),
+            "size_bytes": metadata.st_size,
+            "global_step": 1,
+            "loss": float(loss),
+            "complete": True,
+        }
+
+    if eval_first_path.exists() or eval_first_path.is_symlink():
+        rollout, metadata = _read_r16p18_json(eval_first_path)
+        expected = {
+            "schema_version": 1,
+            "event": "PERSISTED_FIRST_COMPLETED_ROLLOUT",
+            "run_id": run_id,
+            "config_sha256": config_sha,
+            "task_key": "push_plate",
+            "model_seed": 16018,
+            "episode_id": 0,
+            "uid": 2254,
+            "gid": 2254,
+        }
+        for key, value in expected.items():
+            if rollout.get(key) != value:
+                raise Refused(f"R16-P18 first rollout field drifted: {key}")
+        if type(rollout.get("success")) is not bool:
+            raise Refused("R16-P18 first rollout success is not Boolean")
+        result["first_completed_rollout"] = {
+            "path": str(eval_first_path),
+            "sha256": sha256(eval_first_path),
+            "size_bytes": metadata.st_size,
+            "success": rollout["success"],
+            "complete": True,
+        }
+
+    task_keys = ("push_plate", "bottle_rack", "bowl_plate")
+    seeds = (16018, 16019, 16020)
+    model_final_count = 0
+    evaluation_summary_count = 0
+    for task_key in task_keys:
+        for seed in seeds:
+            model_dir = checkpoint_run / "models" / task_key / f"seed_{seed}"
+            final_path = model_dir / "final.pt"
+            marker_path = model_dir / "final.pt.complete.json"
+            if final_path.is_file() and marker_path.is_file():
+                marker, _ = _read_r16p18_json(marker_path)
+                if (
+                    marker.get("run_id") != run_id
+                    or marker.get("task_key") != task_key
+                    or marker.get("model_seed") != seed
+                    or marker.get("global_step") != 3000
+                    or marker.get("bytes") != final_path.stat().st_size
+                    or marker.get("sha256") != sha256(final_path)
+                    or final_path.stat().st_uid != 2254
+                    or final_path.stat().st_gid != 2254
+                ):
+                    raise Refused(
+                        f"R16-P18 final model completeness drifted: {task_key}/{seed}"
+                    )
+                model_final_count += 1
+            summary_path = (
+                artifact_dir
+                / "evaluation"
+                / task_key
+                / f"seed_{seed}.summary.json"
+            )
+            if summary_path.is_file():
+                summary, _ = _read_r16p18_json(summary_path)
+                if (
+                    summary.get("event") != "PERSISTED_COMPLETED_EVALUATION_RESULT"
+                    or summary.get("run_id") != run_id
+                    or summary.get("config_sha256") != config_sha
+                    or summary.get("task_key") != task_key
+                    or summary.get("model_seed") != seed
+                    or summary.get("episodes") != 50
+                    or type(summary.get("successes")) is not int
+                    or not 0 <= summary["successes"] <= 50
+                ):
+                    raise Refused(
+                        f"R16-P18 evaluation summary drifted: {task_key}/{seed}"
+                    )
+                evaluation_summary_count += 1
+    result["model_final_count"] = model_final_count
+    result["evaluation_summary_count"] = evaluation_summary_count
+
+    if complete_path.exists() or complete_path.is_symlink():
+        gate, metadata = _read_r16p18_json(complete_path)
+        if (
+            gate.get("schema_version") != 1
+            or gate.get("protocol_id") != "R16-P18-LIBERO-STAGE1-PILOT-V1"
+            or gate.get("config_sha256") != config_sha
+            or gate.get("run_id") != run_id
+            or gate.get("decision")
+            not in {"BASELINE_GATE_PASS_CONTINUE_STAGE1", "NO_GO_BASELINE_GATE"}
+            or type(gate.get("baseline_gate_passed")) is not bool
+            or gate.get("data_protocol_deviation") is not True
+            or gate.get("stage1_go_permitted_from_this_pilot") is not False
+            or set(gate.get("task_results", {})) != set(task_keys)
+        ):
+            raise Refused("R16-P18 persisted baseline-gate contract drifted")
+        for task_key, task in gate["task_results"].items():
+            rate = task.get("success_rate")
+            interval = task.get("confidence_interval_95")
+            if (
+                type(rate) not in (int, float)
+                or not 0.0 <= rate <= 1.0
+                or not isinstance(interval, list)
+                or len(interval) != 2
+                or not 0.0 <= interval[0] <= interval[1] <= 1.0
+            ):
+                raise Refused(f"R16-P18 baseline metric drifted: {task_key}")
+        result["baseline_gate"] = {
+            "path": str(complete_path),
+            "sha256": sha256(complete_path),
+            "size_bytes": metadata.st_size,
+            "decision": gate["decision"],
+            "baseline_gate_passed": gate["baseline_gate_passed"],
+            "task_results": gate["task_results"],
+            "complete": True,
+        }
+
+    result["complete"] = (
+        result["first_training_step"]["complete"]
+        and result["first_completed_rollout"]["complete"]
+        and result["baseline_gate"]["complete"]
+        and model_final_count == 9
+        and evaluation_summary_count == 9
+    )
+    return result
+
